  <link rel="stylesheet" href="/style.css">
  <style>
    .dl-card { background:#fff; border-radius:12px; padding:20px; margin-bottom:12px; box-shadow:0 1px 4px rgba(0,0,0,.08); display:flex; align-items:center; gap:14px; }
    .dl-icon { width:48px; height:48px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:24px; flex-shrink:0; }
    .dl-icon.ios { background:#e8f0fe; color:#1F4E79; }
    .dl-icon.android { background:#e8f5e9; color:#2e7d32; }
    .dl-icon.pc { background:#e3f2fd; color:#1565c0; }
    .dl-icon.mac { background:#f3e5f5; color:#7b1fa2; }
    .dl-icon.linux { background:#fff3e0; color:#e65100; }
    .dl-info { flex:1; min-width:0; }
    .dl-info h3 { font-size:16px; margin:0 0 2px; color:#222; }
    .dl-info .sub { font-size:12px; color:#999; }
    .dl-btns { display:flex; gap:8px; flex-shrink:0; flex-wrap:wrap; }
    .dl-btn { display:inline-block; padding:8px 16px; border-radius:8px; font-size:13px; font-weight:600; text-decoration:none; white-space:nowrap; }
    .dl-btn.primary { background:#1F4E79; color:#fff; }
    .dl-btn.secondary { background:#e8f0fe; color:#1F4E79; border:1px solid #1F4E79; }
    .variant-tag { display:inline-block; background:#f0f0f0; color:#888; font-size:10px; padding:1px 6px; border-radius:4px; margin-left:4px; vertical-align:middle; }
    .arch-tag { display:inline-block; background:#e3f2fd; color:#1565c0; font-size:10px; padding:1px 6px; border-radius:4px; margin-left:4px; }
  </style>
</head>
