{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"【模】考勤管理","content":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>模板介绍</title>\r\n    <script>\r\n        window.parent.document.getElementsByClassName('customPage')[0].style = \"overflow:hidden\"\r\n    </script>\r\n    <link type=\"text/css\" rel=\"styleSheet\" href=\"./index.css\" />\r\n</head>\r\n\r\n<body>\r\n    <div id=\"app\">\r\n        <div class=\"Wrap\">\r\n            <h1 class=\"h_s\"> 模板介绍--考勤管理</h1>\r\n\r\n            <!-- 1.业务流程图-->\r\n            <div class=\"inList\">\r\n                <h2> 1.业务流程图 </h2>\r\n                <img src=\"https://dsc.jsthqc.com/api/v1/fdn-storage/oss/files/download?uri=9134167922923ba09ad18872b2b1246e/material/fd6a396e6d214afc8e72ed508724e213/应用说明/考勤管理业务流程图.png\"\r\n                    alt=\"\" />\r\n            </div>\r\n\r\n            <!-- 2.应用价值-->\r\n            <div class=\"inList\">\r\n                <h2> 2.应用价值</h2>\r\n                <p>1.针对公司的员工信息进行出差考勤管理，对外出、出差、请假做相应的申请、审批和记录。</p>\r\n                <p>2.输出考勤报表请假、出差、外出、迟到等统计。</p>\r\n\r\n            </div>\r\n            <!-- 2.应用价值-->\r\n            <div class=\"inList\">\r\n                <h2> 3.功能描述</h2>\r\n\r\n                <h3> 1>员工信息 </h3>\r\n                <p>①记录员工的工作年限、可休年假、已休年假、剩余年假等信息</p>\r\n                <img src=\"https://dsc.jsthqc.com/api/v1/fdn-storage/oss/files/download?uri=9134167922923ba09ad18872b2b1246e/material/fd6a396e6d214afc8e72ed508724e213/应用说明/员工信息.png\"\r\n                    alt=\"\" />\r\n                 \r\n                    \r\n                <h3>2>出差审批</h3>\r\n                <p>①记录员工出差审批信息</p>\r\n                <img src=\"https://dsc.jsthqc.com/api/v1/fdn-storage/oss/files/download?uri=9134167922923ba09ad18872b2b1246e/material/fd6a396e6d214afc8e72ed508724e213/应用说明/出差审批.png\"\r\n                    alt=\"\" />\r\n\r\n                <h3>3>出差日志</h3>\r\n                <p>①展示员工出差的日志等相关信息</p>\r\n                <img src=\"https://dsc.jsthqc.com/api/v1/fdn-storage/oss/files/download?uri=9134167922923ba09ad18872b2b1246e/material/fd6a396e6d214afc8e72ed508724e213/应用说明/出差日志.png\"\r\n                    alt=\"\" />\r\n                    \r\n                 <h3>4>外出审批</h3>\r\n                <p>①记录员工外出审批信息</p>\r\n                <img src=\"https://dsc.jsthqc.com/api/v1/fdn-storage/oss/files/download?uri=9134167922923ba09ad18872b2b1246e/material/fd6a396e6d214afc8e72ed508724e213/应用说明/外出审批.png\"\r\n                    alt=\"\" />\r\n                    \r\n                <h3>5>请假审批</h3>\r\n                <p>①记录员工请假审批信息</p>\r\n                <img src=\"https://dsc.jsthqc.com/api/v1/fdn-storage/oss/files/download?uri=9134167922923ba09ad18872b2b1246e/material/fd6a396e6d214afc8e72ed508724e213/应用说明/请假审批.png\"\r\n                    alt=\"\" />\r\n                    \r\n                 <h3>6>考勤日报</h3>\r\n                <p>①记录员工考勤日报信息</p>\r\n                <img src=\"https://dsc.jsthqc.com/api/v1/fdn-storage/oss/files/download?uri=9134167922923ba09ad18872b2b1246e/material/fd6a396e6d214afc8e72ed508724e213/应用说明/考勤日报.png\"\r\n                    alt=\"\" />\r\n                    \r\n                   <h3>7>考勤月报</h3>\r\n                <p>①记录员工考勤月报信息</p>\r\n                <img src=\"https://dsc.jsthqc.com/api/v1/fdn-storage/oss/files/download?uri=9134167922923ba09ad18872b2b1246e/material/fd6a396e6d214afc8e72ed508724e213/应用说明/考勤月报.png\"\r\n                    alt=\"\" />\r\n                    \r\n                     <h3>8>考勤申诉</h3>\r\n                <p>①记录员工考勤日报异常申诉后的信息</p>\r\n                <img src=\"https://dsc.jsthqc.com/api/v1/fdn-storage/oss/files/download?uri=9134167922923ba09ad18872b2b1246e/material/fd6a396e6d214afc8e72ed508724e213/应用说明/考勤申诉.png\"\r\n                    alt=\"\" />\r\n                    \r\n                   <h3>9>报表中心</h3>\r\n                <p>①记录员工考勤日报和日报报表信息</p>\r\n                <img src=\"https://dsc.jsthqc.com/api/v1/fdn-storage/oss/files/download?uri=9134167922923ba09ad18872b2b1246e/material/fd6a396e6d214afc8e72ed508724e213/应用说明/日报报表.png\"\r\n                    alt=\"\" />\r\n                    \r\n                 <img src=\"https://dsc.jsthqc.com/api/v1/fdn-storage/oss/files/download?uri=9134167922923ba09ad18872b2b1246e/material/fd6a396e6d214afc8e72ed508724e213/应用说明/月报报表.png\"\r\n                    alt=\"\" />\r\n                    \r\n\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n</body>\r\n\r\n</html>","createTime":1765854149000,"createUserId":"1889706623013949441","fileType":"html","hiddenCode":"62e071b3a7f64f7f97d7197c740049fd","id":"f58cb02913624b34a1932046b5fe890f","modelCode":"","modelId":"cc01c4cea66f452a843127568d09c832","modelType":"CUSTOM_PAGE","name":"index.html","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1765854149000,"versionType":"RELEASE"}