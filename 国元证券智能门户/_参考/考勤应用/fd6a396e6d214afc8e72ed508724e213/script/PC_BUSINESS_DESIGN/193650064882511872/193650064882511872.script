{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"考勤管理","content":"(function () {\r\n    var logger = \"importEhrEmployee:{}\";\r\n    $.log.info(logger, \"开始执行 EHR 员工数据导入\");\r\n\r\n    // === 第一步：调用 EHR 接口获取员工数据 ===\r\n    var uri = \"http://ehr.jsthqc.com:9872/myehr/form/cardformInitData.action?swaggerUserCode=apiManage\";\r\n    var body = {\r\n        \"order\": \"asc\",\r\n        \"offset\": \"0\",\r\n        \"limit\": \"5000\", // 注意：当前只拉2条，后续建议分页拉全量\r\n        \"containerParam\": {},\r\n        \"paramsMap\": {},\r\n        \"requestParam\": {},\r\n        \"sortParams\": {},\r\n        \"filter\": {\r\n            \"EMPVEMPLOYEENEW_CNAME\": \"\",\r\n            \"EMPVEMPLOYEENEW_EMPCODE\": \"\",\r\n            \"_INTERVAIL_MIN_ORGVCOMPANYNEW_OPTIME\": \"\",\r\n            \"_INTERVAIL_MAX_ORGVCOMPANYNEW_OPTIME\": \"\",\r\n            \"EMPVEMPLOYEENEW_CERTNO\": \"\"\r\n        },\r\n        \"userIds\": null,\r\n        \"formId\": \"7447\",\r\n        \"isView\": null,\r\n        \"heightGrade\": []\r\n    };\r\n\r\n    var headers = { \"Content-Type\": \"application/json\" };\r\n    $.log.warn(\"准备请求 EHR 接口...\");\r\n    try {\r\n        var responseString = $.httpclient.sendPost(uri, null, headers, $.json.objectToJsonString(body));\r\n        $.log.warn(\"HTTP响应（原始字符串）: \" + responseString);\r\n\r\n        // 使用七巧平台的 JSON 解析器（返回 FastJSON JSONObject）\r\n        var repsJson = $.json.stringToJsonObject(responseString);\r\n\r\n        // ✅ 正确方式：使用 FastJSON API 获取字段\r\n        var total = repsJson.getInteger(\"total\");\r\n        var rows = repsJson.getJSONArray(\"rows\");\r\n\r\n        // ✅ 正确判断：检查是否为 null（FastJSON 中未命中字段会返回 null）\r\n        if (total == null || rows == null) {\r\n            $.log.error(\"❌ EHR 接口返回格式异常：缺少 rows 或 total\");\r\n            return;\r\n        }\r\n\r\n        $.log.info(logger, \"✅ 成功获取 \" + rows.size() + \" 条员工数据\");\r\n\r\n        // === 第二步：准备写入目标表单 ===\r\n        var applicationId = $.context.getCurrentApplicationId();\r\n        var targetFormName = \"HRP账号信息\"; // 请确保此名称与实际表单一致\r\n        $.log.info(\"目标应用ID: \" + applicationId + \", 表单: \" + targetFormName);\r\n\r\n        var successCount = 0;\r\n        var errorCount = 0;\r\n\r\n        // === 第三步：遍历 rows 并写入表单 ===\r\n        for (var i = 0; i < rows.size(); i++) {\r\n            try {\r\n                var emp = rows.getJSONObject(i); // ✅ 获取第 i 个员工（JSONObject）\r\n                $.log.info(\"--- 处理第 \" + (i + 1) + \" 条员工数据 ---\");\r\n\r\n                // ✅ 使用 .getString() 提取字段（注意：字段可能为 null）\r\n                var empCode = emp.getString(\"EMPVEMPLOYEENEW_EMPCODE\") || \"\";\r\n                var name = emp.getString(\"EMPVEMPLOYEENEW_CNAME\") || \"\";\r\n                var certNo = emp.getString(\"EMPVEMPLOYEENEW_CERTNO\") || \"\";\r\n                var mobile = emp.getString(\"EMPVEMPLOYEENEW_MOBILE\") || \"\";\r\n                var genderCode = emp.getString(\"EMPVEMPLOYEENEW_GENDER\") || \"\";\r\n                var deptName = emp.getString(\"EMPVEMPLOYEENEW_DEPNAME\") || \"\";\r\n                var jobName = emp.getString(\"EMPVEMPLOYEENEW_JOBNAME_DICTNAME\") || \"\";\r\n                var status = emp.getString(\"EMPVEMPLOYEENEW_EMPSTATUS_DICTNAME\") || \"\";\r\n                var joinDate = emp.getString(\"EMPVEMPLOYEENEW_JOINDATE\") || \"\";\r\n\r\n                // 性别转换\r\n                var genderText = \"未知\";\r\n                if (genderCode === \"1\") genderText = \"男\";\r\n                else if (genderCode === \"2\") genderText = \"女\";\r\n\r\n                // 创建空文档\r\n                var newFormDoc = $.form.createEmptyDocument(applicationId, targetFormName);\r\n\r\n                // 写入字段（请确保字段名与你表单中的“字段标识”一致）\r\n                newFormDoc.addElement(\"姓名\", name);\r\n                newFormDoc.addElement(\"工号\", empCode);\r\n                newFormDoc.addElement(\"身份证号\", certNo);\r\n                newFormDoc.addElement(\"手机号\", mobile);\r\n                newFormDoc.addElement(\"性别\", genderText);\r\n                newFormDoc.addElement(\"部门\", deptName);\r\n                newFormDoc.addElement(\"岗位\", jobName);\r\n                newFormDoc.addElement(\"在职状态\", status);\r\n                newFormDoc.addElement(\"入职时间\", joinDate);\r\n\r\n                // 保存\r\n                $.form.saveFormDocument(newFormDoc, applicationId);\r\n                $.log.info(\"✅ 员工 [\" + empCode + \"] \" + name + \" 导入成功\");\r\n                successCount++;\r\n\r\n            } catch (e) {\r\n                errorCount++;\r\n                $.log.error(\"❌ 处理第 \" + (i + 1) + \" 条数据失败: \" + e.toString());\r\n                // 注意：七巧平台中 e.stack 可能不可用，可省略\r\n            }\r\n\r\n            // 进度提示\r\n            if ((i + 1) % 50 === 0) {\r\n                $.log.info(\"📊 进度: \" + (i + 1) + \" / \" + rows.size());\r\n            }\r\n        }\r\n\r\n        // === 第四步：输出结果 ===\r\n        var msg = \"EHR 员工数据导入完成。成功: \" + successCount + \"，失败: \" + errorCount;\r\n        $.log.info(\"=== \" + msg + \" ===\");\r\n        if (errorCount > 0) {\r\n            $.log.warn(\"⚠️ 有失败项，请检查日志\");\r\n        } else {\r\n            $.log.info(\"🎉 全部导入成功！\");\r\n        }\r\n\r\n    } catch (e) {\r\n        $.log.error(\"❌ 脚本执行异常: \" + e.toString());\r\n    }\r\n\r\n    $.log.info(logger, \"函数执行结束\");\r\n})();","createTime":1770255748000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"7f66a4f4e7cd48019506f3517f574fef","id":"193650064882511872","modelCode":"","modelId":"6983f126b67b7338f277bf5e","modelType":"PC_BUSINESS_DESIGN","namespace":"直接获取","path":"HRP账号信息列表","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1770258978988,"versions":0.0}