{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"中交路南-出差考勤管理","content":"(function () {\r\n    var doc = $.context.getCurrentDocument();\r\n    var applicationId = $.context.getCurrentApplicationId();\r\n    var name = doc.getElementByName(\"姓名\").getValue();\r\n\r\n\r\n    var map = new Packages.java.util.HashMap();\r\n    map.put(\"姓名\", name);\r\n    var formName = \"员工信息维护\";\r\n    var documents = $.form.getFormDocumentsByFieldNameAndValue(applicationId, formName, map);\r\n    $.message.sendGeneralStationMessage(\"1\", documents, $.context.getCurrentUserId());\r\n    if (documents != null) {\r\n        var jibei = documents.get(0).getElementByName(\"级别\").getValue();\r\n        return jibei;\r\n    } else {\r\n        return \"\";\r\n    }\r\n\r\n})()\r\n","createTime":1765854149000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"b33630a09b984c9288e561adbdc0149c","id":"ef12b4cf47094667ba8542d9e8288e28","modelCode":"","modelId":"fcfadfe8ff0941a7bcbc1e911869f379","modelType":"FORM_DESIGN","namespace":"cd","path":"外出审批单","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1765854149000,"versions":0.0}