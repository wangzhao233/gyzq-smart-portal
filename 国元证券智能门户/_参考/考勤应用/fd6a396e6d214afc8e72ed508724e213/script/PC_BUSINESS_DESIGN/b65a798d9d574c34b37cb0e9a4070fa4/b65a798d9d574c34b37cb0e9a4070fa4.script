{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"中交路南-出差考勤管理","content":"(function () {\r\n    //获取本月度\r\n    var now = $.date.getCurrentDate();        //当前日期       \r\n    var nowMonth = now.getMonth() - 1;           //当前月     \r\n    var nowYear = now.getYear() + 1900;\r\n    var mongthdays = getMonthDays(nowYear, nowMonth);//本月天数\r\n\r\n    var monthstartdate = getMonthStartDate(nowYear, nowMonth);  //本月起始日期\r\n    var monthEndDate = getMonthEndDate(nowYear, nowMonth, mongthdays + 23);//本月结束日期\r\n\r\n    var date = monthstartdate.getTime();\r\n    var date1 = monthEndDate.getTime();\r\n    //接收用户id集合\r\n    var receiveUserIds = $.context.getCurrentUserId();\r\n    //发送站内信\r\n    $.message.sendGeneralStationMessage(\"subject\", date, receiveUserIds);\r\n    $.message.sendGeneralStationMessage(\"subject1\", date1, receiveUserIds);\r\n})()\r\n//获得本月的开始日期     \r\nfunction getMonthStartDate(nowYear, nowMonth) {\r\n    var monthStartDate0 = new Date(nowYear, nowMonth, 22);\r\n    //转格式\r\n    var format = \"yyyy-MM-dd\";\r\n    //获取日期字符串\r\n    var dateStr = $.date.dateToString(monthStartDate0, format);\r\n    var monthStartDate = $.date.stringToDate(dateStr, format)\r\n    return monthStartDate;\r\n}\r\n\r\n//获得本月的结束日期     \r\nfunction getMonthEndDate(nowYear, nowMonth, mongthdays) {\r\n    var monthEndDate0 = new Date(nowYear, nowMonth, mongthdays);\r\n    //转格式\r\n    var format = \"yyyy-MM-dd\";\r\n    //获取日期字符串\r\n    var dateStr = $.date.dateToString(monthEndDate0, format);\r\n    var monthEndDate = $.date.stringToDate(dateStr, format)\r\n    return monthEndDate;\r\n}\r\n\r\n//获取本月总共天数\r\nfunction getMonthDays(nowYear, nowMonth) {\r\n\r\n    var endday = new Date(nowYear, nowMonth + 1, 0);\r\n\r\n    return endday.getDate();\r\n\r\n} ","createTime":1765854149000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"f0617aa186b8498a9f0885fad2bce8d2","id":"b65a798d9d574c34b37cb0e9a4070fa4","modelCode":"","modelId":"a2adf27408904b3e83cff0675b6cee9e","modelType":"PC_BUSINESS_DESIGN","namespace":"2222222","path":"考勤月报列表","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1765854149000,"versions":0.0}