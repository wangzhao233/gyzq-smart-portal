<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>管理后台 · 下载门户</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="admin-header">
    <h1>兑换码管理后台</h1>
    <nav class="admin-nav">
      <a href="/admin" class="<%= tab === 'dashboard' ? 'active' : '' %>">仪表盘</a>
      <a href="/admin?tab=import" class="<%= tab === 'import' ? 'active' : '' %>" onclick="switchTab('import');return false">导入兑换码</a>
      <a href="/admin/pool" class="<%= tab === 'pool' ? 'active' : '' %>">链接池</a>
      <a href="/admin/logs" class="<%= tab === 'logs' ? 'active' : '' %>">消耗日志</a>
    </nav>
  </div>

  <div class="admin-layout">
    <% if (message) { %>
      <div class="msg <%= message.type %>"><%= message.text %></div>
    <% } %>

    <!-- 仪表盘 Tab -->
    <div class="admin-tab <%= tab === 'dashboard' ? 'active' : '' %>" id="tab-dashboard">
      <div class="stats-grid">
        <div class="stat-card">
          <div class="number"><%= stats.total %></div>
          <div class="label">总量</div>
        </div>
        <div class="stat-card">
          <div class="number used"><%= stats.used %></div>
          <div class="label">已用</div>
        </div>
        <div class="stat-card">
          <div class="number available"><%= stats.available %></div>
          <div class="label">可用</div>
        </div>
      </div>
      <div class="card">
        <h2>今日消耗：<strong style="color:#1F4E79"><%= stats.today_used %></strong></h2>
      </div>
      <div class="card">
        <h2>最近 7 天消耗趋势</h2>
        <div class="bar-chart" id="trend-chart"></div>
      </div>
    </div>

    <!-- 导入兑换码 Tab -->
    <div class="admin-tab <%= tab === 'import' ? 'active' : '' %>" id="tab-import">
      <div class="card">
        <h2>批量导入兑换链接</h2>
        <p style="font-size:13px;color:#888;margin-bottom:12px">每行一个 Apple 兑换链接，支持粘贴批量导入</p>
        <form method="POST" action="/admin/upload">
          <textarea name="codes" placeholder="https://apps.apple.com/redeem?ctx=offercodes&amp;id=123456789&amp;code=EXAMPLE1&#10;https://apps.apple.com/redeem?ctx=offercodes&amp;id=123456789&amp;code=EXAMPLE2"></textarea>
          <div style="margin-top:12px">
            <button type="submit" class="btn">导入</button>
          </div>
        </form>
      </div>
    </div>

    <!-- 链接池 Tab -->
    <div class="admin-tab <%= tab === 'pool' ? 'active' : '' %>" id="tab-pool">
      <div class="card">
        <!-- 统计概览 -->
        <% if (pool && pool.total > 0) { %>
        <div style="display:flex;gap:16px;margin-bottom:16px;flex-wrap:wrap">
          <div style="background:#f0f7ff;padding:10px 16px;border-radius:8px;flex:1;min-width:80px;text-align:center">
            <div style="font-size:24px;font-weight:bold;color:#1F4E79"><%= pool.total %></div>
            <div style="font-size:12px;color:#666">总计</div>
          </div>
          <div style="background:#f0fff0;padding:10px 16px;border-radius:8px;flex:1;min-width:80px;text-align:center">
            <div style="font-size:24px;font-weight:bold;color:#2e7d32"><%= statusFilter === 'used' ? pool.total : stats.available %></div>
            <div style="font-size:12px;color:#666">可用</div>
          </div>
          <div style="background:#fff0f0;padding:10px 16px;border-radius:8px;flex:1;min-width:80px;text-align:center">
            <div style="font-size:24px;font-weight:bold;color:#c62828"><%= statusFilter === 'available' ? 0 : stats.used %></div>
            <div style="font-size:12px;color:#666">已用</div>
          </div>
        </div>
        <% } %>

        <div class="filters">
          <form method="GET" action="/admin/pool" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
            <select name="status" onchange="this.form.submit()" style="padding:6px 12px;border:1px solid #ddd;border-radius:6px;font-size:14px">
              <option value="all" <%= statusFilter === 'all' ? 'selected' : '' %>>全部</option>
              <option value="available" <%= statusFilter === 'available' ? 'selected' : '' %>>可用</option>
              <option value="used" <%= statusFilter === 'used' ? 'selected' : '' %>>已用</option>
            </select>
          </form>
        </div>
        <% if (!pool || pool.rows.length === 0) { %>
          <div class="empty">暂无数据</div>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>ID</th>
                  <th>兑换码</th>
                  <th>状态</th>
                  <th>创建时间</th>
                  <th>消耗时间</th>
                  <th>消耗IP</th>
                </tr>
              </thead>
              <tbody>
                <% pool.rows.forEach(function(row) { %>
                  <tr>
                    <td><%= row.id %></td>
                    <td style="max-width:250px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px;font-family:monospace" title="<%= row.apple_url %>">
                      <% var codeMatch = row.apple_url.match(/code=([^&]+)/); %>
                      <%= codeMatch ? codeMatch[1] : row.apple_url.slice(0,50) %>
                    </td>
                    <td><span class="badge <%= row.status %>"><%= row.status === 'available' ? '可用' : '已用' %></span></td>
                    <td><%= row.created_at %></td>
                    <td><%= row.used_at || '-' %></td>
                    <td style="max-width:120px;overflow:hidden;text-overflow:ellipsis"><%= row.access_ip ? (row.access_ip.length > 30 ? row.access_ip.slice(0,30) + '...' : row.access_ip) : '-' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% if (pool.totalPages > 1) { %>
            <div class="pagination">
              <% if (pool.page > 1) { %>
                <a href="/admin/pool?page=<%= pool.page - 1 %>&status=<%= statusFilter %>">‹</a>
              <% } %>
              <% for (let i = 1; i <= pool.totalPages; i++) { %>
                <% if (i === pool.page) { %>
                  <span class="current"><%= i %></span>
                <% } else { %>
                  <a href="/admin/pool?page=<%= i %>&status=<%= statusFilter %>"><%= i %></a>
                <% } %>
              <% } %>
              <% if (pool.page < pool.totalPages) { %>
                <a href="/admin/pool?page=<%= pool.page + 1 %>&status=<%= statusFilter %>">›</a>
              <% } %>
            </div>
          <% } %>
        <% } %>
      </div>
    </div>

    <!-- 消耗日志 Tab -->
    <div class="admin-tab <%= tab === 'logs' ? 'active' : '' %>" id="tab-logs">
      <div class="card">
        <% if (!logs || logs.rows.length === 0) { %>
          <div class="empty">暂无消耗记录</div>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>时间</th>
                  <th>IP</th>
                  <th>设备信息</th>
                </tr>
              </thead>
              <tbody>
                <% logs.rows.forEach(function(row) { %>
                  <tr>
                    <td><%= row.used_at %></td>
                    <td style="max-width:120px;overflow:hidden;text-overflow:ellipsis"><%= row.access_ip || '-' %></td>
                    <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;font-size:12px;color:#888" title="<%= row.user_agent %>"><%= row.user_agent ? row.user_agent.slice(0, 60) + (row.user_agent.length > 60 ? '...' : '') : '-' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% if (logs.totalPages > 1) { %>
            <div class="pagination">
              <% if (logs.page > 1) { %>
                <a href="/admin/logs?page=<%= logs.page - 1 %>">‹</a>
              <% } %>
              <% for (let i = 1; i <= logs.totalPages; i++) { %>
                <% if (i === logs.page) { %>
                  <span class="current"><%= i %></span>
                <% } else { %>
                  <a href="/admin/logs?page=<%= i %>"><%= i %></a>
                <% } %>
              <% } %>
              <% if (logs.page < logs.totalPages) { %>
                <a href="/admin/logs?page=<%= logs.page + 1 %>">›</a>
              <% } %>
            </div>
          <% } %>
        <% } %>
      </div>
    </div>
  </div>

  <script>
    function switchTab(name) {
      document.querySelectorAll('.admin-tab').forEach(function(el) {
        el.classList.remove('active');
      });
      document.querySelectorAll('.admin-nav a').forEach(function(el) {
        el.classList.remove('active');
      });
      document.getElementById('tab-' + name).classList.add('active');
      document.querySelector('.admin-nav a[href="/admin?tab=' + name + '"]').classList.add('active');
      var url = new URL(window.location);
      url.searchParams.set('tab', name);
      window.history.replaceState({}, '', url);
    }

    // 渲染柱状图
    (function() {
      var trendData = <%- trend %>;
      var chart = document.getElementById('trend-chart');
      if (!chart || !trendData) return;
      var maxVal = Math.max.apply(null, trendData.counts) || 1;
      for (var i = 0; i < trendData.days.length; i++) {
        var height = (trendData.counts[i] / maxVal) * 100;
        var dayLabel = trendData.days[i].slice(5);
        var item = document.createElement('div');
        item.className = 'bar-item';
        item.innerHTML = '<div class="bar" style="height:' + Math.max(height, 4) + 'px"></div><span class="bar-label">' + dayLabel + '</span>';
        chart.appendChild(item);
      }
    })();
  </script>
</body>
</html>
