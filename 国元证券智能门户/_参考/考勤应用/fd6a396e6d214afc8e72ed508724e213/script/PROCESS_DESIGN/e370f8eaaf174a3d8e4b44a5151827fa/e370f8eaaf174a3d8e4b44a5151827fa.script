{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"中交路南-出差考勤管理","content":"(function () {\r\n    var doc = $.context.getCurrentDocument();\r\n    // var applicationId = $.context.getCurrentApplicationId();\r\n    var num = doc.getElementByName(\"剩余年假天数\").getValue();\r\n    if (num > 0) {\r\n        //接收用户id集合\r\n        var receiveUserIds = $.context.getCurrentUserId();\r\n        //发送站内信\r\n        $.message.sendGeneralStationMessage(\"111\", num, receiveUserIds);\r\n        return num;\r\n    } else {\r\n        //获取默认校验信息集合\r\n        var message = $.validate.create();\r\n        message.addError(\"提交失败，你已经没有剩余年假了\");\r\n        //返回默认校验信息集合\r\n        return message;\r\n    }\r\n\r\n})()","createTime":1765854149000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"8bc9a6d585e440d48a0a02a273277207","id":"e370f8eaaf174a3d8e4b44a5151827fa","modelCode":"","modelId":"d881630bffca4c4397a6fe984e98f5c4","modelType":"PROCESS_DESIGN","namespace":"cd","path":"请假审批","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1765854149000,"versions":0.0}