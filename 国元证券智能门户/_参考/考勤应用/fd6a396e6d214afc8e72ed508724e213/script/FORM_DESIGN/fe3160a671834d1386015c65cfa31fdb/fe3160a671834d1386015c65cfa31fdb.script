{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"中交路南-出差考勤管理","content":"(function () {\r\n    var doc = $.context.getCurrentDocument();\r\n    var applicationId = $.context.getCurrentApplicationId();\r\n    var name = doc.getElementByName(\"账号\").getValue();\r\n\r\n\r\n    var map = new Packages.java.util.HashMap();\r\n    map.put(\"关联月报\", name);\r\n    var formName = \"月报假勤统计\";\r\n    var documents = $.form.getFormDocumentsByFieldNameAndValue(applicationId, formName, map);\r\n    var a = 0;\r\n    $.message.sendGeneralStationMessage(\"1\", documents, $.context.getCurrentUserId());\r\n    if (documents != null) {\r\n        var jibei = documents.get(0).getElementByName(\"假勤类型\").getValue();\r\n        if (jibei == \"2\") {\r\n            a += jibei;\r\n            return a;\r\n        }\r\n    } else {\r\n        return \"\";\r\n    }\r\n\r\n})()\r\n","createTime":1765854149000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"e8f055299a0e4611b672d34c74d7679b","id":"fe3160a671834d1386015c65cfa31fdb","modelCode":"","modelId":"b91d67a4bf904203a3ba3e0bb6ab1bee","modelType":"FORM_DESIGN","namespace":"111","path":"考勤月报","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1765854149000,"versions":0.0}