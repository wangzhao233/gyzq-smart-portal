{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"考勤管理","content":"(function(){\r\n    // 1. 获取当前应用ID\r\n    var applicationId = $.context.getCurrentApplicationId();\r\n    // 2. 指定要清空的表单名称\r\n    var formName = \"原始记录打卡报表\";\r\n    \r\n    // 3. 查询该表单下的所有数据，以获取其ID列表\r\n    // 使用空的条件Map，查询所有数据 [3]\r\n    var conditionMap = new Packages.java.util.HashMap();\r\n    var allDocuments = $.form.getDocumentsByConditionAsJson(applicationId, formName, conditionMap); // 引用 [3]\r\n    \r\n    // 4. 准备用于删除的ID列表\r\n    var idList = new Packages.java.util.ArrayList();\r\n    for (var i = 0; i < allDocuments.size(); i++) {\r\n        var doc = allDocuments.get(i);\r\n        // 假设返回的JSON对象中包含“id”字段\r\n        var docId = doc.get(\"id\");\r\n        if (docId) {\r\n            idList.add(docId);\r\n        }\r\n    }\r\n    \r\n    $.log.info(\"准备删除表单‘\" + formName + \"’下的 \" + idList.size() + \" 条数据。\");\r\n    \r\n    // 5. 执行批量删除 [3]\r\n    if (idList.size() > 0) {\r\n        $.form.batchDeleteFormDocumentsByIdList(applicationId, formName, idList); // 引用 [3]\r\n        return {\r\n            success: true,\r\n            message: \"成功清空表单‘\" + formName + \"’，共删除 \" + idList.size() + \" 条数据。\"\r\n        };\r\n    } else {\r\n        return {\r\n            success: true,\r\n            message: \"表单‘\" + formName + \"’中暂无数据可删除。\"\r\n        };\r\n    }\r\n})()\r\n","createTime":1774273690139,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"6a692e8978964262ad16df7f3476e14c","id":"197965447231932416","modelCode":"","modelId":"69bbf927d5024d1aa621535e","modelType":"PC_BUSINESS_DESIGN","namespace":"全部清空","path":"原始记录打卡报表列表","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1774273690139,"versions":0.0}