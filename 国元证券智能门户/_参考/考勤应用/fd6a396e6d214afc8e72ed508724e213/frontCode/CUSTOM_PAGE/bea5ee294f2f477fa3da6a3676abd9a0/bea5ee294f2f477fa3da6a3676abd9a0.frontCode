{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"【模】考勤管理","content":"\n/*全局css*/\n*{\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n}\n\n::-webkit-scrollbar-track-piece {\n  background-color:#f8f8f8;\n}\n::-webkit-scrollbar {\n  width:12px;\n  height:12px;\n}\n::-webkit-scrollbar-thumb {\n  background-color:#ddd;\n  background-clip:padding-box;\n  border-radius:20px ;\n  min-height:28px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background-color:#bbb;\n}\n\nli{\n  list-style: none;\n}\nbody,html,#app {\n  /*font-family: element-icons;*/\n  height: 100%;\n  width: 100%;\n  background: #fff;\n}\n.Wrap{\n  padding: 20px 40px;\n}\n.h_s{\n  color: #333;\n  padding-bottom: 10px;\n  text-align: center;\n  font-size: 22px;\n}\n.inList{\n  padding-top: 25px;\n}\n.inList h2{\n  \n  color: #333;\n  padding-bottom: 20px;\n  font-size: 20px;\n}\n.inList img{\n  width: 100%;\n  margin-top: 10px;\n  border: 2px dashed #ddd;\n  display: block;\n}\n.inList p {\n  text-indent: 2em;\n  line-height: 1.5;\n  font-size: 18px;\n  color: #444;\n  padding-bottom: 10px;\n}\n\n\n\n\n\n\n\n\n\n\n\n\n\n","createTime":1765854149000,"createUserId":"1889706623013949441","fileType":"css","hiddenCode":"96a7bb36261f4e0d95961f8ef28d94af","id":"bea5ee294f2f477fa3da6a3676abd9a0","modelCode":"","modelId":"a416d46902eb4a3dab9bc811291fd3c1","modelType":"CUSTOM_PAGE","name":"index.css","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1765854149000,"versionType":"DEVELOP"}