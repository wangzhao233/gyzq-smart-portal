{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"考勤管理","content":"(function(){\r\n    // ============================================================\r\n    // 员工年假计算脚本 v3.2\r\n    // 修复：Anniversary未到时直接返回旧档次（不折算）\r\n    // 规则：工龄<1年=0天 | 1~10年=5天 | 10~20年=10天 | >=20年=15天\r\n    // Anniversary（第10/20年）当年已过→分段计算，未到→直接旧档次\r\n    // ============================================================\r\n\r\n    var applicationId = $.context.getCurrentApplicationId();\r\n    var currentUserId = $.context.getCurrentUserId();\r\n    var currentDate = new Date();\r\n    var currentYear = currentDate.getFullYear();\r\n\r\n    var formName        = \"员工信息维护\";\r\n    var accountField    = \"账号\";\r\n    var workStartField  = \"参加工作日期\";   // 社会工龄基准，决定年假档次\r\n    var groupJoinField  = \"到集团体系日期\"; // 新员工首年折算用\r\n    var workYearsField  = \"工作年限\";\r\n    var leaveTotalField = \"可休年假\";\r\n    var leaveUsedField  = \"已休年假\";\r\n    var leaveBalField   = \"剩余年假\";\r\n\r\n    function log(msg) { $.log.info(msg); }\r\n\r\n    // ---------- 日期解析 ----------\r\n    // ★ parseDate：参照参考脚本的日期解析逻辑，统一处理所有返回类型\r\n    // 七巧日期字段可能返回：Date对象 / 毫秒时间戳对象 / 字符串 / null\r\n    function parseDate(v) {\r\n        if (!v || v === null || v === undefined) return null;\r\n        try {\r\n            // 1. 原生 Date\r\n            if (v instanceof Date) {\r\n                return isNaN(v.getTime()) ? null : v;\r\n            }\r\n            // 2. 数值（毫秒时间戳）\r\n            if (typeof v === 'number') {\r\n                return new Date(v);\r\n            }\r\n            // 3. 字符串\r\n            if (typeof v === 'string') {\r\n                if (/^\\d+$/.test(v)) return new Date(parseInt(v));\r\n                var d = new Date(v);\r\n                return isNaN(d.getTime()) ? null : d;\r\n            }\r\n            // 4. 对象（Date-like 对象、七巧特殊包装对象）\r\n            if (typeof v === 'object') {\r\n                // 方法1：直接有 getTime()\r\n                if (typeof v.getTime === 'function') {\r\n                    var ms = v.getTime();\r\n                    if (!isNaN(ms) && ms > 0) return new Date(ms);\r\n                }\r\n                // 方法2：JSON 序列化后提取时间戳\r\n                var objStr = $.json.objectToJsonString(v);\r\n                if (objStr) {\r\n                    var match = objStr.match(/\\b\\d{10,13}\\b/);\r\n                    if (match) {\r\n                        var num = parseInt(match[0]);\r\n                        // 10位 = 秒，13位 = 毫秒\r\n                        var ms = num > 1e11 ? num : num * 1000;\r\n                        var d = new Date(ms);\r\n                        if (!isNaN(d.getTime())) return d;\r\n                    }\r\n                }\r\n                // 方法3：直接 new Date(objStr) 碰运气\r\n                if (objStr) {\r\n                    var d2 = new Date(objStr);\r\n                    if (!isNaN(d2.getTime())) return d2;\r\n                }\r\n            }\r\n        } catch(e) { log(\"[WARN] 日期解析失败: \" + e.message); }\r\n        return null;\r\n    }\r\n\r\n    function fmt(d) {\r\n        if (!d || isNaN(d.getTime())) return \"NULL\";\r\n        return d.getFullYear() + \"-\"\r\n            + ('0'+(d.getMonth()+1)).slice(-2) + \"-\"\r\n            + ('0'+d.getDate()).slice(-2);\r\n    }\r\n\r\n    // ---------- 工龄计算（精确到月） ----------\r\n    function workYears(start, now) {\r\n        if (!start || isNaN(start.getTime())) return 0;\r\n        var y = now.getFullYear() - start.getFullYear();\r\n        var mo = now.getMonth()   - start.getMonth();\r\n        var da = now.getDate()    - start.getDate();\r\n        if (mo < 0 || (mo === 0 && da < 0)) { y--; }\r\n        return y + (now.getMonth() - start.getMonth() + (da < 0 ? -1 : 0) + 12) % 12 / 12.0;\r\n    }\r\n\r\n    // ---------- 年假计算（核心） ----------\r\n    function calcLeave(workStart, groupJoin) {\r\n        if (!workStart || isNaN(workStart.getTime())) return 0;\r\n\r\n        var wy = workYears(workStart, currentDate);\r\n        var wyFloor = Math.floor(wy);\r\n\r\n        // 工龄不满1年 → 0天（无年假）\r\n        if (wy < 1) return 0;\r\n\r\n        var jan1  = new Date(currentYear, 0, 1);\r\n        var dec31 = new Date(currentYear, 11, 31);\r\n\r\n        // 10年 Anniversary 节点\r\n        var anniv10 = new Date(workStart.getFullYear()+10, workStart.getMonth(), workStart.getDate());\r\n        // 20年 Anniversary 节点\r\n        var anniv20 = new Date(workStart.getFullYear()+20, workStart.getMonth(), workStart.getDate());\r\n\r\n        // 第10年 Anniversary 在今年\r\n        if (anniv10 >= jan1 && anniv10 <= dec31) {\r\n            if (currentDate >= anniv10) {\r\n                // Anniversary 已发生：前段按5天，后段按10天，按比例相加\r\n                var before = Math.ceil((anniv10 - jan1) / 86400000);\r\n                var after  = 365 - before;\r\n                return Math.round(before/365.0*5 + after/365.0*10);\r\n            }\r\n            // Anniversary 未到：工龄还未满10年，直接5天\r\n            return 5;\r\n        }\r\n\r\n        // 第20年 Anniversary 在今年\r\n        if (anniv20 >= jan1 && anniv20 <= dec31) {\r\n            if (currentDate >= anniv20) {\r\n                // Anniversary 已发生：前段按10天，后段按15天\r\n                var before = Math.ceil((anniv20 - jan1) / 86400000);\r\n                var after  = 365 - before;\r\n                return Math.round(before/365.0*10 + after/365.0*15);\r\n            }\r\n            // Anniversary 未到：直接10天\r\n            return 10;\r\n        }\r\n\r\n        // 正常年度：按工龄整年数判档次\r\n        if (wyFloor >= 20) return 15;\r\n        if (wyFloor >= 10) return 10;\r\n        return 5;\r\n    }\r\n\r\n    // ============================================================\r\n    // 主流程\r\n    // ============================================================\r\n    log(\"===== 年假计算 v3.2 开始 | \" + fmt(currentDate) + \" =====\");\r\n\r\n    try {\r\n        var cond = new Packages.java.util.HashMap();\r\n        var list = $.form.getDocumentsByCondition(applicationId, formName, cond);\r\n\r\n        if (!list || list.isEmpty()) {\r\n            log(\"[ERROR] 未找到记录，表单名=\" + formName);\r\n            return { success: false };\r\n        }\r\n\r\n        var total = list.size();\r\n        var ok = 0, skip = 0, err = 0;\r\n        log(\"共 \" + total + \" 条，开始处理...\");\r\n\r\n        for (var i = 0; i < total; i++) {\r\n            var doc = list.get(i);\r\n            var acct = \"\";\r\n            try {\r\n                var acctElem = doc.getElementByName(accountField);\r\n                acct = acctElem ? (acctElem.getValue() || (\"ID=\"+doc.getId())) : (\"ID=\"+doc.getId());\r\n\r\n                var wsElem = doc.getElementByName(workStartField);\r\n                var gjElem = doc.getElementByName(groupJoinField);\r\n                var wsRaw  = wsElem ? wsElem.getValue() : null;\r\n                var gjRaw  = gjElem ? gjElem.getValue() : null;\r\n\r\n                var wsDate = parseDate(wsRaw);\r\n                var gjDate = parseDate(gjRaw);\r\n\r\n                // ★ 诊断：当字段找不到时，打印文档所有可用字段名（帮助排查字段名差异）\r\n                if (!wsElem) {\r\n                    var allNames = [];\r\n                    try {\r\n                        var elemNames = doc.elementNames;\r\n                        if (elemNames && typeof elemNames.forEach === 'function') {\r\n                            elemNames.forEach(function(n) { allNames.push(n); });\r\n                        } else if (Array.isArray(elemNames)) {\r\n                            allNames = elemNames;\r\n                        }\r\n                    } catch(e2) {}\r\n                    var fieldList = allNames.length > 0 ? allNames.join(\", \") : \"(无法获取字段列表)\";\r\n                    log(\"[跳过] \" + acct + \" | 字段[\" + workStartField + \"]未找到，可用字段: \" + fieldList);\r\n                    skip++;\r\n                    continue;\r\n                }\r\n\r\n                var wsRaw  = wsElem ? wsElem.getValue() : null;\r\n                var gjRaw  = gjElem ? gjElem.getValue() : null;\r\n                var wsDate = parseDate(wsRaw);\r\n                var gjDate = parseDate(gjRaw);\r\n\r\n                if (!wsDate) {\r\n                    // 字段存在但值为空或无法解析\r\n                    var rawType = wsRaw === null ? \"null\" : typeof wsRaw;\r\n                    var rawStr = (rawType === \"object\") ? $.json.objectToJsonString(wsRaw) : String(wsRaw);\r\n                    log(\"[跳过] \" + acct + \" | 参加工作日期原始值类型=\" + rawType + \" 值=\" + rawStr + \" → 解析失败\");\r\n                    skip++;\r\n                    continue;\r\n                }\r\n\r\n                var wy        = gjDate ? workYears(gjDate, currentDate) : 0;\r\n                var leaveTotal = calcLeave(wsDate, gjDate);\r\n                var usedElem  = doc.getElementByName(leaveUsedField);\r\n                var leaveUsed = usedElem ? (parseFloat(usedElem.getValue()) || 0) : 0;\r\n                var leaveBal  = Math.max(0, leaveTotal - leaveUsed);\r\n\r\n                log(\"[\" + acct + \"] 集团工龄=\" + wy.toFixed(2)\r\n                    + \" 参加=\" + fmt(wsDate)\r\n                    + \" 集团=\" + fmt(gjDate)\r\n                    + \" 可休=\" + leaveTotal\r\n                    + \" 剩余=\" + leaveBal);\r\n\r\n                doc.addElement(workYearsField,  parseFloat(wy.toFixed(2)));\r\n                doc.addElement(leaveTotalField, leaveTotal);\r\n                doc.addElement(leaveBalField,   leaveBal);\r\n                $.form.saveFormDocument(doc, applicationId);\r\n                ok++;\r\n\r\n            } catch(e) {\r\n                log(\"[ERR] \" + acct + \" | \" + e.message);\r\n                err++;\r\n            }\r\n        }\r\n\r\n        var summary = \"v3.2完成: 总=\" + total + \" 更新=\" + ok + \" 跳过=\" + skip + \" 失败=\" + err;\r\n        log(\"===== \" + summary + \" =====\");\r\n        $.message.sendGeneralStationMessage(\"年假计算完成\", summary, currentUserId);\r\n        return { success:true, total:total, ok:ok, skip:skip, err:err };\r\n\r\n    } catch(ge) {\r\n        log(\"[FATAL] \" + ge.message);\r\n        $.message.sendGeneralStationMessage(\"年假计算异常\", ge.message, currentUserId);\r\n        return { success:false, message:ge.message };\r\n    }\r\n})();\r\n","createTime":1776261439000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"81e6a2bd07624071810442aeb7dfedf8","id":"200099776468848640","modelCode":"","modelId":"d37b5bf2704b4b3996edbbfdfbeaee74","modelType":"PC_BUSINESS_DESIGN","namespace":"年假4.0","path":"员工信息","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1776330735658,"versions":0.0}