{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"中交路南-出差考勤管理","content":"(function () {\r\n    var doc = $.context.getCurrentDocument();\r\n    var applicationId = $.context.getCurrentApplicationId();\r\n    var name = doc.getElementByName(\"姓名\").getValue();\r\n\r\n\r\n    var map = new Packages.java.util.HashMap();\r\n    map.put(\"姓名\", name);\r\n    var formName = \"员工信息维护\";\r\n    var documents = $.form.getFormDocumentsByFieldNameAndValue(applicationId, formName, map);\r\n    $.message.sendGeneralStationMessage(\"1\", documents, $.context.getCurrentUserId());\r\n    if (documents != null) {\r\n        var jibei = documents.get(0).getElementByName(\"级别\").getValue();\r\n        return jibei;\r\n    } else {\r\n        return \"\";\r\n    }\r\n\r\n})()\r\n","createTime":1765854149000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"53321977c2214034a23af36fda043206","id":"a0e38bf5a90742c596f6be4be43515ff","modelCode":"","modelId":"aba553fbf6a34c92bf342fd16aaff1bd","modelType":"FORM_DESIGN","namespace":"cd","path":"请假审批单","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1765854149000,"versions":0.0}