{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"【模】考勤管理","content":"\r\n/*全局css*/\r\n*{\r\n  margin: 0;\r\n  padding: 0;\r\n  box-sizing: border-box;\r\n}\r\n\r\n::-webkit-scrollbar-track-piece {\r\n  background-color:#f8f8f8;\r\n}\r\n::-webkit-scrollbar {\r\n  width:12px;\r\n  height:12px;\r\n}\r\n::-webkit-scrollbar-thumb {\r\n  background-color:#ddd;\r\n  background-clip:padding-box;\r\n  border-radius:20px ;\r\n  min-height:28px;\r\n}\r\n::-webkit-scrollbar-thumb:hover {\r\n  background-color:#bbb;\r\n}\r\n\r\nli{\r\n  list-style: none;\r\n}\r\nbody,html,#app {\r\n  /*font-family: element-icons;*/\r\n  height: 100%;\r\n  width: 100%;\r\n  background: #fff;\r\n}\r\n.Wrap{\r\n  padding: 20px 40px;\r\n}\r\n.h_s{\r\n  color: #333;\r\n  padding-bottom: 10px;\r\n  text-align: center;\r\n  font-size: 22px;\r\n}\r\n.inList{\r\n  padding-top: 25px;\r\n}\r\n.inList h2{\r\n  \r\n  color: #333;\r\n  padding-bottom: 20px;\r\n  font-size: 20px;\r\n}\r\n.inList img{\r\n  width: 100%;\r\n  margin-top: 10px;\r\n  border: 2px dashed #ddd;\r\n  display: block;\r\n}\r\n.inList p {\r\n  text-indent: 2em;\r\n  line-height: 1.5;\r\n  font-size: 18px;\r\n  color: #444;\r\n  padding-bottom: 10px;\r\n}\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n","createTime":1765854149000,"createUserId":"1889706623013949441","fileType":"css","hiddenCode":"e45daac636964ee0b7ea998710c28ead","id":"f9dc0ac14dbe4f8fa3c8dc92dbc574c4","modelCode":"","modelId":"cc01c4cea66f452a843127568d09c832","modelType":"CUSTOM_PAGE","name":"index.css","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1765854149000,"versionType":"DEVELOP"}