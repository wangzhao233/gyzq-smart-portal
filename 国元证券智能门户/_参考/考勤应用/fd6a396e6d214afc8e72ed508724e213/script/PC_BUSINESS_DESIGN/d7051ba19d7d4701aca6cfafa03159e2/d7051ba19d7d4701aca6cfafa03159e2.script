{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"中交路南-出差考勤管理","content":"(function () {\r\n        // var accountList = new Packages.java.util.ArrayList();\r\n           var applicationId = $.context.getCurrentApplicationId();\r\n        var userMap = new Packages.java.util.HashMap();\r\n        var userDocsList = $.form.getFormDocumentsByFieldNameAndValue(applicationId, \"员工信息维护\", userMap);\r\n        var b = userDocsList.size();\r\n        if (b > 100) {\r\n                b = 100\r\n        }\r\n        if (userDocsList != null && b > 0) {\r\n                for (var a = 0; a < b; a++) {\r\n                        var userId = userDocsList.get(a).getElementByName(\"姓名\").getValue();\r\n                        var user = $.contact.getUserById(userId);\r\n                }\r\n        }\r\n        //表单名称\r\n        var formName = \"月报异常记录\";\r\n        //控件值键对\r\n        var filterParamList = new Packages.java.util.ArrayList();\r\n        var filterParam1 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"关联月报\", \"eq\", user);\r\n        filterParamList.add(filterParam1);\r\n        var docS = $.form.getDocumentsByFilterParam(applicationId, formName, filterParamList);\r\n        var receiveUserIds = $.context.getCurrentUserId();\r\n        //发送站内信\r\n        $.message.sendGeneralStationMessage(\"a\",docS, receiveUserIds);\r\n\r\n\r\n})()","createTime":1765854149000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"a8110e148b3944a98b8ecba03b2a2d54","id":"d7051ba19d7d4701aca6cfafa03159e2","modelCode":"","modelId":"c0d48fbc76ea4414b41afbb3415942a4","modelType":"PC_BUSINESS_DESIGN","namespace":"q","path":"月报异常记录列表","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1765854149000,"versions":0.0}