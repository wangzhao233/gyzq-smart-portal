{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"中交路南-出差考勤管理","content":"(function () {\r\n    var response = getdaydate();\r\n    var applicationId = $.context.getCurrentApplicationId();\r\n    var res = $.json.stringToJsonObject(response);\r\n    if (res.get(\"errcode\") == \"42001\") {\r\n        //如果token过期了\r\n        gettoken();\r\n        var response = getdaydate();\r\n        var res = $.json.stringToJsonObject(response);\r\n    }\r\n    var dates = res.get(\"datas\");\r\n    if (dates != null && dates.size() > 0) {\r\n        for (var j = 0; j < dates.size(); j++) {\r\n            var base_info = dates.get(j).get(\"base_info\");\r\n            var summary_info = dates.get(j).get(\"summary_info\");\r\n            var exception_infos = dates.get(j).get(\"exception_infos\");\r\n\r\n            var adddoc = $.form.createEmptyDocument(applicationId, \"考勤日报\");\r\n            adddoc.addElement(\"账号\", base_info.get(\"acctid\"))\r\n            adddoc.addElement(\"姓名\", base_info.get(\"name\"))\r\n            adddoc.addElement(\"日期\", base_info.get(\"date\") * 1000)\r\n            adddoc.addElement(\"部门\", base_info.get(\"departs_name\"))\r\n            adddoc.addElement(\"日报类型\", (parseInt(base_info.get(\"day_type\")) + 1).toString())\r\n            adddoc.addElement(\"打卡次数\", summary_info.get(\"checkin_count\"))\r\n            adddoc.addElement(\"实际工作时长\", summary_info.get(\"regular_work_sec\") / 3600)\r\n            adddoc.addElement(\"标准工作时长\", summary_info.get(\"standard_work_sec\") / 3600)\r\n            adddoc.addElement(\"最早\", $.date.dateToString($.date.timestampToDate((base_info.get(\"date\") * 1000) + (summary_info.get(\"earliest_time\") * 1000)), \"HH:mm:ss\"));\r\n            adddoc.addElement(\"最晚\", $.date.dateToString($.date.timestampToDate((base_info.get(\"date\") * 1000) + (summary_info.get(\"lastest_time\") * 1000)), \"HH:mm:ss\"));\r\n            if (exception_infos != null && exception_infos.size() > 0) {\r\n                for (var j1 = 0; j1 < exception_infos.size(); j1++) {\r\n                    var adddoc1 = $.form.createEmptyDocument(applicationId, \"日报异常记录\");\r\n                    adddoc1.addElement(\"关联日报\", adddoc.getId())\r\n                    adddoc1.addElement(\"异常类型\", exception_infos.get(j1).get(\"exception\").toString())\r\n                    adddoc1.addElement(\"异常次数\", exception_infos.get(j1).get(\"count\"))\r\n                    adddoc1.addElement(\"异常时长\", exception_infos.get(j1).get(\"duration\") / 3600)\r\n                    $.form.saveFormDocument(adddoc1, applicationId)\r\n                }\r\n            }\r\n\r\n            if (exception_infos != null && exception_infos.size() > 0) {\r\n                adddoc.addElement(\"状态\", \"2\");\r\n                adddoc.addElement(\"申诉状态\", \"1\");\r\n                $.form.saveFormDocument(adddoc, applicationId)\r\n\r\n            } else {\r\n                adddoc.addElement(\"状态\", \"1\")\r\n                adddoc.addElement(\"申诉状态\", \"2\");\r\n                $.form.saveFormDocument(adddoc, applicationId)\r\n            }\r\n            $.form.saveFormDocument(adddoc, applicationId)\r\n\r\n\r\n        }\r\n    }\r\n\r\n})()\r\nfunction getdaydate() {\r\n    /*当前应用id */\r\n    var appId = $.context.getCurrentApplicationId();\r\n    /*获取日报的开始时间和结束时间 */\r\n    var date = $.date.getCurrentDate();//获取当前日期\r\n    var startTime = Packages.java.util.Calendar.getInstance();\r\n    startTime.setTime(date);\r\n    startTime.add(Packages.java.util.Calendar.DATE, -1);\r\n    var start = startTime.getTime();//得到经过控制后的日期\r\n    var startStr = $.date.dateToString(start, \"yyyy-MM-dd\");\r\n    var startDate = $.date.stringToDate(startStr, \"yyyy-MM-dd\");\r\n    var sTime = startDate.getTime() / 1000;\r\n    $.message.sendGeneralStationMessage(\"sTime\", sTime, $.context.getCurrentUserId());\r\n\r\n    var endTime = Packages.java.util.Calendar.getInstance();\r\n    endTime.setTime(date);\r\n    endTime.add(Packages.java.util.Calendar.DATE, 1);\r\n    var end = endTime.getTime();//得到经过控制后的日期\r\n    var endStr = $.date.dateToString(end, \"yyyy-MM-dd\");\r\n    var endDate = $.date.stringToDate(endStr, \"yyyy-MM-dd\");\r\n    var eTime = endDate.getTime() / 1000;\r\n    $.message.sendGeneralStationMessage(\"eTime\", eTime, $.context.getCurrentUserId());\r\n\r\n    /*获取员工信息表的所有员工账号集合 */\r\n    var accountList = new Packages.java.util.ArrayList();\r\n    var userMap = new Packages.java.util.HashMap();\r\n    var userDocsList = $.form.getFormDocumentsByFieldNameAndValue(appId, \"员工信息维护\", userMap);\r\n    // var sizenum = userDocsList.size();//170\r\n    var num = Math.ceil(userDocsList.size() / 100)//2\r\n\r\n    for (var s = 0; s < num; s++) {\r\n        var a = s * 100;\r\n        var b = (s + 1) * 100;\r\n        if (s == Number(num) - 1) {\r\n            var b = userDocsList.size() - a;\r\n        }\r\n\r\n        if (userDocsList != null && b > 0) {\r\n            for (var f = a; f < b; f++) {\r\n                var userId = userDocsList.get(f).getElementByName(\"姓名\").getValue();\r\n                var user = $.contact.getUserById(userId);\r\n                if (user != null) {\r\n                    var account = user.getAccount().toString();\r\n                    if (accountList.contains(account) == false) {\r\n                        accountList.add(account);\r\n                    }\r\n                }\r\n            }\r\n        }\r\n        /* 获取token*/\r\n\r\n        var corpid = \"ww221c0bad06436cb9\";//企业id\r\n        var secret = \"dUJ_BzUJIhFxubMuBsLFy_jjSaLXsRqANNwySpYgRSs\";//打卡应用密钥\r\n        var url = \"https://qyapi.weixin.qq.com/cgi-bin/gettoken\";\r\n        var params = new Packages.java.util.HashMap();\r\n        params.put(\"corpid\", corpid);\r\n        params.put(\"corpsecret\", secret);\r\n        var headers = new Packages.java.util.HashMap();\r\n        headers.put(\"Content-Type\", \"application/json;charset=UTF-8\");\r\n        var response = $.httpclient.sendGet(url, params, headers);\r\n        var res = $.json.stringToJsonObject(response);\r\n        var token = res.get(\"access_token\");\r\n\r\n\r\n\r\n        /*获取日报 */\r\n        var dayUrl = \"https://qyapi.weixin.qq.com/cgi-bin/checkin/getcheckin_daydata\";\r\n        var dayParams = new Packages.java.util.HashMap();\r\n        dayParams.put(\"access_token\", token);\r\n        var dayHeaders = new Packages.java.util.HashMap();\r\n        dayHeaders.put(\"Content-Type\", \"application/json;charset=UTF-8\");\r\n        var json = {\r\n            \"starttime\": sTime,\r\n            \"endtime\": eTime,\r\n            \"useridlist\": accountList\r\n        }\r\n\r\n\r\n    }\r\n    var jsonStr = $.json.objectToJsonString(json);\r\n    $.message.sendGeneralStationMessage(\"jsonStr\", jsonStr, $.context.getCurrentUserId());\r\n    var dayResponse = $.httpclient.sendPost(dayUrl, dayParams, dayHeaders, jsonStr);\r\n    $.message.sendGeneralStationMessage(\"dayResponse\", dayResponse, $.context.getCurrentUserId());\r\n    return dayResponse;\r\n}","createTime":1765854149000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"21e140d34959455592a4512401bea978","id":"d9900c0fe8644f5aa72cf0a8f9956a19","modelCode":"","modelId":"d6313f4400d64704a89c87d0676df851","modelType":"SCHEDULER_DESIGN","namespace":"获取日报","path":"获取企业微信日报接口","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1768446230087,"versions":0.0}