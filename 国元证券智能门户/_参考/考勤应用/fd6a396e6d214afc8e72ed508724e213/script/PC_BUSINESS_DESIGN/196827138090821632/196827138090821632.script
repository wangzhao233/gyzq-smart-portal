{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"考勤管理","content":"(function(){\r\n    // 1. 获取当前应用ID和用户信息\r\n    var applicationId = $.context.getCurrentApplicationId();\r\n    var currentUser = $.context.getCurrentUser();\r\n    var currentUserId = $.context.getCurrentUserId();\r\n\r\n    // 发送处理开始通知\r\n    var subject = \"员工年假更新脚本开始执行\";\r\n    var context = \"脚本开始处理员工年假信息更新\\n当前操作用户：\" + ($.json.objectToJsonString(currentUser) || \"未知用户\");\r\n    $.message.sendGeneralStationMessage(subject, context, currentUserId);\r\n\r\n    $.log.info(\"=== 开始执行人员年假更新脚本 (每日凌晨版) ===\");\r\n    $.log.info(\"当前应用ID: \" + applicationId);\r\n    $.log.info(\"当前时间: \" + new Date().toString());\r\n\r\n    // 2. 定义表单和字段名称\r\n    var formName = \"员工信息维护\";\r\n    $.log.info(\"目标表单: \" + formName);\r\n\r\n    // 字段名定义\r\n    var accountField = \"账号\";\r\n    var joinDateField = \"参加工作日期\";\r\n    var workYearsField = \"工作年限\";\r\n    var annualLeaveTotalField = \"可休年假\";      // 根据工龄计算的总额度\r\n    var annualLeaveUsedField = \"已休年假\";       // 【修改点】直接从本表读取，不再查请假表\r\n    var annualLeaveBalanceField = \"剩余年假\";    // 可休 - 已休\r\n\r\n    try {\r\n        // 3. 获取所有员工信息\r\n        $.log.info(\"开始查询员工信息...\");\r\n        var conditionMap = new Packages.java.util.HashMap();\r\n        var employeeList = $.form.getDocumentsByCondition(applicationId, formName, conditionMap);\r\n    \r\n        if (employeeList == null || employeeList.isEmpty()) {\r\n            $.log.warn(\"未找到员工信息记录\");\r\n            $.message.sendGeneralStationMessage(\"员工年假更新结果\", \"未找到员工信息记录\", currentUserId);\r\n            return {\r\n                success: false,\r\n                message: \"未找到员工信息记录\",\r\n                updatedCount: 0,\r\n                totalCount: 0\r\n            };\r\n        }\r\n    \r\n        var totalCount = employeeList.size();\r\n        $.log.info(\"共找到 \" + totalCount + \" 条员工记录\");\r\n    \r\n        var updatedCount = 0;\r\n        var skippedCount = 0;\r\n        var errorCount = 0;\r\n    \r\n        // 4. 批量处理员工年假信息\r\n        for (var i = 0; i < employeeList.size(); i++) {\r\n            var account = \"\";\r\n            var employeeProcessed = false;\r\n        \r\n            try {\r\n                var employeeDoc = employeeList.get(i);\r\n                var employeeId = employeeDoc.getId();\r\n            \r\n                // 获取员工账号\r\n                var accountElement = employeeDoc.getElementByName(accountField);\r\n                account = accountElement ? accountElement.getValue() : \"\";\r\n            \r\n                if (!account) {\r\n                    $.log.warn(\"记录ID：\" + employeeId + \" 缺少账号信息，跳过\");\r\n                    errorCount++;\r\n                    continue;\r\n                }\r\n            \r\n                // 获取参加工作日期\r\n                var joinDateElement = employeeDoc.getElementByName(joinDateField);\r\n                if (!joinDateElement) {\r\n                    $.log.warn(\"员工账号：\" + account + \" 缺少参加工作日期，跳过\");\r\n                    errorCount++;\r\n                    continue;\r\n                }\r\n            \r\n                var joinDateValue = joinDateElement.getValue();\r\n            \r\n                // 处理空日期情况\r\n                if (!joinDateValue || joinDateValue === null || joinDateValue === undefined || joinDateValue === \"\") {\r\n                    $.log.warn(\"员工账号：\" + account + \" 参加工作日期为空，设置为当前日期\");\r\n                    joinDateValue = new Date().getTime();\r\n                    $.log.info(\"员工账号：\" + account + \" 已设置默认工作日期：\" + new Date(joinDateValue).toISOString());\r\n                }\r\n            \r\n                // 处理日期字段值\r\n                var joinDate;\r\n                try {\r\n                    if (typeof joinDateValue === 'object') {\r\n                        try {\r\n                            var objStr = $.json.objectToJsonString(joinDateValue);\r\n                            if (joinDateValue.getTime && typeof joinDateValue.getTime === 'function') {\r\n                                joinDate = new Date(joinDateValue.getTime());\r\n                            } else if (joinDateValue.timestamp) {\r\n                                joinDate = new Date(joinDateValue.timestamp);\r\n                            } else if (joinDateValue.value) {\r\n                                var value = joinDateValue.value;\r\n                                if (typeof value === 'number') {\r\n                                    joinDate = new Date(value);\r\n                                } else if (typeof value === 'string' && !isNaN(parseInt(value))) {\r\n                                    joinDate = new Date(parseInt(value));\r\n                                }\r\n                            } else {\r\n                                var matchResult = objStr.match(/\\b\\d{13}\\b/);\r\n                                if (matchResult) {\r\n                                    joinDate = new Date(parseInt(matchResult[0]));\r\n                                }\r\n                            }\r\n                        } catch (jsonError) {\r\n                            $.log.warn(\"员工账号：\" + account + \" JSON序列化失败：\" + jsonError.message);\r\n                        }\r\n                    } else if (typeof joinDateValue === 'number') {\r\n                        joinDate = new Date(joinDateValue);\r\n                    } else if (typeof joinDateValue === 'string') {\r\n                        if (!isNaN(joinDateValue) && joinDateValue.length >= 10) {\r\n                            joinDate = new Date(parseInt(joinDateValue));\r\n                        } else {\r\n                            joinDate = new Date(joinDateValue);\r\n                        }\r\n                    } else if (joinDateValue instanceof Date) {\r\n                        joinDate = joinDateValue;\r\n                    }\r\n                \r\n                    if (!joinDate || isNaN(joinDate.getTime())) {\r\n                        $.log.warn(\"员工账号：\" + account + \" 无法识别的工作日期格式，使用当前日期\");\r\n                        joinDate = new Date();\r\n                    }\r\n                \r\n                } catch (dateError) {\r\n                    $.log.error(\"员工账号：\" + account + \" 日期转换失败：\" + dateError.message);\r\n                    errorCount++;\r\n                    continue;\r\n                }\r\n            \r\n                $.log.info(\"员工账号：\" + account + \" 解析后工作日期：\" + joinDate.toISOString());\r\n            \r\n                // --- 核心计算逻辑 ---\r\n                \r\n                // 1. 计算工作年限\r\n                var currentDate = new Date();\r\n                var workYears = calculateWorkYears(joinDate, currentDate);\r\n            \r\n                // 2. 计算可休年假总额 (根据工龄规则)\r\n                var annualLeaveTotal = calculateAnnualLeave(joinDate, currentDate, workYears);\r\n            \r\n                // 3. 【修改点】获取已休年假：直接从当前文档读取，不再查询请假表\r\n                var annualLeaveUsed = 0;\r\n                var usedElem = employeeDoc.getElementByName(annualLeaveUsedField);\r\n                if (usedElem) {\r\n                    var usedVal = usedElem.getValue();\r\n                    if (usedVal !== null && usedVal !== undefined) {\r\n                        annualLeaveUsed = parseFloat(usedVal) || 0;\r\n                    }\r\n                }\r\n                $.log.info(\"员工 \" + account + \" 从本表读取已休年假：\" + annualLeaveUsed);\r\n            \r\n                // 4. 计算剩余年假 = 可休总额 - 已休\r\n                var annualLeaveBalance = annualLeaveTotal - annualLeaveUsed;\r\n                if (annualLeaveBalance < 0) {\r\n                    annualLeaveBalance = 0;\r\n                    $.log.warn(\"员工 \" + account + \" 已休年假超过可休额度，剩余年假强制设为0\");\r\n                }\r\n            \r\n                // ==================== 输出计算值的日志 ====================\r\n                $.log.info(\"=== 员工 \" + account + \" 计算结果 ===\");\r\n                $.log.info(\"参加工作日期: \" + formatDate(joinDate));\r\n                $.log.info(\"工作年限: \" + workYears.toFixed(2) + \" 年\");\r\n                $.log.info(\"可休年假(总额): \" + annualLeaveTotal + \" 天\");\r\n                $.log.info(\"已休年假(本表): \" + annualLeaveUsed + \" 天\");\r\n                $.log.info(\"剩余年假(结果): \" + annualLeaveBalance + \" 天\");\r\n                // ============================================================\r\n            \r\n                // 获取当前字段值用于比较，避免不必要的更新\r\n                var currentWorkYearsElem = employeeDoc.getElementByName(workYearsField);\r\n                var currentAnnualLeaveTotalElem = employeeDoc.getElementByName(annualLeaveTotalField);\r\n                var currentAnnualLeaveUsedElem = employeeDoc.getElementByName(annualLeaveUsedField);\r\n                var currentAnnualLeaveBalanceElem = employeeDoc.getElementByName(annualLeaveBalanceField);\r\n            \r\n                var currentWorkYears = 0;\r\n                var currentAnnualLeaveTotal = 0;\r\n                var currentAnnualLeaveUsed = 0;\r\n                var currentAnnualLeaveBalance = 0;\r\n            \r\n                if (currentWorkYearsElem) {\r\n                    var val = currentWorkYearsElem.getValue();\r\n                    currentWorkYears = parseFloat(val) || 0;\r\n                }\r\n                if (currentAnnualLeaveTotalElem) {\r\n                    var val = currentAnnualLeaveTotalElem.getValue();\r\n                    currentAnnualLeaveTotal = parseInt(val) || 0;\r\n                }\r\n                if (currentAnnualLeaveUsedElem) {\r\n                    var val = currentAnnualLeaveUsedElem.getValue();\r\n                    currentAnnualLeaveUsed = parseFloat(val) || 0;\r\n                }\r\n                if (currentAnnualLeaveBalanceElem) {\r\n                    var val = currentAnnualLeaveBalanceElem.getValue();\r\n                    currentAnnualLeaveBalance = parseInt(val) || 0;\r\n                }\r\n            \r\n                // 检查是否需要更新\r\n                var needsUpdate = false;\r\n                var reasons = [];\r\n            \r\n                // 注意：由于已休年假是外部流程写入的，如果只比较计算值，可能不会触发更新\r\n                // 这里主要比较：工作年限变化、可休年假总额变化、剩余年假变化\r\n                // 如果\"已休年假\"字段被外部流程更新了，但本脚本运行时\"剩余年假\"没变（比如总额也变了抵消了），通常不需要特殊处理\r\n                // 但如果\"已休年假\"变了，\"剩余年假\"必然变，所以只要比较剩余年假即可覆盖大部分情况\r\n                \r\n                if (Math.abs(currentWorkYears - workYears) > 0.01) {\r\n                    needsUpdate = true;\r\n                    reasons.push(\"工作年限变化：\" + currentWorkYears + \" -> \" + workYears.toFixed(2));\r\n                }\r\n            \r\n                if (currentAnnualLeaveTotal !== annualLeaveTotal) {\r\n                    needsUpdate = true;\r\n                    reasons.push(\"可休年假变化：\" + currentAnnualLeaveTotal + \" -> \" + annualLeaveTotal);\r\n                }\r\n            \r\n                // 重点：如果已休年假字段在数据库中被其他流程修改了，导致计算出的剩余年假与当前存储的剩余年假不一致，则必须更新\r\n                if (currentAnnualLeaveBalance !== annualLeaveBalance) {\r\n                    needsUpdate = true;\r\n                    reasons.push(\"剩余年假变化：\" + currentAnnualLeaveBalance + \" -> \" + annualLeaveBalance + \" (可能因已休年假变动引起)\");\r\n                }\r\n            \r\n                if (needsUpdate) {\r\n                    $.log.info(\"员工 \" + account + \" 需要更新，原因：\" + reasons.join(\"; \"));\r\n                \r\n                    // 更新员工文档的字段值\r\n                    employeeDoc.addElement(workYearsField, parseFloat(workYears.toFixed(2)));\r\n                    employeeDoc.addElement(annualLeaveTotalField, annualLeaveTotal);\r\n                    // 注意：这里不更新 annualLeaveUsedField，因为它是源头数据，由请假流程写入\r\n                    employeeDoc.addElement(annualLeaveBalanceField, annualLeaveBalance);\r\n                \r\n                    // 保存更新\r\n                    try {\r\n                        $.form.saveFormDocument(employeeDoc, applicationId);\r\n                        $.log.info(\"员工 \" + account + \" 年假信息已更新成功\");\r\n                        updatedCount++;\r\n                        employeeProcessed = true;\r\n                    } catch (saveError) {\r\n                        var errorMsg = saveError.message || \"保存失败\";\r\n                        if (errorMsg.includes(\"已提交成功\") && errorMsg.includes(\"请勿重复操作\")) {\r\n                            $.log.info(\"员工 \" + account + \" 的数据已被成功提交，无需重复操作\");\r\n                            skippedCount++;\r\n                        } else {\r\n                            $.log.error(\"保存员工 \" + account + \" 数据失败：\" + errorMsg);\r\n                            errorCount++;\r\n                        }\r\n                    }\r\n                } else {\r\n                    $.log.info(\"员工 \" + account + \" 数据无变化，跳过更新\");\r\n                    skippedCount++;\r\n                }\r\n            \r\n            } catch (employeeError) {\r\n                if (!employeeProcessed) {\r\n                    errorCount++;\r\n                }\r\n                $.log.error(\"处理员工记录失败（账号：\" + account + \"）：\" + (employeeError.message || \"未知错误\"));\r\n                try {\r\n                    var errorMsg = $.json.objectToJsonString(employeeError);\r\n                    $.log.error(\"详细错误信息：\" + errorMsg);\r\n                } catch (e) {}\r\n            }\r\n        \r\n            // 进度日志\r\n            if ((i + 1) % 100 === 0) {\r\n                $.log.info(\"处理进度：\" + (i + 1) + \"/\" + totalCount + \"，成功：\" + updatedCount + \"，跳过：\" + skippedCount + \"，失败：\" + errorCount);\r\n            }\r\n        }\r\n    \r\n        // 5. 执行结果统计\r\n        $.log.info(\"=== 脚本执行完成 ===\");\r\n        $.log.info(\"统计结果：总记录:\" + totalCount + \", 成功:\" + updatedCount + \", 跳过:\" + skippedCount + \", 失败:\" + errorCount);\r\n    \r\n        // 6. 发送完成通知\r\n        var completionMessage = \"员工年假更新脚本执行完成\\n\" +\r\n                              \"总记录数：\" + totalCount + \"\\n\" +\r\n                              \"成功更新：\" + updatedCount + \"\\n\" +\r\n                              \"跳过处理：\" + skippedCount + \"\\n\" +\r\n                              \"处理失败：\" + errorCount;\r\n    \r\n        $.message.sendGeneralStationMessage(\"员工年假更新完成\", completionMessage, currentUserId);\r\n    \r\n        return {\r\n            success: true,\r\n            message: \"脚本执行完成\",\r\n            data: {\r\n                totalCount: totalCount,\r\n                updatedCount: updatedCount,\r\n                skippedCount: skippedCount,\r\n                errorCount: errorCount,\r\n                executionTime: new Date().toISOString(),\r\n                operator: currentUserId\r\n            }\r\n        };\r\n    \r\n    } catch (globalError) {\r\n        $.log.error(\"脚本执行失败：\" + globalError.message);\r\n        var errorMessage = \"员工年假更新脚本执行失败\\n错误信息：\" + globalError.message;\r\n        $.message.sendGeneralStationMessage(\"员工年假更新脚本错误\", errorMessage, currentUserId);\r\n        return {\r\n            success: false,\r\n            message: \"脚本执行失败：\" + globalError.message,\r\n            error: globalError.message\r\n        };\r\n    }\r\n\r\n    // ========== 辅助函数定义 (保持不变) ==========\r\n\r\n    function calculateWorkYears(joinDate, currentDate) {\r\n        if (!joinDate || !(joinDate instanceof Date) || isNaN(joinDate.getTime())) return 0;\r\n        if (!currentDate || !(currentDate instanceof Date) || isNaN(currentDate.getTime())) currentDate = new Date();\r\n    \r\n        var yearsDiff = currentDate.getFullYear() - joinDate.getFullYear();\r\n        var monthsDiff = currentDate.getMonth() - joinDate.getMonth();\r\n        var daysDiff = currentDate.getDate() - joinDate.getDate();\r\n    \r\n        if (monthsDiff < 0 || (monthsDiff === 0 && daysDiff < 0)) {\r\n            yearsDiff--;\r\n            monthsDiff += 12;\r\n        }\r\n    \r\n        var exactMonths = yearsDiff * 12 + monthsDiff;\r\n        var totalMonths = exactMonths + (daysDiff / 30.0);\r\n        var workYears = totalMonths / 12;\r\n    \r\n        return Math.round(workYears * 100) / 100;\r\n    }\r\n\r\n    function calculateAnnualLeave(joinDate, currentDate, workYears) {\r\n        if (!joinDate || !(joinDate instanceof Date) || isNaN(joinDate.getTime())) return 0;\r\n        if (!currentDate || !(currentDate instanceof Date) || isNaN(currentDate.getTime())) currentDate = new Date();\r\n    \r\n        var years = Math.floor(workYears);\r\n        var months = Math.round((workYears - years) * 12);\r\n    \r\n        if (years < 1) {\r\n            return Math.floor(calculateAnnualLeaveForFirstYear(joinDate, currentDate));\r\n        }\r\n    \r\n        var startDateThisYear = new Date(currentDate.getFullYear(), joinDate.getMonth(), joinDate.getDate());\r\n        var nextAnniversary = new Date(currentDate.getFullYear(), joinDate.getMonth(), joinDate.getDate());\r\n    \r\n        if (currentDate < startDateThisYear) {\r\n            nextAnniversary = new Date(currentDate.getFullYear() - 1, joinDate.getMonth(), joinDate.getDate());\r\n        }\r\n    \r\n        var daysSinceAnniversary = Math.floor((currentDate - nextAnniversary) / (1000 * 60 * 60 * 24));\r\n        var yearsSinceJoin = currentDate.getFullYear() - joinDate.getFullYear();\r\n    \r\n        if (currentDate.getMonth() < joinDate.getMonth() || \r\n            (currentDate.getMonth() === joinDate.getMonth() && currentDate.getDate() < joinDate.getDate())) {\r\n            yearsSinceJoin--;\r\n        }\r\n    \r\n        var isTenthYear = (yearsSinceJoin === 9 && daysSinceAnniversary >= 0);\r\n        var isTwentiethYear = (yearsSinceJoin === 19 && daysSinceAnniversary >= 0);\r\n    \r\n        if (isTenthYear) return Math.floor(calculateAnnualLeaveForTenthYear(joinDate, currentDate));\r\n        if (isTwentiethYear) return Math.floor(calculateAnnualLeaveForTwentiethYear(joinDate, currentDate));\r\n    \r\n        if (years >= 1 && years < 10) return 5;\r\n        if (years >= 10 && years < 20) return 10;\r\n        if (years >= 20) return 15;\r\n    \r\n        return 0;\r\n    }\r\n\r\n    function calculateAnnualLeaveForFirstYear(joinDate, currentDate) {\r\n        var annualLeaveForFullYear = 5;\r\n        var yearEnd = new Date(currentDate.getFullYear(), 11, 31);\r\n        var remainingDays = Math.ceil((yearEnd - joinDate) / (1000 * 60 * 60 * 24)) + 1;\r\n    \r\n        if (joinDate.getFullYear() > currentDate.getFullYear()) {\r\n            remainingDays = Math.ceil((yearEnd - joinDate) / (1000 * 60 * 60 * 24)) + 1;\r\n        }\r\n        if (joinDate > currentDate) return 0;\r\n        if (joinDate.getFullYear() === currentDate.getFullYear() && joinDate <= currentDate) {\r\n            remainingDays = Math.ceil((yearEnd - joinDate) / (1000 * 60 * 60 * 24)) + 1;\r\n        }\r\n    \r\n        if (remainingDays < 0) remainingDays = 0;\r\n        if (remainingDays > 365) remainingDays = 365;\r\n    \r\n        return (remainingDays / 365) * annualLeaveForFullYear;\r\n    }\r\n\r\n    function calculateAnnualLeaveForTenthYear(joinDate, currentDate) {\r\n        var tenthAnniversary = new Date(joinDate.getFullYear() + 10, joinDate.getMonth(), joinDate.getDate());\r\n        if (currentDate < tenthAnniversary) return 5;\r\n    \r\n        var yearEnd = new Date(currentDate.getFullYear(), 11, 31);\r\n        var remainingDays = Math.ceil((yearEnd - tenthAnniversary) / (1000 * 60 * 60 * 24)) + 1;\r\n        if (remainingDays < 0) remainingDays = 0;\r\n    \r\n        return (remainingDays / 365) * 5 + 5;\r\n    }\r\n\r\n    function calculateAnnualLeaveForTwentiethYear(joinDate, currentDate) {\r\n        var twentiethAnniversary = new Date(joinDate.getFullYear() + 20, joinDate.getMonth(), joinDate.getDate());\r\n        if (currentDate < twentiethAnniversary) return 10;\r\n    \r\n        var yearEnd = new Date(currentDate.getFullYear(), 11, 31);\r\n        var remainingDays = Math.ceil((yearEnd - twentiethAnniversary) / (1000 * 60 * 60 * 24)) + 1;\r\n        if (remainingDays < 0) remainingDays = 0;\r\n    \r\n        return (remainingDays / 365) * 5 + 10;\r\n    }\r\n\r\n    function formatDate(date) {\r\n        if (!date || !(date instanceof Date) || isNaN(date.getTime())) return \"无效日期\";\r\n        var year = date.getFullYear();\r\n        var month = (date.getMonth() + 1).toString();\r\n        var day = date.getDate().toString();\r\n        var hours = date.getHours().toString();\r\n        var minutes = date.getMinutes().toString();\r\n        var seconds = date.getSeconds().toString();\r\n        var padZero = function(numStr) { return numStr.length < 2 ? '0' + numStr : numStr; };\r\n        return year + \"-\" + padZero(month) + \"-\" + padZero(day) + \" \" + \r\n               padZero(hours) + \":\" + padZero(minutes) + \":\" + padZero(seconds);\r\n    }\r\n})();","createTime":1773213557000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"f5ad2b9713fa44f6adf60b68b642c5a3","id":"196827138090821632","modelCode":"","modelId":"d37b5bf2704b4b3996edbbfdfbeaee74","modelType":"PC_BUSINESS_DESIGN","namespace":"处理年假3.0","path":"员工信息","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1776237581058,"versions":0.0}