{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"考勤管理","content":"(function () {\r\n    $.log.info(\"开始执行考勤月报同步任务...\");\r\n    var result = runMonthlySync();\r\n    \r\n    if (result == \"SUCCESS\") {\r\n        $.log.info(\"月报同步完成\");\r\n    } else if (result) {\r\n        try {\r\n            var res = $.json.stringToJsonObject(result);\r\n            if (res.get(\"errcode\") == 42001 || res.get(\"errcode\") == \"42001\") {\r\n                $.log.warn(\"Token 失效，重新获取后重试...\");\r\n                gettoken(); \r\n                result = runMonthlySync();\r\n            }\r\n        } catch (e) {\r\n            $.log.error(\"解析返回结果出错: \" + e);\r\n        }\r\n    }\r\n})();\r\n\r\nfunction runMonthlySync() {\r\n    var appId = $.context.getCurrentApplicationId();\r\n    \r\n    // 1. 计算时间范围\r\n    var now = $.date.getCurrentDate();\r\n    var nowYear = now.getYear() + 1900;\r\n    var nowMonth = now.getMonth() - 1; \r\n    \r\n    var mongthdays = getMonthDays(nowYear, nowMonth);\r\n    var monthstartdate = getMonthStartDate(nowYear, nowMonth);\r\n    var monthEndDate = getMonthEndDate(nowYear, nowMonth, mongthdays + 22); \r\n\r\n    var startMs = monthstartdate.getTime();\r\n    var endMs = monthEndDate.getTime();\r\n    var startSec = startMs / 1000;\r\n    var endSec = endMs / 1000;\r\n\r\n    // 【修复点1】构造统计月份字符串 (例如：2026-03)\r\n    // 注意：nowMonth 是 0-11，显示时需要 +1\r\n    var displayMonth = (nowMonth + 1);\r\n    var monthStr = nowYear + \"-\" + (displayMonth < 10 ? \"0\" + displayMonth : displayMonth);\r\n\r\n    $.log.info(\"统计月份标识: \" + monthStr);\r\n    $.log.info(\"时间范围: \" + $.date.dateToString(monthstartdate, \"yyyy-MM-dd\") + \" 至 \" + $.date.dateToString(monthEndDate, \"yyyy-MM-dd\"));\r\n\r\n    // 2. 获取员工账号\r\n    var accountList = new Packages.java.util.ArrayList();\r\n    var userMap = new Packages.java.util.HashMap();\r\n    var userDocsList = $.form.getFormDocumentsByFieldNameAndValue(appId, \"员工信息维护\", userMap);\r\n    \r\n    if (userDocsList == null || userDocsList.size() == 0) {\r\n        $.log.error(\"未找到员工信息维护表数据\");\r\n        return \"ERROR_NO_USERS\";\r\n    }\r\n\r\n    for (var f = 0; f < userDocsList.size(); f++) {\r\n        try {\r\n            var doc = userDocsList.get(f);\r\n            var accountElem = doc.getElementByName(\"账号\");\r\n            var account = \"\";\r\n            \r\n            if (accountElem != null && accountElem.getValue() != null) {\r\n                account = accountElem.getValue().toString().trim();\r\n            } \r\n            \r\n            if (account == \"\") {\r\n                var nameElem = doc.getElementByName(\"姓名\");\r\n                if (nameElem != null && nameElem.getValue() != null) {\r\n                    var name = nameElem.getValue().toString().trim();\r\n                    var users = $.contact.listUserByKeyword(name);\r\n                    if (users != null && users.size() > 0) {\r\n                        account = users.get(0).getAccount();\r\n                    }\r\n                }\r\n            }\r\n\r\n            if (account != \"\" && !accountList.contains(account)) {\r\n                accountList.add(account);\r\n            }\r\n        } catch (e) {\r\n            $.log.error(\"处理员工失败: \" + e);\r\n        }\r\n    }\r\n\r\n    if (accountList.size() == 0) {\r\n        $.log.warn(\"没有获取到任何有效账号\");\r\n        return \"SUCCESS\";\r\n    }\r\n\r\n    // 3. 获取 Token\r\n    var token = getToken();\r\n    if (!token) return \"ERROR_GET_TOKEN\";\r\n\r\n    // 4. 分批请求\r\n    var batchSize = 100;\r\n    var totalBatches = Math.ceil(accountList.size() / batchSize);\r\n    var monthUrl = \"https://qyapi.weixin.qq.com/cgi-bin/checkin/getcheckin_monthdata\";\r\n    var monthParams = new Packages.java.util.HashMap();\r\n    monthParams.put(\"access_token\", token);\r\n    var monthHeaders = new Packages.java.util.HashMap();\r\n    monthHeaders.put(\"Content-Type\", \"application/json;charset=UTF-8\");\r\n\r\n    for (var i = 0; i < totalBatches; i++) {\r\n        var startIdx = i * batchSize;\r\n        var endIdx = Math.min((i + 1) * batchSize, accountList.size());\r\n        \r\n        var currentBatchList = new Packages.java.util.ArrayList();\r\n        for (var k = startIdx; k < endIdx; k++) {\r\n            currentBatchList.add(accountList.get(k));\r\n        }\r\n\r\n        var json = {\r\n            \"starttime\": startSec,\r\n            \"endtime\": endSec,\r\n            \"useridlist\": currentBatchList\r\n        };\r\n\r\n        var jsonStr = $.json.objectToJsonString(json);\r\n        var response = $.httpclient.sendPost(monthUrl, monthParams, monthHeaders, jsonStr);\r\n        var batchRes = $.json.stringToJsonObject(response);\r\n\r\n        if (batchRes.get(\"errcode\") == 0) {\r\n            var dates = batchRes.get(\"datas\");\r\n            if (dates != null && dates.size() > 0) {\r\n                // 传入 monthStr 用于写入主表\r\n                saveMonthData(dates, appId, startMs, endMs, monthStr);\r\n                $.log.info(\"第 \" + (i + 1) + \" 批保存完成，条数: \" + dates.size());\r\n            }\r\n        } else {\r\n            $.log.error(\"第 \" + (i + 1) + \" 批请求失败: \" + batchRes.get(\"errmsg\"));\r\n        }\r\n    }\r\n\r\n    return \"SUCCESS\";\r\n}\r\n\r\nfunction getToken() {\r\n    var corpid = \"ww221c0bad06436cb9\";\r\n    var secret = \"dUJ_BzUJIhFxubMuBsLFy_jjSaLXsRqANNwySpYgRSs\";\r\n    var url = \"https://qyapi.weixin.qq.com/cgi-bin/gettoken\";\r\n    var params = new Packages.java.util.HashMap();\r\n    params.put(\"corpid\", corpid);\r\n    params.put(\"corpsecret\", secret);\r\n    var headers = new Packages.java.util.HashMap();\r\n    headers.put(\"Content-Type\", \"application/json;charset=UTF-8\");\r\n    \r\n    var response = $.httpclient.sendGet(url, params, headers);\r\n    var res = $.json.stringToJsonObject(response);\r\n    return res.get(\"access_token\");\r\n}\r\n\r\nfunction saveMonthData(dates, appId, startMs, endMs, monthStr) {\r\n    for (var j = 0; j < dates.size(); j++) {\r\n        var record = dates.get(j);\r\n        var base_info = record.get(\"base_info\");\r\n        var summary_info = record.get(\"summary_info\");\r\n        var exception_infos = record.get(\"exception_infos\");\r\n        var sp_items = record.get(\"sp_items\");\r\n        var overwork_info = record.get(\"overwork_info\");\r\n\r\n        if (base_info == null) continue;\r\n\r\n        var adddoc = $.form.createEmptyDocument(appId, \"考勤月报\");\r\n        \r\n        // --- 1. 基础信息 ---\r\n        if (base_info.get(\"acctid\") != null) adddoc.addElement(\"账号\", base_info.get(\"acctid\"));\r\n        if (base_info.get(\"name\") != null) adddoc.addElement(\"姓名\", base_info.get(\"name\"));\r\n        if (base_info.get(\"departs_name\") != null) adddoc.addElement(\"部门\", base_info.get(\"departs_name\"));\r\n        \r\n        // 【修复点1】写入统计月份\r\n        adddoc.addElement(\"统计月份\", monthStr);\r\n        \r\n        // 写入时间戳\r\n        adddoc.addElement(\"开始日期\", startMs);\r\n        adddoc.addElement(\"结束日期\", endMs);\r\n\r\n        // 规则组\r\n        var rule_info = base_info.get(\"rule_info\");\r\n        if (rule_info != null && rule_info.get(\"groupname\") != null) {\r\n            adddoc.addElement(\"规则组\", rule_info.get(\"groupname\"));\r\n        }\r\n\r\n        // --- 2. 汇总信息 ---\r\n        if (summary_info != null) {\r\n            if (summary_info.get(\"work_days\") != null) adddoc.addElement(\"应出勤天数\", summary_info.get(\"work_days\"));\r\n            if (summary_info.get(\"regular_days\") != null) adddoc.addElement(\"实际出勤天数\", summary_info.get(\"regular_days\"));\r\n            if (summary_info.get(\"regular_work_sec\") != null) adddoc.addElement(\"实际工作时长\", summary_info.get(\"regular_work_sec\") / 3600);\r\n            if (summary_info.get(\"standard_work_sec\") != null) adddoc.addElement(\"标准工作时长\", summary_info.get(\"standard_work_sec\") / 3600);\r\n        }\r\n\r\n        // --- 3. 加班信息 ---\r\n        if (overwork_info != null) {\r\n            var totalOtSec = 0;\r\n            var wd = overwork_info.get(\"workday_over_sec\") || 0;\r\n            if (overwork_info.get(\"restdays_over_sec\")) totalOtSec += overwork_info.get(\"restdays_over_sec\");\r\n            if (overwork_info.get(\"holidays_over_sec\")) totalOtSec += overwork_info.get(\"holidays_over_sec\");\r\n            totalOtSec += wd;\r\n            \r\n            if (totalOtSec > 0) adddoc.addElement(\"加班总时长\", totalOtSec / 3600);\r\n\r\n            if (overwork_info.get(\"workdays_over_as_vacation\") != null) \r\n                adddoc.addElement(\"工作日加班调休\", overwork_info.get(\"workdays_over_as_vacation\") / 3600);\r\n            if (overwork_info.get(\"workdays_over_as_money\") != null) \r\n                adddoc.addElement(\"工作日加班费\", overwork_info.get(\"workdays_over_as_money\") / 3600);\r\n            if (overwork_info.get(\"restdays_over_as_vacation\") != null) \r\n                adddoc.addElement(\"休息日加班调休\", overwork_info.get(\"restdays_over_as_vacation\") / 3600);\r\n            if (overwork_info.get(\"restdays_over_as_money\") != null) \r\n                adddoc.addElement(\"休息日加班费\", overwork_info.get(\"restdays_over_as_money\") / 3600);\r\n            if (overwork_info.get(\"holidays_over_as_vacation\") != null) \r\n                adddoc.addElement(\"节假日加班调休\", overwork_info.get(\"holidays_over_as_vacation\") / 3600);\r\n            if (overwork_info.get(\"holidays_over_as_money\") != null) \r\n                adddoc.addElement(\"节假日加班费\", overwork_info.get(\"holidays_over_as_money\") / 3600);\r\n        }\r\n\r\n        // --- 【修复点2】异常信息累加逻辑 ---\r\n        // 定义累加变量\r\n        var countLate = 0;      // 迟到\r\n        var countEarly = 0;     // 早退\r\n        var countAbsent = 0;    // 旷工\r\n        var countOtherEx = 0;   // 其他异常\r\n\r\n        if (exception_infos != null && exception_infos.size() > 0) {\r\n            for (var j2 = 0; j2 < exception_infos.size(); j2++) {\r\n                var exItem = exception_infos.get(j2);\r\n                var exType = exItem.get(\"exception\"); // 1:迟到, 2:早退, 3:缺卡, 4:旷工...\r\n                var exCount = exItem.get(\"count\") || 0;\r\n                var exDur = exItem.get(\"duration\") || 0;\r\n\r\n                // 累加到主表变量\r\n                if (exType == 1) countLate += exCount;\r\n                else if (exType == 2) countEarly += exCount;\r\n                else if (exType == 4) countAbsent += exCount;\r\n                else countOtherEx += exCount;\r\n\r\n                // 写入子表\r\n                try {\r\n                    var subExDoc = $.form.createEmptyDocument(appId, \"月报异常记录\");\r\n                    subExDoc.addElement(\"关联月报\", adddoc.getId());\r\n                    subExDoc.addElement(\"异常类型\", (exType != null) ? exType.toString() : \"\"); \r\n                    subExDoc.addElement(\"异常次数\", exCount);\r\n                    subExDoc.addElement(\"异常时长\", exDur / 3600);\r\n                    $.form.saveFormDocument(subExDoc, appId);\r\n                } catch (subErr) {\r\n                    $.log.error(\"保存异常子表失败: \" + subErr);\r\n                }\r\n            }\r\n        }\r\n        \r\n        // 【写入主表数字字段】\r\n        if (countLate > 0) adddoc.addElement(\"迟到次数\", countLate);\r\n        if (countEarly > 0) adddoc.addElement(\"早退次数\", countEarly);\r\n        if (countAbsent > 0) adddoc.addElement(\"旷工次数\", countAbsent);\r\n        // 如果有其他异常字段也可以在这里写入\r\n\r\n        // --- 【修复点2】假勤统计累加逻辑 (出差等) ---\r\n        var countBusinessTrip = 0; // 出差\r\n        var countOut = 0;          // 外出\r\n        var countField = 0;        // 外勤\r\n        var countReissue = 0;      // 补卡\r\n\r\n        if (sp_items != null && sp_items.size() > 0) {\r\n            for (var s = 0; s < sp_items.size(); s++) {\r\n                var item = sp_items.get(s);\r\n                var name = item.get(\"name\");\r\n                var count = item.get(\"count\") || 0;\r\n                var duration = item.get(\"duration\") || 0;\r\n                var timeType = item.get(\"time_type\"); \r\n\r\n                if (count == 0 && duration == 0) continue;\r\n\r\n                var valInHours = (timeType == 0) ? (duration / 86400) : (duration / 3600);\r\n                \r\n                // 累加特定项的次数\r\n                if (\"出差\".equals(name)) countBusinessTrip += count;\r\n                if (\"外出\".equals(name)) countOut += count;\r\n                if (\"外勤次数\".equals(name)) countField += count;\r\n                if (\"补卡次数\".equals(name)) countReissue += count;\r\n\r\n                // 假期时长累加 (用于主表假期字段)\r\n                if (\"年假\".equals(name)) adddoc.addElement(\"年假\", valInHours);\r\n                if (\"事假\".equals(name)) adddoc.addElement(\"事假\", valInHours);\r\n                if (\"病假\".equals(name)) adddoc.addElement(\"病假\", valInHours);\r\n                if (\"调休假\".equals(name)) adddoc.addElement(\"调休假\", valInHours);\r\n                if (\"婚假\".equals(name)) adddoc.addElement(\"婚假\", valInHours);\r\n                if (\"产假\".equals(name)) adddoc.addElement(\"产假\", valInHours);\r\n                if (\"陪产假\".equals(name)) adddoc.addElement(\"陪产假\", valInHours);\r\n                if (\"其他\".equals(name)) adddoc.addElement(\"其他假\", valInHours);\r\n\r\n                // 写入子表\r\n                try {\r\n                    var subDoc = $.form.createEmptyDocument(appId, \"月报假勤统计\");\r\n                    subDoc.addElement(\"关联月报\", adddoc.getId());\r\n                    subDoc.addElement(\"假勤类型\", name);\r\n                    subDoc.addElement(\"次数\", count);\r\n                    subDoc.addElement(\"时长\", valInHours);\r\n                    subDoc.addElement(\"名称\", name);\r\n                    $.form.saveFormDocument(subDoc, appId);\r\n                } catch (subErr) {\r\n                    $.log.error(\"保存假勤子表失败: \" + subErr);\r\n                }\r\n            }\r\n        }\r\n\r\n        // 【写入主表数字字段】\r\n        if (countBusinessTrip > 0) adddoc.addElement(\"出差次数\", countBusinessTrip);\r\n        if (countOut > 0) adddoc.addElement(\"外出次数\", countOut);\r\n        if (countField > 0) adddoc.addElement(\"外勤次数\", countField);\r\n        if (countReissue > 0) adddoc.addElement(\"补卡次数\", countReissue);\r\n\r\n        $.form.saveFormDocument(adddoc, appId);\r\n    }\r\n}\r\n\r\n// --- 辅助函数 ---\r\nfunction getMonthStartDate(nowYear, nowMonth) {\r\n    var monthStartDate0 = new Date(nowYear, nowMonth, 22);\r\n    var format = \"yyyy-MM-dd\";\r\n    var dateStr = $.date.dateToString(monthStartDate0, format);\r\n    return $.date.stringToDate(dateStr, format);\r\n}\r\n\r\nfunction getMonthEndDate(nowYear, nowMonth, mongthdays) {\r\n    var monthEndDate0 = new Date(nowYear, nowMonth, mongthdays);\r\n    var format = \"yyyy-MM-dd\";\r\n    var dateStr = $.date.dateToString(monthEndDate0, format);\r\n    return $.date.stringToDate(dateStr, format);\r\n}\r\n\r\nfunction getMonthDays(nowYear, nowMonth) {\r\n    var endday = new Date(nowYear, nowMonth + 1, 0);\r\n    return endday.getDate();\r\n}","createTime":1773895542000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"8aa00279c9464a09bdf69fc715aaba4c","id":"197559413908660224","modelCode":"","modelId":"a2adf27408904b3e83cff0675b6cee9e","modelType":"PC_BUSINESS_DESIGN","namespace":"月报更新","path":"考勤月报","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1773925830680,"versions":0.0}