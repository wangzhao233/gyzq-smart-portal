{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"考勤管理","content":"(function () {\r\n    // 1. 获取企业所有用户\r\n    var allUsers = $.contact.queryAllUser();\r\n    var applicationId = $.context.getCurrentApplicationId();\r\n    var formName = \"人员信息导入表\";\r\n    \r\n    // 2. 准备数据容器\r\n    var batchData = new Packages.java.util.ArrayList();\r\n    var userIdsForDetails = new Packages.java.util.ArrayList(); // 用于批量查询详情的用户ID列表\r\n    var successCount = 0;\r\n    \r\n    // 3. 首先收集所有用户ID\r\n    for (var i = 0; i < allUsers.size(); i++) {\r\n        try {\r\n            var user = allUsers.get(i);\r\n            var userJson = $.json.objectToJsonObject(user);\r\n            var userId = userJson.get(\"id\");\r\n            if (userId) {\r\n                userIdsForDetails.add(userId);\r\n            }\r\n        } catch (e) {\r\n            $.log.error(\"收集用户ID时出错: \" + e.toString());\r\n        }\r\n    }\r\n    \r\n    // 4. 【关键修改】批量获取用户的完整信息（包含所有所需字段）[5]\r\n    var userDetailsMap = new Packages.java.util.HashMap(); // 用于存储用户ID到完整信息的映射\r\n    if (userIdsForDetails.size() > 0) {\r\n        try {\r\n            // 构建调用OpenAPI批量获取用户信息的参数 [5]\r\n            var batchUserUrl = \"/openapi/contact/users/getUsersByIds\"; // 根据用户ID批量获取用户的接口 [5]\r\n            var params = new Packages.java.util.HashMap();\r\n            params.put(\"userIds\", userIdsForDetails); // 参数为用户ID集合 [5]\r\n            \r\n            var headers = new Packages.java.util.HashMap();\r\n            headers.put(\"Content-Type\", \"application/json;charset=UTF-8\");\r\n            \r\n            // 发送GET请求获取用户详情（参考材料5中的接口说明）[5]\r\n            var response = $.httpclient.sendGet(batchUserUrl, params, headers);\r\n            if (response && response.get(\"code\") == 0) {\r\n                var usersData = response.get(\"data\"); // 返回的用户列表数据 [5]\r\n                for (var j = 0; j < usersData.size(); j++) {\r\n                    var userDetail = usersData.get(j);\r\n                    var userId = userDetail.get(\"id\");\r\n                    userDetailsMap.put(userId, userDetail); // 以用户ID为键存储完整信息\r\n                }\r\n                $.log.info(\"成功通过OpenAPI批量获取 \" + usersData.size() + \" 位用户的完整信息。\");\r\n            } else {\r\n                $.log.error(\"调用批量获取用户信息API失败，响应: \" + response);\r\n            }\r\n        } catch (apiError) {\r\n            $.log.error(\"获取用户详情失败: \" + apiError.toString());\r\n        }\r\n    }\r\n    \r\n    // 5. 遍历所有用户，整合信息并准备表单数据\r\n    for (var i = 0; i < allUsers.size(); i++) {\r\n        try {\r\n            var user = allUsers.get(i);\r\n            var baseUserJson = $.json.objectToJsonObject(user);\r\n            var userId = baseUserJson.get(\"id\");\r\n            \r\n            // 优先从批量获取的详情中提取字段 [5]\r\n            var userDetail = userDetailsMap.get(userId);\r\n            var userName = \"\";\r\n            var account = \"\";\r\n            var gender = \"\";\r\n            var telephone = \"\";\r\n            var defaultDepartmentId = \"\";\r\n            var defaultDepartmentName = \"\";\r\n            var departmentIds = \"\";\r\n            \r\n            if (userDetail) {\r\n                // 从用户详情中提取所有字段（字段名参考材料5中的“用户数据结构说明”）[5]\r\n                userName = userDetail.get(\"name\");\r\n                account = userDetail.get(\"account\");\r\n                // 性别处理：gender为int类型，通常1=男，2=女 [5]\r\n                var genderCode = userDetail.get(\"gender\");\r\n                gender = (genderCode == 1) ? \"男\" : ((genderCode == 2) ? \"女\" : \"未知\");\r\n                telephone = userDetail.get(\"telephone\"); // 手机号码 [5]\r\n                defaultDepartmentId = userDetail.get(\"defaultDepartmentId\"); // 默认部门ID [5]\r\n                \r\n                // 【新增】根据默认部门ID获取部门名称（调用部门接口）[4]\r\n                if (defaultDepartmentId) {\r\n                    try {\r\n                        var deptUrl = \"/openapi/contact/departments/\" + defaultDepartmentId; // 根据部门ID获取指定部门的接口 [4]\r\n                        var deptResponse = $.httpclient.sendGet(deptUrl, new Packages.java.util.HashMap(), new Packages.java.util.HashMap());\r\n                        if (deptResponse && deptResponse.get(\"code\") == 0) {\r\n                            defaultDepartmentName = deptResponse.get(\"data\").get(\"name\"); // 部门名称 [4]\r\n                        }\r\n                    } catch (deptError) {\r\n                        $.log.warn(\"获取部门名称失败，部门ID: \" + defaultDepartmentId + \", 错误: \" + deptError.toString());\r\n                    }\r\n                }\r\n                \r\n                // 处理部门ID列表（可能为数组，转换为字符串）[5]\r\n                var deptIdsList = userDetail.get(\"departmentIds\"); // 用户所在所有部门Id [5]\r\n                if (deptIdsList && deptIdsList.size() > 0) {\r\n                    departmentIds = $.java.arrayListToString(deptIdsList, \";\"); // 使用分号连接\r\n                }\r\n            } else {\r\n                // 降级方案：从基础用户对象中提取部分字段\r\n                userName = baseUserJson.get(\"name\");\r\n                telephone = baseUserJson.get(\"telephone\") || baseUserJson.get(\"mobile\") || baseUserJson.get(\"phone\");\r\n                $.log.warn(\"用户ID \" + userId + \" 未找到详细信息，仅使用基础字段。\");\r\n            }\r\n            \r\n            // 日志输出提取到的值（前3个用户用于调试）\r\n            if (i < 3) {\r\n                $.log.info(\"用户[\" + i + \"-\" + userName + \"] 提取结果: ID=\" + userId + \", 账号=\" + account + \", 性别=\" + gender + \", 手机号=\" + telephone + \", 默认部门=\" + defaultDepartmentName + \"(\" + defaultDepartmentId + \"), 所有部门=\" + departmentIds);\r\n            }\r\n            \r\n            // 构建单条表单数据变量\r\n            var variables = new Packages.java.util.HashMap();\r\n            // *** 请务必根据“人员信息导入表”的实际字段名称修改以下键名 ***\r\n            variables.put(\"ID\", userId); // 用户主键ID [5]\r\n            variables.put(\"账号\", account); // 用户账号 [5]\r\n            variables.put(\"姓名\", userName);\r\n            variables.put(\"性别\", gender); // 处理后的性别文本\r\n            variables.put(\"手机号\", telephone); // 手机号码 [5]\r\n            variables.put(\"默认部门ID\", defaultDepartmentId); // 默认部门ID [5]\r\n            variables.put(\"默认部门名称\", defaultDepartmentName); // 获取到的部门名称 [4]\r\n            variables.put(\"所有部门ID列表\", departmentIds); // 部门ID列表字符串 [5]\r\n            // 微信ID字段（保留原逻辑，可根据需要调整）\r\n            var wxUserId = \"\"; // 此处可补充从其他来源获取微信ID的逻辑\r\n            variables.put(\"微信ID\", wxUserId);\r\n            \r\n            var dataItem = new Packages.java.util.HashMap();\r\n            dataItem.put(\"variables\", variables);\r\n            dataItem.put(\"loginUserId\", $.context.getCurrentUserId());\r\n            \r\n            batchData.add(dataItem);\r\n            successCount++;\r\n            \r\n        } catch (e) {\r\n            $.log.error(\"处理第\" + i + \"个用户时出错: \" + e.toString());\r\n        }\r\n    }\r\n    \r\n    $.log.info(\"共处理\" + allUsers.size() + \"个用户，成功准备\" + successCount + \"条记录。\");\r\n    \r\n    // 6. 批量新增表单数据\r\n    if (batchData.size() > 0) {\r\n        try {\r\n            // 获取表单模型ID\r\n            var formModel = $.form.getFormModel(applicationId, formName);\r\n            var formModelId = formModel ? formModel.getId() : null;\r\n            if (!formModelId) {\r\n                $.log.error(\"无法获取表单'\" + formName + \"'的模型ID\");\r\n                return { success: false, message: \"表单模型ID查询失败\" };\r\n            }\r\n            \r\n            // 调用批量新增OpenAPI（参考材料3）[3]\r\n            var batchUrl = \"/openapi/form/data/batchCreate\";\r\n            var params = new Packages.java.util.HashMap();\r\n            params.put(\"applicationId\", applicationId);\r\n            params.put(\"formModelId\", formModelId);\r\n            \r\n            var headers = new Packages.java.util.HashMap();\r\n            headers.put(\"Content-Type\", \"application/json;charset=UTF-8\");\r\n            \r\n            var requestBody = new Packages.java.util.HashMap();\r\n            requestBody.put(\"list\", batchData); // 根据实际情况调整请求体结构\r\n            requestBody.put(\"loginUserId\", $.context.getCurrentUserId());\r\n            \r\n            var jsonStr = $.json.objectToJsonString(requestBody);\r\n            $.log.info(\"批量新增请求数据条数: \" + batchData.size());\r\n            var response = $.httpclient.sendPost(batchUrl, params, headers, jsonStr);\r\n            \r\n            $.log.info(\"批量新增结果: \" + $.json.objectToJsonString(response));\r\n            return {\r\n                success: true,\r\n                message: \"成功提交\" + batchData.size() + \"条用户记录至表单。\"\r\n            };\r\n            \r\n        } catch (apiError) {\r\n            $.log.error(\"调用批量新增API失败: \" + apiError.toString());\r\n            return {\r\n                success: false,\r\n                message: \"数据准备成功，但写入表单失败: \" + apiError.toString()\r\n            };\r\n        }\r\n    } else {\r\n        $.log.error(\"未成功准备任何可写入的数据\");\r\n        return {\r\n            success: false,\r\n            message: \"未成功准备任何可写入的数据\"\r\n        };\r\n    }\r\n})()\r\n","createTime":1768984089000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"37fcd374721c4862b9a14c8ad0b01957","id":"192285781405777920","modelCode":"","modelId":"697084bf977c2a4716f11802","modelType":"PC_BUSINESS_DESIGN","namespace":"人员信息调试","path":"人员信息导入表列表","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1768985901771,"versions":0.0}