{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"中交路南-出差考勤管理","content":"(function () {\r\n    //获取当前用户\r\n    var user = $.context.getCurrentUserId();\r\n    //应用Id\r\n    var applicationId = $.context.getCurrentApplicationId();\r\n\r\n    //获取本月度\r\n    var now = $.date.getCurrentDate();        //当前日期            \r\n    var nowYear = now.getYear() + 1900;\r\n    var yearstartdate = new Date(nowYear, 0, 1);   //本年第一天\r\n    var yearenddate = new Date(nowYear, 11, 31);  //本年最后一天\r\n\r\n    var date = yearstartdate.getTime();\r\n    var date1 = yearenddate.getTime();\r\n\r\n    //表单名称\r\n    var formName = \"请假审批单\";\r\n    //控件值键对\r\n    var filterParamList = new Packages.java.util.ArrayList();\r\n    var filterParam1 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"姓名\", \"eq\", user);\r\n    var filterParam2 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"休假类型\", \"eq\", \"1\");//\r\n    var filterParam3 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"申请日期\", \"ge\", date);//大于等于\r\n    var filterParam4 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"申请日期\", \"lt\", date1);//小于\r\n    filterParamList.add(filterParam1);\r\n    filterParamList.add(filterParam2);\r\n    filterParamList.add(filterParam3);\r\n    filterParamList.add(filterParam4);\r\n    var docS = $.form.getDocumentsByFilterParam(applicationId, formName, filterParamList);\r\n    // $.message.sendGeneralStationMessage(\"token\", num, $.context.getCurrentUserId());\r\n\r\n    var num = 0;\r\n    if (docS != null && docS.size() > 0) {\r\n        for (var i = 0; i < docS.size(); i++) {\r\n            var num1 = docS.get(i).getElementByName(\"年假天数\").getValue();\r\n            num += Number(num1);\r\n        }\r\n        // $.message.sendGeneralStationMessage(\"token\", num, $.context.getCurrentUserId());\r\n    }\r\n    //表单名称\r\n    var formName1 = \"员工信息维护\";\r\n    //控件值键对\r\n    var filterParamList1 = new Packages.java.util.ArrayList();\r\n    var filterParam1 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"姓名\", \"eq\", user);\r\n    // var filterParam2 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"休假类型\", \"eq\", \"1\");//\r\n    var filterParam3 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"申请日期\", \"ge\", date);//大于等于\r\n    var filterParam4 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"申请日期\", \"lt\", date1);//小于\r\n    filterParamList1.add(filterParam1);\r\n    // filterParamList.add(filterParam2);\r\n    filterParamList1.add(filterParam3);\r\n    filterParamList1.add(filterParam4);\r\n    var docS1 = $.form.getDocumentsByFilterParam(applicationId, formName1, filterParamList1);\r\n    if (docS1 != null && docS1.size() > 0) {\r\n        var kexiu = docS1.get(0).getElementByName(\"可休年假\").getValue();\r\n\r\n        docS1.get(0).addElement(\"已休年假\", String(num));\r\n        docS1.get(0).addElement(\"剩余年假\", String(kexiu -String(num)));\r\n        // $.message.sendGeneralStationMessage(\"111\", age, $.context.getCurrentUserId());\r\n        $.form.saveFormDocument(docS1.get(0), applicationId);\r\n    }\r\n\r\n})()","createTime":1766917432000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"190066725348999171","hiddenCode":"33ad28943c224ec2bc338396b6bf46bb","id":"190066725348999169","modelCode":"","modelId":"d881630bffca4c4397a6fe984e98f5c4","modelType":"PROCESS_DESIGN","namespace":"111","path":"请假审批","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1766917432000,"versions":1.0}