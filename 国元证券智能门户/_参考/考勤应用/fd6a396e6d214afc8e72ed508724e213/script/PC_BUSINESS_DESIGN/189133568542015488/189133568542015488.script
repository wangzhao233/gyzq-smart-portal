{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"【模】考勤管理","content":"(function () {\r\n    // 添加日志记录当前执行上下文\r\n    $.log.info(\"开始执行考勤月报处理脚本\");\r\n\r\n    var response = getdaydate();\r\n    var applicationId = $.context.getCurrentApplicationId();\r\n    $.log.info(\"获取当前应用ID: {}\", applicationId);\r\n    \r\n    var res = $.json.stringToJsonObject(response);\r\n    $.log.info(\"解析API响应数据完成\");\r\n    \r\n    if (res.get(\"errcode\") == \"42001\") {\r\n        $.log.warn(\"检测到token过期，开始重新获取token\");\r\n        //如果token过期了\r\n        gettoken();\r\n        var response = getdaydate();\r\n        var res = $.json.stringToJsonObject(response);\r\n        $.log.info(\"重新获取数据成功\");\r\n    }\r\n\r\n    //获取当月\r\n    var now = $.date.getCurrentDate();        //当前日期       \r\n    $.log.info(\"获取当前日期: {}\", now);\r\n    var nowMonth = now.getMonth();           //当前月     \r\n    var nowYear = now.getYear() + 1900;\r\n    var mongthdays = getMonthDays(nowYear, nowMonth);//本月天数\r\n    $.log.info(\"获取当月总天数: {}\", mongthdays);\r\n\r\n    var monthstartdate = getMonthStartDate(nowYear, nowMonth);  //当月起始日期\r\n    var monthEndDate = getMonthEndDate(nowYear, nowMonth, mongthdays);//当月结束日期\r\n    $.log.info(\"计算月度范围: 开始日期={}, 结束日期={}\", monthstartdate, monthEndDate);\r\n\r\n    var datea = monthstartdate.getTime();\r\n    var datea1 = monthEndDate.getTime();\r\n    $.log.info(\"转换时间戳: 开始={}, 结束={}\", datea, datea1);\r\n    \r\n    //接收用户id集合\r\n    var receiveUserIds = $.context.getCurrentUserId();\r\n    $.log.info(\"获取当前用户ID: {}\", receiveUserIds);\r\n    \r\n    //发送站内信\r\n    $.message.sendGeneralStationMessage(\"subject\", datea, receiveUserIds);\r\n    $.message.sendGeneralStationMessage(\"subject1\", datea1, receiveUserIds);\r\n    $.log.info(\"发送站内信通知完成\");\r\n\r\n    var dates = res.get(\"datas\");\r\n    $.log.info(\"获取考勤数据列表，总数: {}\", dates != null ? dates.size() : 0);\r\n    \r\n    if (dates != null && dates.size() > 0) {\r\n        for (var j = 0; j < dates.size(); j++) {\r\n            $.log.info(\"处理第{}条考勤数据\", j + 1);\r\n            \r\n            var base_info = dates.get(j).get(\"base_info\");\r\n            var summary_info = dates.get(j).get(\"summary_info\");\r\n            // var overwork_info = dates.get(j).get(\"overwork_info\");\r\n            // var sp_items = dates.get(j).get(\"sp_items\");\r\n            var exception_infos = dates.get(j).get(\"exception_infos\");\r\n            \r\n            $.log.info(\"创建考勤月报文档\");\r\n            var adddoc = $.form.createEmptyDocument(applicationId, \"考勤月报\");\r\n            \r\n            // 添加基本信息\r\n            adddoc.addElement(\"账号\", base_info.get(\"acctid\"))\r\n            adddoc.addElement(\"姓名\", base_info.get(\"name\"))\r\n            adddoc.addElement(\"开始日期\", datea)\r\n            adddoc.addElement(\"结束日期\", datea1)\r\n            adddoc.addElement(\"部门\", base_info.get(\"departs_name\"))\r\n            adddoc.addElement(\"应出勤天数\", summary_info.get(\"work_days\"))\r\n            adddoc.addElement(\"实际出勤天数\", summary_info.get(\"regular_days\"))\r\n            // adddoc.addElement(\"异常天数\", summary_info.get(\"except_days\"))\r\n            adddoc.addElement(\"实际工作时长\", summary_info.get(\"regular_work_sec\") / 3600)\r\n            adddoc.addElement(\"标准工作时长\", summary_info.get(\"standard_work_sec\") / 3600)\r\n            \r\n            $.log.info(\"添加基本信息完成，账号: {}\", base_info.get(\"acctid\"))\r\n\r\n            // if (sp_items != null && sp_items.size() > 0) {\r\n            //     $.log.info(\"处理假勤统计项目，数量: {}\", sp_items.size());\r\n            //     for (var j1 = 0; j1 < sp_items.size(); j1++) {\r\n            //         var adddoc1 = $.form.createEmptyDocument(applicationId, \"月报假勤统计\");\r\n            //         adddoc1.addElement(\"关联月报\", adddoc.getId())\r\n            //         adddoc1.addElement(\"假勤类型\", (sp_items.get(j1).get(\"type\")).toString())\r\n            //         adddoc1.addElement(\"假勤次数\", sp_items.get(j1).get(\"count\"))\r\n            //         adddoc1.addElement(\"假勤时长\", sp_items.get(j1).get(\"duration\") / 3600)\r\n            //         adddoc1.addElement(\"统计项名称\", sp_items.get(j1).get(\"name\"))\r\n            //         $.form.saveFormDocument(adddoc1, applicationId)\r\n            //         $.log.info(\"保存假勤统计记录完成\");\r\n            //     }\r\n            // }\r\n            \r\n            if (exception_infos != null && exception_infos.size() > 0) {\r\n                $.log.info(\"处理异常记录，数量: {}\", exception_infos.size());\r\n                for (var j2 = 0; j2 < exception_infos.size(); j2++) {\r\n                    var adddoc2 = $.form.createEmptyDocument(applicationId, \"月报异常记录\");\r\n                    adddoc2.addElement(\"关联月报\", adddoc.getId())\r\n                    adddoc2.addElement(\"开始日期\", datea)\r\n                    adddoc2.addElement(\"结束日期\", datea1)\r\n                    adddoc2.addElement(\"异常类型\", (exception_infos.get(j2).get(\"exception\")).toString())\r\n                    adddoc2.addElement(\"异常次数\", exception_infos.get(j2).get(\"count\"))\r\n                    adddoc2.addElement(\"异常时长\", exception_infos.get(j2).get(\"duration\") / 3600)\r\n                    $.form.saveFormDocument(adddoc2, applicationId)\r\n                    $.log.info(\"保存异常记录完成，异常类型: {}\", (exception_infos.get(j2).get(\"exception\")).toString());\r\n                }\r\n            }\r\n\r\n            $.form.saveFormDocument(adddoc, applicationId);\r\n            $.log.info(\"保存考勤月报文档完成，ID: {}\", adddoc.getId());\r\n        }\r\n        $.log.info(\"所有考勤数据处理完成\");\r\n    } else {\r\n        $.log.warn(\"未获取到有效的考勤数据\");\r\n    }\r\n\r\n    $.log.info(\"考勤月报处理脚本执行完成\");\r\n})()\r\n\r\nfunction getdaydate() {\r\n    $.log.info(\"开始获取考勤数据\");\r\n    \r\n    /*当前应用id */\r\n    var appId = $.context.getCurrentApplicationId();\r\n    $.log.info(\"获取当前应用ID: {}\", appId);\r\n\r\n    //获取当月\r\n    var now = $.date.getCurrentDate();        //当前日期       \r\n    $.log.info(\"获取当前日期: {}\", now);\r\n    var nowMonth = now.getMonth();           //当前月     \r\n    var nowYear = now.getYear() + 1900;\r\n    $.log.info(\"计算年份: {}, 月份: {}\", nowYear, nowMonth);\r\n    var mongthdays = getMonthDays(nowYear, nowMonth);//本月天数\r\n    $.log.info(\"获取当月总天数: {}\", mongthdays);\r\n\r\n    var monthstartdate = getMonthStartDate(nowYear, nowMonth);  //当月起始日期\r\n    var monthEndDate = getMonthEndDate(nowYear, nowMonth, mongthdays);//当月结束日期\r\n    $.log.info(\"计算月度范围: 开始日期={}, 结束日期={}\", monthstartdate, monthEndDate);\r\n\r\n    var date = monthstartdate.getTime() / 1000;\r\n    var date1 = monthEndDate.getTime() / 1000;\r\n    $.log.info(\"转换时间戳: 开始={}, 结束={}\", date, date1);\r\n    \r\n    //接收用户id集合\r\n    var receiveUserIds = $.context.getCurrentUserId();\r\n    $.log.info(\"获取当前用户ID: {}\", receiveUserIds);\r\n    \r\n    //发送站内信\r\n    $.message.sendGeneralStationMessage(\"subject\", date, receiveUserIds);\r\n    $.message.sendGeneralStationMessage(\"subject1\", date1, receiveUserIds);\r\n    $.log.info(\"发送站内信通知完成\");\r\n\r\n    /*获取员工信息表的所有员工账号集合 */\r\n    $.log.info(\"开始获取员工账号列表\");\r\n    var accountList = new Packages.java.util.ArrayList();\r\n    var userMap = new Packages.java.util.HashMap();\r\n    var userDocsList = $.form.getFormDocumentsByFieldNameAndValue(appId, \"员工信息维护\", userMap);\r\n    $.log.info(\"获取员工信息表数据，总数: {}\", userDocsList.size());\r\n    \r\n    var num = Math.ceil(userDocsList.size() / 100);\r\n    $.log.info(\"计算分页处理批次: {}\", num);\r\n\r\n    // 在循环外定义变量\r\n    var dayUrl, dayParams, dayHeaders, json;\r\n    \r\n    for (var s = 0; s < num; s++) {\r\n        $.log.info(\"处理第{}批员工数据\", s + 1);\r\n        var a = s * 100;\r\n        var b = (s + 1) * 100;\r\n        \r\n        if (s == Number(num) - 1) {\r\n            var b = userDocsList.size() - a;\r\n            $.log.info(\"最后一批数据，调整结束索引: {}\", b);\r\n        }\r\n\r\n        if (userDocsList != null && b > 0) {\r\n            for (var f = a; f < b; f++) {\r\n                var userId = userDocsList.get(f).getElementByName(\"姓名\").getValue();\r\n                var user = $.contact.getUserById(userId);\r\n                if (user != null) {\r\n                    var account = user.getAccount().toString();\r\n                    if (accountList.contains(account) == false) {\r\n                        accountList.add(account);\r\n                        $.log.info(\"添加员工账号: {}\", account);\r\n                    }\r\n                } else {\r\n                    $.log.warn(\"无法获取用户信息，ID: {}\", userId);\r\n                }\r\n            }\r\n        }\r\n        \r\n        /* 获取token*/\r\n        $.log.info(\"准备获取企业微信API token\");\r\n        // var corpid = \"wwc1752ac659433e67\";//企业id\r\n        // var secret = \"jBtKQfiIy1UcAg8pFyNQXkss5yMwsYncGFUMwimKS4Q\";//打卡应用密钥\r\n        var corpid = \"ww221c0bad06436cb9\";//企业id\r\n        var secret = \"dUJ_BzUJIhFxubMuBsLFy_jjSaLXsRqANNwySpYgRSs\";//打卡应用密钥\r\n        var url = \"https://qyapi.weixin.qq.com/cgi-bin/gettoken\";\r\n        $.log.info(\"企业微信API URL: {}\", url);\r\n        \r\n        var params = new Packages.java.util.HashMap();\r\n        params.put(\"corpid\", corpid);\r\n        params.put(\"corpsecret\", secret);\r\n        $.log.info(\"构建token请求参数完成\");\r\n        \r\n        var headers = new Packages.java.util.HashMap();\r\n        headers.put(\"Content-Type\", \"application/json;charset=UTF-8\");\r\n        var response = $.httpclient.sendGet(url, params, headers);\r\n        var res = $.json.stringToJsonObject(response);\r\n        var token = res.get(\"access_token\");\r\n        $.log.info(\"获取企业微信API token成功\");\r\n        \r\n        /*获取月报 */\r\n        dayUrl = \"https://qyapi.weixin.qq.com/cgi-bin/checkin/getcheckin_monthdata\";\r\n        dayParams = new Packages.java.util.HashMap();\r\n        dayParams.put(\"access_token\", token);\r\n        dayHeaders = new Packages.java.util.HashMap();\r\n        dayHeaders.put(\"Content-Type\", \"application/json;charset=UTF-8\");\r\n        json = {\r\n            \"starttime\": date,\r\n            \"endtime\": date1,\r\n            \"useridlist\": accountList\r\n        }\r\n        $.log.info(\"构建考勤月报请求参数完成\");\r\n    }\r\n\r\n    $.log.info(\"员工账号收集完成，总数: {}\", accountList.size());\r\n    var jsonStr = $.json.objectToJsonString(json);\r\n    $.log.info(\"构建考勤月报请求JSON: {}\", jsonStr);\r\n    \r\n    var dayResponse = $.httpclient.sendPost(dayUrl, dayParams, dayHeaders, jsonStr);\r\n    $.log.info(\"发送考勤月报请求完成\");\r\n    \r\n    return dayResponse;\r\n}\r\n\r\n//获得当月的开始日期     \r\nfunction getMonthStartDate(nowYear, nowMonth) {\r\n    $.log.info(\"计算当月开始日期，年份: {}, 月份: {}\", nowYear, nowMonth);\r\n    var monthStartDate0 = new Date(nowYear, nowMonth, 1);\r\n    //转格式\r\n    var format = \"yyyy-MM-dd\";\r\n    //获取日期字符串\r\n    var dateStr = $.date.dateToString(monthStartDate0, format);\r\n    var monthStartDate = $.date.stringToDate(dateStr, format)\r\n    $.log.info(\"当月开始日期: {}\", monthStartDate);\r\n    return monthStartDate;\r\n}\r\n\r\n//获得当月的结束日期     \r\nfunction getMonthEndDate(nowYear, nowMonth, mongthdays) {\r\n    $.log.info(\"计算当月结束日期，年份: {}, 月份: {}, 天数: {}\", nowYear, nowMonth, mongthdays);\r\n    var monthEndDate0 = new Date(nowYear, nowMonth, mongthdays);\r\n    //转格式\r\n    var format = \"yyyy-MM-dd\";\r\n    //获取日期字符串\r\n    var dateStr = $.date.dateToString(monthEndDate0, format);\r\n    var monthEndDate = $.date.stringToDate(dateStr, format)\r\n    $.log.info(\"当月结束日期: {}\", monthEndDate);\r\n    return monthEndDate;\r\n}\r\n\r\n//获取当月总共天数\r\nfunction getMonthDays(nowYear, nowMonth) {\r\n    $.log.info(\"计算月份天数，年份: {}, 月份: {}\", nowYear, nowMonth);\r\n    var endday = new Date(nowYear, nowMonth + 1, 0);\r\n    var days = endday.getDate();\r\n    $.log.info(\"月份天数: {}\", days);\r\n    return days;\r\n}\r\n\r\nfunction gettoken() {\r\n    $.log.info(\"执行token获取函数\");\r\n    // 重新获取token的逻辑\r\n    // var corpid = \"ww221c0bad06436cb9\";//企业id\r\n    // var secret = \"dUJ_BzUJIhFxubMuBsLFy_jjSaLXsRqANNwySpYgRSs\";//打卡应用密钥\r\n    var corpid = \"ww221c0bad06436cb9\";//企业id\r\n    var secret = \"dUJ_BzUJIhFxubMuBsLFy_jjSaLXsRqANNwySpYgRSs\";//打卡应用密钥\r\n    var url = \"https://qyapi.weixin.qq.com/cgi-bin/gettoken\";\r\n    var params = new Packages.java.util.HashMap();\r\n    params.put(\"corpid\", corpid);\r\n    params.put(\"corpsecret\", secret);\r\n    var headers = new Packages.java.util.HashMap();\r\n    headers.put(\"Content-Type\", \"application/json;charset=UTF-8\");\r\n    var response = $.httpclient.sendGet(url, params, headers);\r\n    var res = $.json.stringToJsonObject(response);\r\n    var token = res.get(\"access_token\");\r\n    $.log.info(\"重新获取token成功\");\r\n}","createTime":1766048369000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"25ef504c56264256b475612951fb9005","id":"189133568542015488","modelCode":"","modelId":"a2adf27408904b3e83cff0675b6cee9e","modelType":"PC_BUSINESS_DESIGN","namespace":"ceshi月报","path":"考勤月报","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1766048787544,"versions":0.0}