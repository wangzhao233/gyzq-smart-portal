{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"中交路南-出差考勤管理","content":"(function () {\r\n    var doc = $.context.getCurrentDocument();\r\n    var applicationId = $.context.getCurrentApplicationId();\r\n    var name = doc.getElementByName(\"姓名\").getValue();\r\n\r\n\r\n    var map = new Packages.java.util.HashMap();\r\n    map.put(\"姓名\", name);\r\n    var formName = \"员工信息维护\";\r\n    var documents = $.form.getFormDocumentsByFieldNameAndValue(applicationId, formName, map);\r\n    if (documents != null) {\r\n        var zhiwei = documents.get(0).getElementByName(\"职位\").getValue();\r\n        return zhiwei;\r\n    } else {\r\n        return \"\";\r\n    }\r\n\r\n})()\r\n","createTime":1765854149000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"f452d2567e654097b03787688fdf63ac","id":"d1b68bcf828c4dca86b6f3865137a699","modelCode":"","modelId":"c05053bf0571470891f5a50dfd3c1762","modelType":"FORM_DESIGN","namespace":"cd","path":"出差审批表","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1765854149000,"versions":0.0}