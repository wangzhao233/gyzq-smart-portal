{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"中交路南项目1116","content":"(function () {\r\n    var doc = $.context.getCurrentDocument();\r\n    var applicationId = $.context.getCurrentApplicationId();\r\n    var name = doc.getElementByName(\"姓名\").getValue();\r\n    var map = new Packages.java.util.HashMap();\r\n    map.put(\"姓名\", name);\r\n    var formName = \"员工信息维护\";\r\n    var documents = $.form.getFormDocumentsByFieldNameAndValue(applicationId, formName, map);\r\n    if (documents != null) {\r\n        var jibei = documents.get(0).getElementByName(\"级别\").getValue();\r\n        return jibei;\r\n    } else {\r\n        return \"\";\r\n    }\r\n\r\n})()\r\n","createTime":1765854149000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"ef235710d5a44593ab515a389db83bb2","id":"f568135cafae40b3b3de0d57f50e1c7d","modelCode":"","modelId":"c05053bf0571470891f5a50dfd3c1762","modelType":"FORM_DESIGN","namespace":"获取员工的级别信息","path":"出差审批表","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1765854149000,"versions":0.0}