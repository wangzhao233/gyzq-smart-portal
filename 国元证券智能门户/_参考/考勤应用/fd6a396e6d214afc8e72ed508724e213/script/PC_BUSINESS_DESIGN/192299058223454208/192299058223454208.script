{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"考勤管理","content":"(function () {\r\n    // 1. 获取当前应用ID和所有用户信息\r\n    var applicationId = $.context.getCurrentApplicationId();\r\n    $.log.info(\"=== 开始执行人员信息导入脚本 ===\");\r\n    $.log.info(\"当前应用ID: \" + applicationId);\r\n    \r\n    var allUsers = $.contact.queryAllUser(); // 获取通讯录全部用户 [2]\r\n    $.log.info(\"获取到用户总数: \" + allUsers.size());\r\n    \r\n    var targetFormName = \"人员信息导入表\"; // 目标表单名称\r\n    $.log.info(\"目标表单: \" + targetFormName);\r\n\r\n    var successCount = 0;    // 成功数（新增+更新）\r\n    var errorCount = 0;      // 失败数\r\n    var addCount = 0;        // 新增数\r\n    var updateCount = 0;     // 更新数\r\n\r\n    // 2. 遍历所有用户并创建表单数据\r\n    $.log.info(\"=== 开始处理用户数据 ===\");\r\n    \r\n    for (var i = 0; i < allUsers.size(); i++) {\r\n        try {\r\n            $.log.info(\"--- 处理第 \" + (i+1) + \" 个用户 ---\");\r\n            var user = allUsers.get(i);\r\n            \r\n            // 将用户对象转换为JSON对象以便获取属性\r\n            var userJson = $.json.objectToJsonObject(user);\r\n            \r\n            // 记录原始用户对象的完整JSON（用于调试）\r\n            $.log.info(\"用户对象完整JSON: \" + $.json.objectToJsonString(userJson));\r\n\r\n            // 3. 提取所需字段\r\n            var userId = userJson.get(\"id\"); // 用户ID [4]\r\n            $.log.info(\"用户ID: \" + userId);\r\n            \r\n            var account = userJson.get(\"account\"); // 账号 [4]\r\n            $.log.info(\"账号: \" + account);\r\n            \r\n            var userName = userJson.get(\"name\"); // 姓名 [4]\r\n            $.log.info(\"姓名: \" + userName);\r\n            \r\n            var telephone = userJson.get(\"telephone\") || \"\"; // 手机号\r\n            $.log.info(\"手机号: \" + telephone);\r\n\r\n            var wxUserId = userJson.get(\"wxUserId\"); // 微信ID\r\n            $.log.info(\"微信ID: \" + wxUserId);\r\n            \r\n            // 处理性别字段：gender为int类型，需要转换为文字 [4]\r\n            var genderCode = userJson.get(\"gender\");\r\n            $.log.info(\"性别代码原始值: \" + genderCode);\r\n            \r\n            var genderText = \"未知\";\r\n            if (genderCode == 1) {\r\n                genderText = \"男\";\r\n            } else if (genderCode == 2) {\r\n                genderText = \"女\";\r\n            }\r\n            $.log.info(\"性别转换结果: \" + genderText);\r\n            \r\n            var defaultDepartmentId = userJson.get(\"defaultDepartmentId\"); // 默认部门ID [4]\r\n            $.log.info(\"默认部门ID: \" + defaultDepartmentId);\r\n            \r\n            var defaultDepartmentName = userJson.get(\"defaultDepartmentName\"); // 默认部门名称 [4]\r\n            $.log.info(\"默认部门名称: \" + defaultDepartmentName);\r\n            \r\n            var defaultDepartmentFullName = userJson.get(\"defaultDepartmentFullName\"); // 默认部门全路径名称\r\n            $.log.info(\"默认部门全路径名称: \" + defaultDepartmentFullName);\r\n            \r\n            // 检查关键字段是否存在\r\n            if (!userId) {\r\n                $.log.warn(\"警告：用户ID为空，可能会影响数据准确性\");\r\n            }\r\n            if (!account) {\r\n                $.log.warn(\"警告：账号为空\");\r\n            }\r\n            if (!userName) {\r\n                $.log.warn(\"警告：姓名为空\");\r\n            }\r\n\r\n            // 4. 创建新的表单文档\r\n            $.log.info(\"正在创建表单文档...\");\r\n            var newFormDoc = $.form.createEmptyDocument(applicationId, targetFormName);\r\n\r\n            // 5. 为表单字段赋值\r\n            $.log.info(\"开始为表单字段赋值...\");\r\n            // *** 重要：请根据“人员信息导入表”中实际的字段名称修改以下所有字段名 ***\r\n            \r\n            // 假设“人员”字段是人员选择器，直接传入用户ID [5]\r\n            newFormDoc.addElement(\"人员\", userId); // 字段名“人员”需要确认\r\n            newFormDoc.addElement(\"人员单选\", userId);\r\n            newFormDoc.addElement(\"账号\", account); // 字段名“账号”需要确认\r\n            newFormDoc.addElement(\"姓名\", userName); // 字段名“姓名”需要确认\r\n            newFormDoc.addElement(\"性别\", genderText); // 字段名“性别”需要确认\r\n            newFormDoc.addElement(\"手机号\", telephone); // 字段名“性别”需要确认           \r\n            newFormDoc.addElement(\"默认部门\", defaultDepartmentId); // 字段名需确认\r\n            newFormDoc.addElement(\"部门单选\", defaultDepartmentId); // 字段名需确认            \r\n            newFormDoc.addElement(\"默认部门名称\", defaultDepartmentName); // 字段名需确认\r\n            newFormDoc.addElement(\"默认部门全路径名称\", defaultDepartmentFullName); // 字段名需确认\r\n            \r\n            newFormDoc.addElement(\"微信id\", wxUserId); // 字段名“微信id”需要确认\r\n            \r\n            // 记录将要保存的字段值（用于调试）\r\n            $.log.info(\"表单赋值完成，准备保存的字段值：\");\r\n            $.log.info(\"  - 人员: \" + userId);\r\n            $.log.info(\"  - 账号: \" + account);\r\n            $.log.info(\"  - 姓名: \" + userName);\r\n            $.log.info(\"  - 性别: \" + genderText);\r\n            $.log.info(\"  - 默认部门ID: \" + defaultDepartmentId);\r\n            $.log.info(\"  - 默认部门名称: \" + defaultDepartmentName);\r\n            $.log.info(\"  - 默认部门全路径名称: \" + defaultDepartmentFullName);\r\n            $.log.info(\"  - 微信id: \" + wxUserId);\r\n            \r\n            // 6. 保存表单文档\r\n            $.form.saveFormDocument(newFormDoc, applicationId);\r\n            $.log.info(\"✅ 第 \" + (i+1) + \" 个用户保存成功\");\r\n            successCount++;\r\n\r\n        } catch (e) {\r\n            errorCount++;\r\n            $.log.error(\"❌ 处理第 \" + (i+1) + \" 个用户时出错: \" + e.toString());\r\n            $.log.error(\"错误详情: \" + e.stack);\r\n        }\r\n        \r\n        // 每处理10个用户输出一次进度\r\n        if ((i+1) % 10 === 0) {\r\n            $.log.info(\"📊 处理进度: 已处理 \" + (i+1) + \" / \" + allUsers.size() + \" 个用户\");\r\n        }\r\n    }\r\n\r\n    // 7. 返回处理结果\r\n    var resultMessage = \"操作完成。成功导入 \" + successCount + \" 条记录，失败 \" + errorCount + \" 条。\";\r\n    $.log.info(\"=== 脚本执行结果 ===\");\r\n    $.log.info(resultMessage);\r\n    \r\n    // 输出统计信息\r\n    $.log.info(\"📈 统计信息：\");\r\n    $.log.info(\"  - 总用户数: \" + allUsers.size());\r\n    $.log.info(\"  - 成功数: \" + successCount);\r\n    $.log.info(\"  - 失败数: \" + errorCount);\r\n    \r\n    if (errorCount > 0) {\r\n        $.log.warn(\"⚠️ 有 \" + errorCount + \" 条记录处理失败，请检查日志中的错误信息\");\r\n    } else {\r\n        $.log.info(\"🎉 所有用户处理完成，无失败记录\");\r\n    }\r\n    \r\n\r\n})();\r\n","createTime":1768996454000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"fcea8e533c5f4c4ca27ac0b5d61c8893","id":"192299058223454208","modelCode":"","modelId":"697084bf977c2a4716f11802","modelType":"PC_BUSINESS_DESIGN","namespace":"人员2","path":"人员信息导入表列表","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1770277018565,"versions":0.0}