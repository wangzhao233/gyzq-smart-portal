{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"中交路南-出差考勤管理","content":"(function () {\r\n    var appId = $.context.getCurrentApplicationId();\r\n    var doc = $.context.getCurrentDocument();\r\n    var userId = doc.getElementByName(\"姓名\").getValue();\r\n    var map = new Packages.java.util.HashMap();\r\n    map.put(\"姓名\", userId);\r\n    var formName = \"出差审批表\";\r\n    var documents = $.form.getFormDocumentsByFieldNameAndValue(appId, formName, map);\r\n    if (documents != null) {\r\n        var id = documents.get(documents.size()-1).getId();\r\n        return id ;\r\n    }else{\r\n        return null;\r\n    }\r\n})()","createTime":1774591966141,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"5f57e99e2e824f6b96630c11b7571735","id":"afe8184b14a54e1694a5f7911f29eea4","modelCode":"","modelId":"be4b5eb51815408b8bc5e04a0c7040ce","modelType":"FORM_DESIGN","namespace":"获取最近一条出差审批","path":"出差记录表","status":"ERROR","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1774591966141,"versions":0.0}