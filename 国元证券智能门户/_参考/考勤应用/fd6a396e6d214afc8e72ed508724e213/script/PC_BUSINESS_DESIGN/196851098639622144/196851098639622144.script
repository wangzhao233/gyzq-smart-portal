{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"考勤管理","content":"(function () {\r\n    var applicationId = $.context.getCurrentApplicationId();\r\n    var token = \"\";\r\n    var maxRetry = 2; // 最大重试次数\r\n\r\n    // 1. 获取时间范围\r\n    var dateRange = getDateRange();\r\n    var sTime = dateRange.start;\r\n    var eTime = dateRange.end;\r\n\r\n    // 2. 获取所有员工账号\r\n    var accountList = getAllUserAccounts(applicationId);\r\n    if (accountList.size() == 0) {\r\n        $.message.sendGeneralStationMessage(\"错误\", \"未获取到任何员工账号\", $.context.getCurrentUserId());\r\n        return;\r\n    }\r\n\r\n    // 3. 获取 Token (只获取一次)\r\n    token = getAccessToken();\r\n    if (!token) {\r\n        $.message.sendGeneralStationMessage(\"错误\", \"无法获取 Access Token\", $.context.getCurrentUserId());\r\n        return;\r\n    }\r\n\r\n    // 4. 构建请求参数\r\n    var dayUrl = \"https://qyapi.weixin.qq.com/cgi-bin/checkin/getcheckin_daydata\";\r\n    var jsonParam = {\r\n        \"starttime\": sTime,\r\n        \"endtime\": eTime,\r\n        \"useridlist\": accountList\r\n    };\r\n    var jsonStr = $.json.objectToJsonString(jsonParam);\r\n\r\n    // 5. 发送请求并处理重试\r\n    var response = sendRequestWithRetry(dayUrl, token, jsonStr, maxRetry);\r\n    \r\n    if (!response) {\r\n        $.message.sendGeneralStationMessage(\"错误\", \"请求钉钉/企业微信接口失败\", $.context.getCurrentUserId());\r\n        return;\r\n    }\r\n\r\n    var res = $.json.stringToJsonObject(response);\r\n    if (res.get(\"errcode\") != \"0\") {\r\n        $.message.sendGeneralStationMessage(\"API错误\", \"errcode:\" + res.get(\"errcode\") + \", msg:\" + res.get(\"errmsg\"), $.context.getCurrentUserId());\r\n        return;\r\n    }\r\n\r\n    var dates = res.get(\"datas\");\r\n    if (dates == null || dates.size() == 0) {\r\n        $.message.sendGeneralStationMessage(\"提示\", \"当前时间段无考勤数据\", $.context.getCurrentUserId());\r\n        return;\r\n    }\r\n\r\n    // 6. 解析数据并写入七巧\r\n    for (var j = 0; j < dates.size(); j++) {\r\n        try {\r\n            processSingleRecord(applicationId, dates.get(j));\r\n        } catch (e) {\r\n            $.message.sendGeneralStationMessage(\"处理单条记录出错\", \"姓名:\" + dates.get(j).get(\"base_info\").get(\"name\") + \", 错误:\" + e, $.context.getCurrentUserId());\r\n        }\r\n    }\r\n\r\n    $.message.sendGeneralStationMessage(\"完成\", \"成功处理 \" + dates.size() + \" 条考勤记录\", $.context.getCurrentUserId());\r\n\r\n    // --- 内部函数定义 ---\r\n\r\n    function processSingleRecord(appId, recordObj) {\r\n        var base_info = recordObj.get(\"base_info\");\r\n        var summary_info = recordObj.get(\"summary_info\");\r\n        var exception_infos = recordObj.get(\"exception_infos\");\r\n        var ot_info = recordObj.get(\"ot_info\");\r\n        var holiday_infos = recordObj.get(\"holiday_infos\");\r\n        var sp_items = recordObj.get(\"sp_items\");\r\n\r\n        // 创建主文档\r\n        var adddoc = $.form.createEmptyDocument(appId, \"考勤日报\");\r\n        \r\n        // --- 基础信息 ---\r\n        adddoc.addElement(\"账号\", base_info.get(\"acctid\"));\r\n        adddoc.addElement(\"姓名\", base_info.get(\"name\"));\r\n        // 日期转换：秒 -> 毫秒\r\n        var dateVal = base_info.get(\"date\");\r\n        adddoc.addElement(\"日期\", dateVal * 1000);\r\n        adddoc.addElement(\"部门\", base_info.get(\"departs_name\"));\r\n        adddoc.addElement(\"日报类型\", (parseInt(base_info.get(\"day_type\")) + 1).toString());\r\n\r\n        // --- 新增：班次规则信息 ---\r\n        var rule_info = base_info.get(\"rule_info\");\r\n        if (rule_info != null) {\r\n            adddoc.addElement(\"规则组\", rule_info.get(\"groupname\") || \"\");\r\n            adddoc.addElement(\"班次名称\", rule_info.get(\"schedulename\") || \"\");\r\n        } else {\r\n            adddoc.addElement(\"规则组\", \"\");\r\n            adddoc.addElement(\"班次名称\", \"\");\r\n        }\r\n\r\n        // --- 汇总信息 ---\r\n        adddoc.addElement(\"打卡次数\", summary_info.get(\"checkin_count\"));\r\n        adddoc.addElement(\"实际工作时长\", parseFloat((summary_info.get(\"regular_work_sec\") / 3600).toFixed(2)));\r\n        adddoc.addElement(\"标准工作时长\", parseFloat((summary_info.get(\"standard_work_sec\") / 3600).toFixed(2)));\r\n        \r\n        // 时间计算\r\n        var baseTimestamp = dateVal * 1000;\r\n        var earliest = summary_info.get(\"earliest_time\");\r\n        var latest = summary_info.get(\"lastest_time\");\r\n        \r\n        if (earliest != null && earliest > 0) {\r\n            adddoc.addElement(\"最早\", $.date.dateToString($.date.timestampToDate(baseTimestamp + (earliest * 1000)), \"HH:mm:ss\"));\r\n        } else {\r\n            adddoc.addElement(\"最早\", \"\");\r\n        }\r\n        \r\n        if (latest != null && latest > 0) {\r\n            adddoc.addElement(\"最晚\", $.date.dateToString($.date.timestampToDate(baseTimestamp + (latest * 1000)), \"HH:mm:ss\"));\r\n        } else {\r\n            adddoc.addElement(\"最晚\", \"\");\r\n        }\r\n\r\n        // --- 新增：加班信息 ---\r\n        if (ot_info != null) {\r\n            adddoc.addElement(\"加班状态\", ot_info.get(\"ot_status\")); // 0-无, 1-正常, 2-缺时长\r\n            var otDur = ot_info.get(\"ot_duration\");\r\n            adddoc.addElement(\"认定加班时长\", parseFloat((otDur / 3600).toFixed(2)));\r\n            // 如需更细致可添加: workday_over_as_money 等\r\n        } else {\r\n            adddoc.addElement(\"加班状态\", 0);\r\n            adddoc.addElement(\"认定加班时长\", 0);\r\n        }\r\n\r\n        // --- 异常处理逻辑 (原有逻辑优化) ---\r\n        var hasException = (exception_infos != null && exception_infos.size() > 0);\r\n        \r\n        if (hasException) {\r\n            adddoc.addElement(\"状态\", \"2\"); // 异常\r\n            adddoc.addElement(\"申诉状态\", \"1\");\r\n            \r\n            // 写入子表单：日报异常记录\r\n            for (var j1 = 0; j1 < exception_infos.size(); j1++) {\r\n                var exItem = exception_infos.get(j1);\r\n                var subDocEx = $.form.createEmptyDocument(appId, \"日报异常记录\"); // 确保有此子表单\r\n                subDocEx.addElement(\"关联日报ID\", adddoc.getId());\r\n                subDocEx.addElement(\"异常类型\", exItem.get(\"exception\").toString());\r\n                subDocEx.addElement(\"异常次数\", exItem.get(\"count\"));\r\n                var exDur = exItem.get(\"duration\");\r\n                subDocEx.addElement(\"异常时长\", parseFloat((exDur / 3600).toFixed(2)));\r\n                $.form.saveFormDocument(subDocEx, appId);\r\n            }\r\n        } else {\r\n            adddoc.addElement(\"状态\", \"1\"); // 正常\r\n            adddoc.addElement(\"申诉状态\", \"2\");\r\n        }\r\n\r\n        // --- 新增：假勤审批单 (holiday_infos) ---\r\n        if (holiday_infos != null && holiday_infos.size() > 0) {\r\n            for (var k = 0; k < holiday_infos.size(); k++) {\r\n                var hItem = holiday_infos.get(k);\r\n                var subDocH = $.form.createEmptyDocument(appId, \"日报审批记录\"); // 确保有此子表单\r\n                subDocH.addElement(\"关联日报ID\", adddoc.getId());\r\n                subDocH.addElement(\"审批单号\", hItem.get(\"sp_number\") || \"\");\r\n                \r\n                // 解析多语言标题\r\n                var titleData = hItem.get(\"sp_title\");\r\n                var titleText = \"\";\r\n                if (titleData != null) {\r\n                    var dataList = titleData.get(\"data\");\r\n                    if (dataList != null && dataList.size() > 0) {\r\n                        titleText = dataList.get(0).get(\"text\");\r\n                    }\r\n                }\r\n                subDocH.addElement(\"审批类型\", titleText);\r\n\r\n                // 解析多语言描述\r\n                var descData = hItem.get(\"sp_description\");\r\n                var descText = \"\";\r\n                if (descData != null) {\r\n                    var dataList = descData.get(\"data\");\r\n                    if (dataList != null && dataList.size() > 0) {\r\n                        descText = dataList.get(0).get(\"text\");\r\n                    }\r\n                }\r\n                subDocH.addElement(\"审批详情\", descText);\r\n                \r\n                $.form.saveFormDocument(subDocH, appId);\r\n            }\r\n        }\r\n\r\n        // --- 新增：假勤统计项 (sp_items) ---\r\n        var vacationSummary = \"\";\r\n        var otherSummary = \"\";\r\n        \r\n        if (sp_items != null && sp_items.size() > 0) {\r\n            for (var m = 0; m < sp_items.size(); m++) {\r\n                var item = sp_items.get(m);\r\n                var count = item.get(\"count\");\r\n                // 只有数量大于0才记录\r\n                if (count != null && parseInt(count) > 0) {\r\n                    var name = item.get(\"name\") || \"未知\";\r\n                    var duration = item.get(\"duration\") || 0;\r\n                    var timeType = item.get(\"time_type\"); // 0:天, 1:小时\r\n                    var typeCode = item.get(\"type\"); // 1:请假, 2:补卡, 3:出差...\r\n                    \r\n                    var durationVal = 0;\r\n                    var unitStr = \"\";\r\n                    \r\n                    if (timeType == 0) {\r\n                        durationVal = parseFloat((duration / 86400).toFixed(2));\r\n                        unitStr = \"天\";\r\n                    } else {\r\n                        durationVal = parseFloat((duration / 3600).toFixed(2));\r\n                        unitStr = \"小时\";\r\n                    }\r\n\r\n                    // 写入子表单：日报假勤统计\r\n                    var subDocS = $.form.createEmptyDocument(appId, \"日报假勤统计\"); // 确保有此子表单\r\n                    subDocS.addElement(\"关联日报ID\", adddoc.getId());\r\n                    subDocS.addElement(\"统计项名称\", name);\r\n                    subDocS.addElement(\"次数\", count);\r\n                    subDocS.addElement(\"时长\", durationVal);\r\n                    subDocS.addElement(\"单位\", unitStr);\r\n                    $.form.saveFormDocument(subDocS, appId);\r\n\r\n                    // 同时生成摘要字符串存入主表\r\n                    var infoStr = name + \":\" + durationVal + unitStr + \"(\" + count + \"次); \";\r\n                    if (typeCode == 1) {\r\n                        vacationSummary += infoStr;\r\n                    } else {\r\n                        otherSummary += infoStr;\r\n                    }\r\n                }\r\n            }\r\n        }\r\n        \r\n        adddoc.addElement(\"请假明细\", vacationSummary);\r\n        adddoc.addElement(\"其他考勤明细\", otherSummary);\r\n\r\n        // 保存主文档\r\n        $.form.saveFormDocument(adddoc, appId);\r\n    }\r\n\r\n    function getDateRange() {\r\n        var date = $.date.getCurrentDate();\r\n        // 开始时间：昨天 00:00:00\r\n        var startTime = Packages.java.util.Calendar.getInstance();\r\n        startTime.setTime(date);\r\n        startTime.add(Packages.java.util.Calendar.DATE, -1);\r\n        startTime.set(Packages.java.util.Calendar.HOUR_OF_DAY, 0);\r\n        startTime.set(Packages.java.util.Calendar.MINUTE, 0);\r\n        startTime.set(Packages.java.util.Calendar.SECOND, 0);\r\n        var sTime = startTime.getTime().getTime() / 1000;\r\n\r\n        // 结束时间：今天 23:59:59 (或者明天 00:00:00，视接口要求，通常包含当天即可)\r\n        // 这里取明天 00:00:00 以覆盖全天\r\n        var endTime = Packages.java.util.Calendar.getInstance();\r\n        endTime.setTime(date);\r\n        endTime.add(Packages.java.util.Calendar.DATE, 1);\r\n        endTime.set(Packages.java.util.Calendar.HOUR_OF_DAY, 0);\r\n        endTime.set(Packages.java.util.Calendar.MINUTE, 0);\r\n        endTime.set(Packages.java.util.Calendar.SECOND, 0);\r\n        var eTime = endTime.getTime().getTime() / 1000;\r\n\r\n        return { start: sTime, end: eTime };\r\n    }\r\n\r\n    function getAllUserAccounts(appId) {\r\n        var accountList = new Packages.java.util.ArrayList();\r\n        var userMap = new Packages.java.util.HashMap();\r\n        // 假设表单名为 \"员工信息维护\"，字段名为 \"姓名\" (需与实际一致)\r\n        // 注意：如果用户量大，建议直接用 $.contact.getAllUsers() 或类似接口，避免查表单慢\r\n        var userDocsList = $.form.getFormDocumentsByFieldNameAndValue(appId, \"员工信息维护\", userMap);\r\n        \r\n        if (userDocsList != null && userDocsList.size() > 0) {\r\n            for (var i = 0; i < userDocsList.size(); i++) {\r\n                var doc = userDocsList.get(i);\r\n                // 尝试获取姓名，如果字段名不同请修改\r\n                var nameElem = doc.getElementByName(\"姓名\"); \r\n                if (nameElem != null) {\r\n                    var userId = nameElem.getValue();\r\n                    var user = $.contact.getUserById(userId);\r\n                    if (user != null) {\r\n                        var account = user.getAccount().toString();\r\n                        if (account && !accountList.contains(account)) {\r\n                            accountList.add(account);\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n        }\r\n        return accountList;\r\n    }\r\n\r\n    function getAccessToken() {\r\n        var corpid = \"ww221c0bad06436cb9\"; // 请确认此 ID 是否正确\r\n        var secret = \"dUJ_BzUJIhFxubMuBsLFy_jjSaLXsRqANNwySpYgRSs\"; // 请确认此 Secret 是否正确\r\n        var url = \"https://qyapi.weixin.qq.com/cgi-bin/gettoken\";\r\n        var params = new Packages.java.util.HashMap();\r\n        params.put(\"corpid\", corpid);\r\n        params.put(\"corpsecret\", secret);\r\n        var headers = new Packages.java.util.HashMap();\r\n        headers.put(\"Content-Type\", \"application/json;charset=UTF-8\");\r\n        \r\n        var response = $.httpclient.sendGet(url, params, headers);\r\n        var res = $.json.stringToJsonObject(response);\r\n        if (res.get(\"errcode\") == \"0\") {\r\n            return res.get(\"access_token\");\r\n        } else {\r\n            $.message.sendGeneralStationMessage(\"Token 错误\", res.get(\"errmsg\"), $.context.getCurrentUserId());\r\n            return null;\r\n        }\r\n    }\r\n\r\n    function sendRequestWithRetry(url, token, jsonStr, maxRetry) {\r\n        var dayParams = new Packages.java.util.HashMap();\r\n        dayParams.put(\"access_token\", token);\r\n        var dayHeaders = new Packages.java.util.HashMap();\r\n        dayHeaders.put(\"Content-Type\", \"application/json;charset=UTF-8\");\r\n\r\n        for (var i = 0; i < maxRetry; i++) {\r\n            var dayResponse = $.httpclient.sendPost(url, dayParams, dayHeaders, jsonStr);\r\n            var resCheck = $.json.stringToJsonObject(dayResponse);\r\n            \r\n            if (resCheck.get(\"errcode\") == \"42001\") {\r\n                // Token 过期，刷新后重试\r\n                $.message.sendGeneralStationMessage(\"提示\", \"Token 过期，正在刷新...\", $.context.getCurrentUserId());\r\n                var newToken = getAccessToken();\r\n                if (newToken) {\r\n                    dayParams.put(\"access_token\", newToken);\r\n                    continue; // 重试\r\n                } else {\r\n                    return null;\r\n                }\r\n            }\r\n            return dayResponse; // 成功或非 Token 错误，直接返回\r\n        }\r\n        return null;\r\n    }\r\n\r\n})();","createTime":1773235872481,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"ab6206ab0150486297d53d7599f73d57","id":"196851098639622144","modelCode":"","modelId":"c385d05c91f1425b9e032a40ff59c9ad","modelType":"PC_BUSINESS_DESIGN","namespace":"日报导入2.0","path":"考勤日报","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1773235872481,"versions":0.0}