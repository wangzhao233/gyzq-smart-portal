{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"中交路南-出差考勤管理","content":"(function () {\r\n    //获取当前用户\r\n    var user = $.context.getCurrentUser();\r\n    var doc = $.context.getCurrentDocument();\r\n    //应用Id\r\n    var applicationId = $.context.getCurrentApplicationId();\r\n\r\n    // var nowtime = $.date.getCurrentDate();//获取当前日期\r\n    // var format = \"yyyy-MM-01\";\r\n    // var nowtimestr = $.date.dateToString(nowtime, format);\r\n    // var salarymonth = $.date.stringToDate(nowtimestr, format);//本月第一天\r\n    // var time2 = salarymonth.setMonth(salarymonth.getMonth() + 1);//下一月第一天\r\n\r\n    var now = $.date.getCurrentDate();                   //当前日期     \r\n    // var nowDayOfWeek = now.getDay();         //今天本周的第几天     \r\n    // var nowDay = now.getDate();              //当前日     \r\n    var nowMonth = now.getMonth();           //当前月     \r\n    var nowYear = now.getYear() + 1900;\r\n    // var format = \"yyyy-MM-dd\";            //当前年 \r\n    var mongthdays = getMonthDays(nowYear, nowMonth);//本月天数\r\n\r\n    var monthstartdate = getMonthStartDate(nowYear, nowMonth);  //本月起始日期\r\n    var monthEndDate = getMonthEndDate(nowYear, nowMonth, mongthdays);//本月结束日期\r\n    // var yearstartdate = new Date(nowYear, 0, 1);   //本年第一天\r\n    // var yearenddate = new Date(nowYear, 11, 31);  //本年最后一天\r\n\r\n    //表单名称\r\n    var formName = \"外出审批单\";\r\n    //控件值键对\r\n    var filterParamList = new Packages.java.util.ArrayList();\r\n    var filterParam1 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"姓名\", \"eq\", user);\r\n    var filterParam2 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"申请日期\", \"ge\", monthstartdate);//大于等于\r\n    var filterParam3 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"申请日期\", \"le\", monthEndDate);//小于\r\n    filterParamList.add(filterParam1);\r\n    filterParamList.add(filterParam2);\r\n    filterParamList.add(filterParam3);\r\n    var docS = $.form.getDocumentsByFilterParam(applicationId, formName, filterParamList);\r\n\r\n\r\n    if (docS != null) {\r\n        if (docS.size() > 6 || docS.size() == 6) {\r\n            //获取默认校验信息集合\r\n            var message = $.validate.create();\r\n            message.addError(\"校验失败\");\r\n            //返回默认校验信息集合\r\n            return message;\r\n        } else {\r\n            return \"\";\r\n        }\r\n\r\n    }\r\n\r\n\r\n})()\r\n//获得本月的开始日期     \r\n(function getMonthStartDate(nowYear, nowMonth) {\r\n    var monthStartDate0 = new Date(nowYear, nowMonth, 1);\r\n    //转格式\r\n    var format = \"yyyy-MM-dd\";\r\n    //获取日期字符串\r\n    var dateStr = $.date.dateToString(monthStartDate0, format);\r\n    var monthStartDate = $.date.stringToDate(dateStr, format)\r\n    return monthStartDate;\r\n})()\r\n\r\n//获得本月的结束日期     \r\n(function getMonthEndDate(nowYear, nowMonth, mongthdays) {\r\n    var monthEndDate0 = new Date(nowYear, nowMonth, mongthdays);\r\n    //转格式\r\n    var format = \"yyyy-MM-dd\";\r\n    //获取日期字符串\r\n    var dateStr = $.date.dateToString(monthEndDate0, format);\r\n    var monthEndDate = $.date.stringToDate(dateStr, format)\r\n    return monthEndDate;\r\n})()\r\n\r\n//获取本月总共天数\r\n(function getMonthDays(nowYear, nowMonth) {\r\n\r\n    var endday = new Date(nowYear, nowMonth + 1, 0);\r\n\r\n    return endday.getDate();\r\n\r\n})()","createTime":1765854149000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"7058736797913079810","hiddenCode":"b8c32dfb9c5444158864177e51df58d7","id":"bab36aaca3b44b1f9c373139dc8ab3cf","modelCode":"","modelId":"a0ea9e7965ed40ea8100a9d76e9a7127","modelType":"PROCESS_DESIGN","namespace":"cd","path":"外出审批","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1765854149000,"versions":1.0}