{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"中交路南-出差考勤管理","content":"(function () {\r\n    // 修改：getdaydate 现在内部直接处理保存，返回 \"SUCCESS\" 表示完成\r\n    var result = getdaydate();\r\n    \r\n    if (result == \"SUCCESS\") {\r\n        $.log.info(\"所有批次数据处理完成\");\r\n    } else if (result) {\r\n        // 兼容旧逻辑：如果返回的是 JSON 字符串，尝试解析检查错误\r\n        try {\r\n            var res = $.json.stringToJsonObject(result);\r\n            if (res.get(\"errcode\") == \"42001\") {\r\n                if (typeof gettoken === 'function') {\r\n                    gettoken();\r\n                    result = getdaydate();\r\n                    res = $.json.stringToJsonObject(result);\r\n                }\r\n            }\r\n            if (res.get(\"errcode\") != 0 && res.get(\"errcode\") != null) {\r\n                $.log.error(\"微信接口返回错误: errcode=\" + res.get(\"errcode\") + \", errmsg=\" + res.get(\"errmsg\"));\r\n            }\r\n        } catch (e) {\r\n            // 非 JSON 格式忽略\r\n        }\r\n    }\r\n})();\r\n\r\nfunction getdaydate() {\r\n    /*当前应用id */\r\n    var appId = $.context.getCurrentApplicationId();\r\n    /*获取日报的开始时间和结束时间 */\r\n    var date = $.date.getCurrentDate();//获取当前日期\r\n    var startTime = Packages.java.util.Calendar.getInstance();\r\n    startTime.setTime(date);\r\n    startTime.add(Packages.java.util.Calendar.DATE, -1);\r\n    var start = startTime.getTime();//得到经过控制后的日期\r\n    var startStr = $.date.dateToString(start, \"yyyy-MM-dd\");\r\n    var startDate = $.date.stringToDate(startStr, \"yyyy-MM-dd\");\r\n    var sTime = startDate.getTime() / 1000;\r\n    // $.message.sendGeneralStationMessage(\"sTime\", sTime, $.context.getCurrentUserId());\r\n\r\n    var endTime = Packages.java.util.Calendar.getInstance();\r\n    endTime.setTime(date);\r\n    endTime.add(Packages.java.util.Calendar.DATE, 1);\r\n    var end = endTime.getTime();//得到经过控制后的日期\r\n    var endStr = $.date.dateToString(end, \"yyyy-MM-dd\");\r\n    var endDate = $.date.stringToDate(endStr, \"yyyy-MM-dd\");\r\n    var eTime = endDate.getTime() / 1000;\r\n    // $.message.sendGeneralStationMessage(\"eTime\", eTime, $.context.getCurrentUserId());\r\n\r\n    /*获取员工信息表的所有员工账号集合 */\r\n    var accountList = new Packages.java.util.ArrayList();\r\n    var userMap = new Packages.java.util.HashMap();\r\n    var userDocsList = $.form.getFormDocumentsByFieldNameAndValue(appId, \"员工信息维护\", userMap);\r\n    \r\n    // 【修改点1】修复遍历逻辑：不再使用错误的分页计算，直接遍历所有数据\r\n    var totalSize = userDocsList != null ? userDocsList.size() : 0;\r\n    $.log.info(\"[调试] 读取到员工总数: \" + totalSize);\r\n\r\n    if (totalSize > 0) {\r\n        for (var f = 0; f < totalSize; f++) {\r\n            try {\r\n                var userId = userDocsList.get(f).getElementByName(\"姓名\").getValue();\r\n                if (userId == null || userId.toString().trim() == \"\") continue;\r\n                \r\n                var user = $.contact.getUserById(userId);\r\n                if (user != null) {\r\n                    var account = user.getAccount().toString();\r\n                    if (accountList.contains(account) == false) {\r\n                        accountList.add(account);\r\n                    }\r\n                }\r\n            } catch (e) {\r\n                $.log.error(\"获取第 \" + f + \" 个员工账号失败: \" + e);\r\n            }\r\n        }\r\n    }\r\n\r\n    $.log.info(\"[调试] 最终获取唯一账号数: \" + accountList.size());\r\n    if (accountList.size() == 0) {\r\n        $.log.warn(\"没有获取到任何账号，跳过请求\");\r\n        return \"SUCCESS\";\r\n    }\r\n\r\n    /* 获取token (只需获取一次) */\r\n    var corpid = \"ww221c0bad06436cb9\";//企业id\r\n    var secret = \"dUJ_BzUJIhFxubMuBsLFy_jjSaLXsRqANNwySpYgRSs\";//打卡应用密钥\r\n    var url = \"https://qyapi.weixin.qq.com/cgi-bin/gettoken\";\r\n    var params = new Packages.java.util.HashMap();\r\n    params.put(\"corpid\", corpid);\r\n    params.put(\"corpsecret\", secret);\r\n    var headers = new Packages.java.util.HashMap();\r\n    headers.put(\"Content-Type\", \"application/json;charset=UTF-8\");\r\n    var response = $.httpclient.sendGet(url, params, headers);\r\n    var res = $.json.stringToJsonObject(response);\r\n    var token = res.get(\"access_token\");\r\n\r\n    if (!token) {\r\n        $.log.error(\"获取 Token 失败: \" + response);\r\n        return response;\r\n    }\r\n\r\n    /* 【修改点2】分批获取日报并保存 */\r\n    var batchSize = 100; // 微信限制最多100人\r\n    var totalBatches = Math.ceil(accountList.size() / batchSize);\r\n    var dayUrl = \"https://qyapi.weixin.qq.com/cgi-bin/checkin/getcheckin_daydata\";\r\n    var dayParams = new Packages.java.util.HashMap();\r\n    dayParams.put(\"access_token\", token);\r\n    var dayHeaders = new Packages.java.util.HashMap();\r\n    dayHeaders.put(\"Content-Type\", \"application/json;charset=UTF-8\");\r\n\r\n    $.log.info(\"[调试] 开始分批请求，共 \" + totalBatches + \" 批\");\r\n\r\n    for (var i = 0; i < totalBatches; i++) {\r\n        var startIdx = i * batchSize;\r\n        var endIdx = Math.min((i + 1) * batchSize, accountList.size());\r\n        \r\n        // 构建当前批次的列表\r\n        var currentBatchList = new Packages.java.util.ArrayList();\r\n        for (var k = startIdx; k < endIdx; k++) {\r\n            currentBatchList.add(accountList.get(k));\r\n        }\r\n\r\n        $.log.info(\"[调试] 请求第 \" + (i + 1) + \"/\" + totalBatches + \" 批，人数: \" + currentBatchList.size());\r\n\r\n        var json = {\r\n            \"starttime\": sTime,\r\n            \"endtime\": eTime,\r\n            \"useridlist\": currentBatchList\r\n        };\r\n\r\n        var jsonStr = $.json.objectToJsonString(json);\r\n        // $.message.sendGeneralStationMessage(\"jsonStr_batch_\" + i, jsonStr, $.context.getCurrentUserId());\r\n        \r\n        var dayResponse = $.httpclient.sendPost(dayUrl, dayParams, dayHeaders, jsonStr);\r\n        // $.message.sendGeneralStationMessage(\"dayResponse_batch_\" + i, dayResponse, $.context.getCurrentUserId());\r\n\r\n        // 解析并保存当前批次的数据\r\n        var batchRes = $.json.stringToJsonObject(dayResponse);\r\n        if (batchRes.get(\"errcode\") == 0) {\r\n            var dates = batchRes.get(\"datas\");\r\n            if (dates != null && dates.size() > 0) {\r\n                // 【复用您原有的保存逻辑】\r\n                for (var j = 0; j < dates.size(); j++) {\r\n                    var base_info = dates.get(j).get(\"base_info\");\r\n                    var summary_info = dates.get(j).get(\"summary_info\");\r\n                    var exception_infos = dates.get(j).get(\"exception_infos\");\r\n\r\n                    var adddoc = $.form.createEmptyDocument(appId, \"考勤日报\");\r\n                    adddoc.addElement(\"账号\", base_info.get(\"acctid\"))\r\n                    adddoc.addElement(\"姓名\", base_info.get(\"name\"))\r\n                    adddoc.addElement(\"日期\", base_info.get(\"date\") * 1000)\r\n                    adddoc.addElement(\"部门\", base_info.get(\"departs_name\"))\r\n                    \r\n                    // 防止空值报错\r\n                    var dayTypeVal = base_info.get(\"day_type\");\r\n                    if (dayTypeVal != null) {\r\n                        adddoc.addElement(\"日报类型\", (parseInt(dayTypeVal) + 1).toString())\r\n                    }\r\n                    \r\n                    if (summary_info != null) {\r\n                        adddoc.addElement(\"打卡次数\", summary_info.get(\"checkin_count\"))\r\n                        var regWork = summary_info.get(\"regular_work_sec\");\r\n                        var stdWork = summary_info.get(\"standard_work_sec\");\r\n                        if (regWork != null) adddoc.addElement(\"实际工作时长\", regWork / 3600)\r\n                        if (stdWork != null) adddoc.addElement(\"标准工作时长\", stdWork / 3600)\r\n                        \r\n                        var dateVal = base_info.get(\"date\");\r\n                        var earliest = summary_info.get(\"earliest_time\");\r\n                        var lastest = summary_info.get(\"lastest_time\");\r\n\r\n                        if (dateVal != null && earliest != null && earliest > 0) {\r\n                            adddoc.addElement(\"最早\", $.date.dateToString($.date.timestampToDate((dateVal * 1000) + (earliest * 1000)), \"HH:mm:ss\"));\r\n                        }\r\n                        if (dateVal != null && lastest != null && lastest > 0) {\r\n                            adddoc.addElement(\"最晚\", $.date.dateToString($.date.timestampToDate((dateVal * 1000) + (lastest * 1000)), \"HH:mm:ss\"));\r\n                        }\r\n                    }\r\n\r\n                    if (exception_infos != null && exception_infos.size() > 0) {\r\n                        for (var j1 = 0; j1 < exception_infos.size(); j1++) {\r\n                            var adddoc1 = $.form.createEmptyDocument(appId, \"日报异常记录\");\r\n                            adddoc1.addElement(\"关联日报\", adddoc.getId())\r\n                            adddoc1.addElement(\"异常类型\", exception_infos.get(j1).get(\"exception\").toString())\r\n                            adddoc1.addElement(\"异常次数\", exception_infos.get(j1).get(\"count\"))\r\n                            adddoc1.addElement(\"异常时长\", exception_infos.get(j1).get(\"duration\") / 3600)\r\n                            $.form.saveFormDocument(adddoc1, appId)\r\n                        }\r\n                    }\r\n\r\n                    if (exception_infos != null && exception_infos.size() > 0) {\r\n                        adddoc.addElement(\"状态\", \"2\");\r\n                        adddoc.addElement(\"申诉状态\", \"1\");\r\n                        $.form.saveFormDocument(adddoc, appId)\r\n                    } else {\r\n                        adddoc.addElement(\"状态\", \"1\")\r\n                        adddoc.addElement(\"申诉状态\", \"2\");\r\n                        $.form.saveFormDocument(adddoc, appId)\r\n                    }\r\n                    // 原代码最后多了一次 save，这里保留逻辑但避免重复保存导致的潜在问题，通常一次即可\r\n                    // $.form.saveFormDocument(adddoc, appId) \r\n                }\r\n                $.log.info(\"[调试] 第 \" + (i + 1) + \" 批保存完成，条数: \" + dates.size());\r\n            }\r\n        } else {\r\n            $.log.error(\"第 \" + (i + 1) + \" 批请求失败: \" + batchRes.get(\"errmsg\"));\r\n        }\r\n    }\r\n\r\n    return \"SUCCESS\";\r\n}","createTime":1773238372000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"04e282c46950492884171088c1815ce2","id":"a4a9962071464097b284a0d898c27fd5","modelCode":"","modelId":"c385d05c91f1425b9e032a40ff59c9ad","modelType":"PC_BUSINESS_DESIGN","namespace":"cd","path":"考勤日报","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1773239410636,"versions":0.0}