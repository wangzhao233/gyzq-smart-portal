{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"中交路南-出差考勤管理","content":"(function () {\r\n    //获取当前用户\r\n    // var user = $.context.getCurrentUserId();\r\n    // var doc = $.context.getCurrentDocument();\r\n    //应用Id\r\n    var applicationId = $.context.getCurrentApplicationId();\r\n\r\n    /*获取月报的开始时间和结束时间 */\r\n    var date = $.date.getCurrentDate();//获取当前日期\r\n    var startTime = Packages.java.util.Calendar.getInstance();\r\n    startTime.setTime(date);\r\n    startTime.add(Packages.java.util.Calendar.DATE, -10);//上个月22号\r\n    var start = startTime.getTime();//得到经过控制后的日期\r\n    var startStr = $.date.dateToString(start, \"yyyy-MM-dd  hh:mm:ss\");\r\n    var startDate = $.date.stringToDate(startStr, \"yyyy-MM-dd  hh:mm:ss\");\r\n    var sTime = startDate.getTime() / 1000;\r\n    // $.message.sendGeneralStationMessage(\"startStr\", startStr, $.context.getCurrentUserId());\r\n    $.message.sendGeneralStationMessage(\"sTime\", sTime, $.context.getCurrentUserId());\r\n\r\n    var endTime = Packages.java.util.Calendar.getInstance();\r\n    endTime.setTime(date);\r\n    endTime.add(Packages.java.util.Calendar.DATE, 21);//本月23号\r\n    var end = endTime.getTime();//得到经过控制后的日期\r\n    var endStr = $.date.dateToString(end, \"yyyy-MM-dd hh:mm:ss\");\r\n    var endDate = $.date.stringToDate(endStr, \"yyyy-MM-dd hh:mm:ss\");\r\n    var eTime = endDate.getTime() / 1000;\r\n    // $.message.sendGeneralStationMessage(\"endStr\", endStr, $.context.getCurrentUserId());\r\n    $.message.sendGeneralStationMessage(\"eTime\", eTime, $.context.getCurrentUserId());\r\n\r\n    var endTime1 = Packages.java.util.Calendar.getInstance();\r\n    endTime1.setTime(date);\r\n    endTime1.add(Packages.java.util.Calendar.DATE, 22);//本月24号\r\n    var end1 = endTime1.getTime();//得到经过控制后的日期\r\n    var endStr1 = $.date.dateToString(end1, \"yyyy-MM-dd hh:mm:ss\");\r\n    var endDate1 = $.date.stringToDate(endStr1, \"yyyy-MM-dd hh:mm:ss\");\r\n    var eTime1 = endDate1.getTime() / 1000;\r\n    // $.message.sendGeneralStationMessage(\"endStr\", endStr, $.context.getCurrentUserId());\r\n    $.message.sendGeneralStationMessage(\"eTime1\", eTime1, $.context.getCurrentUserId());\r\n    // var accountList = new Packages.java.util.ArrayList();\r\n    // var useridlist = new Packages.java.util.ArrayList();\r\n    // var userMap = new Packages.java.util.HashMap();\r\n    // var userDocsList = $.form.getFormDocumentsByFieldNameAndValue(applicationId, \"员工信息维护\", userMap);\r\n    // //构建URI\r\n    var useridlist = [];\r\n    var useridlist1 = [];\r\n    //查询人员名单表账号\r\n    var fieldMap = new Packages.java.util.HashMap();\r\n    var applicationId = $.context.getCurrentApplicationId();\r\n    //获取文档集合\r\n    var userDocsList = $.form.getFormDocumentsByFieldNameAndValue(applicationId, \"员工信息维护\", fieldMap);\r\n    var a = userDocsList.size();\r\n    if (a > 100) {\r\n        a = 100\r\n    }\r\n\r\n    if (userDocsList != null && userDocsList.size() > 0) {\r\n        for (var ii = 0; ii < a; ii++) {\r\n            // var doc2 = userDocsList.getId();\r\n            var zh = userDocsList.get(ii).getElementByName(\"账号\").getValue();\r\n            useridlist.push(doc2);\r\n            useridlist1.push(zh)\r\n\r\n        }\r\n    }\r\n\r\n    for (var k = 0; k < userDocsList.size(); k++) {\r\n\r\n        //表单名称\r\n        var formName = \"考勤月报\";\r\n        //控件值键对\r\n        var filterParamList = new Packages.java.util.ArrayList();\r\n        var filterParam1 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"账号\", \"eq\", useridlist1[k]);\r\n        var filterParam2 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"开始日期\", \"ge\", startDate);//小于等于\r\n        // var filterParam3 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"开始日期\", \"lt\", eTime1);//大于\r\n        // var filterParam4 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"结束日期\", \"ge\", sTime);//小于等于\r\n        // var filterParam5 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"结束日期\", \"lt\", eTime1);//大于\r\n        filterParamList.add(filterParam1);\r\n        filterParamList.add(filterParam2);\r\n        // filterParamList.add(filterParam3);\r\n        // filterParamList.add(filterParam4);\r\n        // filterParamList.add(filterParam5);\r\n        var docS = $.form.getDocumentsByFilterParam(applicationId, formName, filterParamList);\r\n        $.message.sendGeneralStationMessage(\"2\", docS.size(), $.context.getCurrentUserId());\r\n\r\n        //表单名称\r\n        var formName1 = \"外出审批单\";\r\n        //控件值键对\r\n        var filterParamList1 = new Packages.java.util.ArrayList();\r\n        var filterParam1 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"姓名\", \"eq\", useridlist[k]);\r\n        var filterParam2 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"申请日期\", \"ge\", startDate);//大于等于\r\n        var filterParam3 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"申请日期\", \"lt\", endDate);//小于\r\n        filterParamList1.add(filterParam1);\r\n        filterParamList1.add(filterParam2);\r\n        filterParamList1.add(filterParam3);\r\n        var docS1 = $.form.getDocumentsByFilterParam(applicationId, formName1, filterParamList1);\r\n        $.message.sendGeneralStationMessage(\"1\", docS1.size(), $.context.getCurrentUserId())\r\n\r\n        if (docS != null && docS.size() > 0) {\r\n            var a = 0;\r\n            var b = 0;\r\n            $.message.sendGeneralStationMessage(\"1113\", \"a\", $.context.getCurrentUserId());\r\n\r\n            if (docS1 != null && docS1.size() > 0) {\r\n                $.message.sendGeneralStationMessage(\"3\", \"444444444\", $.context.getCurrentUserId());\r\n                for (var g = 0; g < docS1.size(); g++) {\r\n                    var wclx = docS1.get(g).getElementByName(\"外出类型\").getValue()\r\n                    $.message.sendGeneralStationMessage(\"3\", \"444444444\", $.context.getCurrentUserId());\r\n                    if (wclx == \"1\") {\r\n                        var wcday = docS1.get(g).getElementByName(\"外出天数\").getValue()\r\n                        a += wcday;\r\n                        // $.message.sendGeneralStationMessage(\"3\", \"444444444\", $.context.getCurrentUserId());\r\n                    }\r\n                    if (wclx == \"2\") {\r\n                        var wcday1 = docS1.get(g).getElementByName(\"外出天数\").getValue()\r\n                        b += wcday1;\r\n\r\n                        $.message.sendGeneralStationMessage(\"4\", b, $.context.getCurrentUserId());\r\n\r\n                    }\r\n                    docS.get(g).addElement(\"因公外出天数\", a)\r\n                    docS.get(g).addElement(\"因私外出天数\", b)\r\n                    $.form.saveFormDocument(docS.get(g), applicationId)\r\n\r\n                }\r\n\r\n\r\n            }\r\n            // docS.get(k).addElement(\"因公外出天数\", a)\r\n            // docS.get(k).addElement(\"因私外出天数\", b)\r\n            // $.form.saveFormDocument(docS.get(k), applicationId)\r\n\r\n\r\n        }\r\n\r\n\r\n    }\r\n\r\n})()\r\n","createTime":1765854149000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"a397d4b920324d9fad75922ce9bb7fa2","id":"d02351d200fc420187f319b16cc6af75","modelCode":"","modelId":"a2adf27408904b3e83cff0675b6cee9e","modelType":"PC_BUSINESS_DESIGN","namespace":"q","path":"考勤月报列表","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1765854149000,"versions":0.0}