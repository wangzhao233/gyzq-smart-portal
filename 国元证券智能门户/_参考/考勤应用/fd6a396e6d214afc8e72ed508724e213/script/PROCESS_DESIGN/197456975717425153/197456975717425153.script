{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"中交路南-出差考勤管理","content":"(function () {\r\n    // 1. 获取当前用户和应用信息\r\n    var user = $.context.getCurrentUserId();\r\n    var applicationId = $.context.getCurrentApplicationId();\r\n\r\n    // 2. 获取本年度时间范围\r\n    var now = $.date.getCurrentDate();\r\n    var nowYear = now.getYear() + 1900;\r\n    var yearstartdate = new Date(nowYear, 0, 1);\r\n    var yearenddate = new Date(nowYear, 11, 31);\r\n    var date = yearstartdate.getTime();\r\n    var date1 = yearenddate.getTime();\r\n\r\n    // 3. 设置查询条件\r\n    var formName = \"请假审批单\";\r\n    var filterParamList = new Packages.java.util.ArrayList();\r\n    \r\n    // 基本条件：当前用户的年假申请\r\n    var filterParam1 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"姓名\", \"eq\", user);\r\n    var filterParam2 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"休假类型\", \"eq\", \"1\"); // 年假类型\r\n    \r\n    // 修改点1：增加状态筛选，只统计\"已批准\"的请假\r\n    // 根据参考材料，审批通过的请假单状态可能显示为\"已关闭\"[4]\r\n    var filterParam5 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"审批状态\", \"eq\", \"已关闭\");\r\n    \r\n    // 时间范围筛选：本年度的申请\r\n    var filterParam3 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"申请日期\", \"ge\", date); // 大于等于\r\n    var filterParam4 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"申请日期\", \"lt\", date1); // 小于\r\n    \r\n    filterParamList.add(filterParam1);\r\n    filterParamList.add(filterParam2);\r\n    filterParamList.add(filterParam5); // 添加状态筛选\r\n    filterParamList.add(filterParam3);\r\n    filterParamList.add(filterParam4);\r\n    \r\n    // 4. 查询符合条件的请假单\r\n    var docS = $.form.getDocumentsByFilterParam(applicationId, formName, filterParamList);\r\n\r\n    // 修改点3：增加空数据检查\r\n    if (docS == null || docS.size() === 0) {\r\n        // 如果没有已批准的年假记录，直接允许提交\r\n        return \"\";\r\n    }\r\n\r\n    // 5. 计算已休年假天数（支持半天/小时精度）\r\n    var totalDays = 0;\r\n    var age = 0;\r\n    \r\n    for (var i = 0; i < docS.size(); i++) {\r\n        var doc = docS.get(i);\r\n        \r\n        // 修改点2：考虑半天/小时的休假精度\r\n        // 系统可能支持按小时或分钟计算时长[3]\r\n        var daysElement = doc.getElementByName(\"年假天数\");\r\n        if (daysElement != null && daysElement.getValue() != null) {\r\n            var daysValue = daysElement.getValue();\r\n            // 将值转换为数字（支持小数，如0.5天、2.5天等）\r\n            var days = parseFloat(daysValue);\r\n            if (!isNaN(days)) {\r\n                totalDays += days;\r\n            }\r\n        }\r\n        \r\n        // 从第一条记录获取工龄信息（首次循环时获取）\r\n        if (i === 0) {\r\n            var ageElement = doc.getElementByName(\"连续工龄\");\r\n            if (ageElement != null && ageElement.getValue() != null) {\r\n                age = parseInt(ageElement.getValue());\r\n            }\r\n        }\r\n    }\r\n    \r\n    // 6. 记录日志用于调试\r\n    $.message.sendGeneralStationMessage(\"年假统计\", \"用户\" + user + \"已休年假：\" + totalDays + \"天，工龄：\" + age + \"年\", user);\r\n\r\n    // 7. 根据工龄确定年假上限并验证\r\n    var annualLeaveLimit = 0;\r\n    \r\n    if (age > 0 && age <= 10) {\r\n        annualLeaveLimit = 5;\r\n    } else if (age > 10 && age <= 20) {\r\n        annualLeaveLimit = 10;\r\n    } else if (age > 20) {\r\n        annualLeaveLimit = 20;\r\n    } else {\r\n        // 工龄为空或0的情况\r\n        var message = $.validate.create();\r\n        message.addError(\"无法确定您的工龄，请检查'连续工龄'字段是否正确填写\");\r\n        return message;\r\n    }\r\n    \r\n    // 8. 验证是否超过限额（使用小数比较）\r\n    if (totalDays > annualLeaveLimit) {\r\n        var message = $.validate.create();\r\n        // 提供更详细的错误信息\r\n        var remainingDays = Math.max(0, annualLeaveLimit - totalDays).toFixed(1);\r\n        message.addError(\"提交失败，您本年已休年假\" + totalDays.toFixed(1) + \"天，超过\" + age + \"年工龄的\" + annualLeaveLimit + \"天限额。剩余可用天数：\" + remainingDays + \"天\");\r\n        return message;\r\n    } else {\r\n        // 计算剩余天数（可选，可以显示给用户）\r\n        var remainingDays = (annualLeaveLimit - totalDays).toFixed(1);\r\n        // 可以在此添加提示信息，但不会阻止提交\r\n        // var message = $.validate.create();\r\n        // message.addWarning(\"您本年剩余年假：\" + remainingDays + \"天\");\r\n        // return message;\r\n        return \"\";\r\n    }\r\n\r\n})();\r\n","createTime":1773800139000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"197456975717425155","hiddenCode":"8bc9a6d585e440d48a0a02a273277207","id":"197456975717425153","modelCode":"","modelId":"d881630bffca4c4397a6fe984e98f5c4","modelType":"PROCESS_DESIGN","namespace":"cd","path":"请假审批","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1773800139000,"versions":1.0}