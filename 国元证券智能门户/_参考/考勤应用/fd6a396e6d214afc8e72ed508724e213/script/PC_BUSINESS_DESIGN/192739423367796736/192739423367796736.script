{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"考勤管理","content":"(function () {\n\tvar logger = \"updateUser:{}\";\n\t$.log.info(logger,\"start\");\n    var uri = \"http://ehr.jsthqc.com:9872/myehr/form/cardformInitData.action?swaggerUserCode=apiManage\";\n\tvar body = {\n            \"order\": \"asc\",\n            \"offset\": 0,\n            \"limit\": 100,\n            \"containerParam\": {},\n            \"paramsMap\": {},\n            \"requestParam\": {},\n            \"sortParams\": {},\n            \"filter\": {\n            \"EMPVEMPLOYEENEW_CNAME\": \"\",\n            \"EMPVEMPLOYEENEW_EMPCODE\": \"\",\n            \"_INTERVAIL_MIN_ORGVCOMPANYNEW_OPTIME\": \"\",\n            \"_INTERVAIL_MAX_ORGVCOMPANYNEW_OPTIME\": \"\",\n            \"EMPVEMPLOYEENEW_CERTNO\": \"\"\n            },\n            \"userIds\": null,\n            \"formId\": \"7447\",\n            \"isView\": null,\n            \"heightGrade\": []\n        };\n                    // 记录请求体\n    $.log.warn(\"请求体构造完成:{} \",JSON.stringify(body));\n    var headers = {\n        \"Content-Type\": \"application/json\"\n    };\n    $.log.warn(\"请求头:{} \", JSON.stringify(headers));\n    var reps = $.httpclient.sendPost(uri,null,headers,$.json.objectToJsonString(body));\n            // 记录原始响应字符串\n    var repsJson = $.json.stringToJsonObject(reps);\n    if (repsJson.total > 0) {\n        var rows = repsJson.rows;\n        for(var r = 0; r < 1; r++) {\n            $.log.info(logger, rows[r]);\n        }\n    }\n})()","createTime":1770197583000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"d9069c1d37004e029415bc3846d62cec","id":"192739423367796736","modelCode":"","modelId":"d37b5bf2704b4b3996edbbfdfbeaee74","modelType":"PC_BUSINESS_DESIGN","namespace":"updateUser","path":"员工信息","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1770198692020,"versions":0.0}