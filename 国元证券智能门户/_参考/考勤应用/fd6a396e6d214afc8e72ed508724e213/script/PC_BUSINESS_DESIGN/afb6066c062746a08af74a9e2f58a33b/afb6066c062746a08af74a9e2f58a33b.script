{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"【模】考勤管理","content":"(function () {\r\n    //应用Id\r\n    var applicationId = $.context.getCurrentApplicationId();\r\n\r\n    //获取本月度\r\n    var now1 = $.date.getCurrentDate();        //当前日期       \r\n    var nowMonth1 = now1.getMonth() - 1;           //当前月     \r\n    var nowYear1 = now1.getYear() + 1900;\r\n    var mongthdays1 = getMonthDays1(nowYear1, nowMonth1);//本月天数\r\n\r\n    var monthstartdate1 = getMonthStartDate1(nowYear1, nowMonth1);  //本月起始日期\r\n    var monthEndDate1 = getMonthEndDate1(nowYear1, nowMonth1, mongthdays1 + 22);//本月结束日期\r\n\r\n    var date = monthstartdate1.getTime();\r\n    var date1 = monthEndDate1.getTime();\r\n    // //接收用户id集合\r\n    // var receiveUserIds = $.context.getCurrentUserId();\r\n    // //发送站内信\r\n    // $.message.sendGeneralStationMessage(\"subject\", date, receiveUserIds);\r\n    // $.message.sendGeneralStationMessage(\"subject1\", date1, receiveUserIds);\r\n\r\n    /*获取员工信息表的所有员工账号集合 */\r\n    var accountList = new Packages.java.util.ArrayList();\r\n    var useridlist = new Packages.java.util.ArrayList();\r\n    var userMap = new Packages.java.util.HashMap();\r\n    var userDocsList = $.form.getFormDocumentsByFieldNameAndValue(applicationId, \"员工信息维护\", userMap);\r\n    // var sizenum = userDocsList.size();//170\r\n    var num = Math.ceil(userDocsList.size() / 100)//2\r\n    // var useridlist = [];\r\n    for (var s = 0; s < num; s++) {\r\n        var a = s * 100;\r\n        var b = (s + 1) * 100;\r\n\r\n        if (s == Number(num) - 1) {\r\n            var b = userDocsList.size() - a;\r\n            // $.message.sendGeneralStationMessage(\"44\", b, $.context.getCurrentUserId());\r\n        }\r\n\r\n        if (userDocsList != null && b > 0) {\r\n            for (var f = a; f < b; f++) {\r\n                var userId = userDocsList.get(f).getElementByName(\"姓名\").getValue();\r\n                var user = $.contact.getUserById(userId);\r\n                useridlist.add(userId);\r\n                if (user != null) {\r\n                    var account = user.getAccount().toString();\r\n                    if (accountList.contains(account) == false) {\r\n                        accountList.add(account);\r\n                    }\r\n                }\r\n            }\r\n        }\r\n        if (accountList != null && accountList.size() > 0) {\r\n            for (var k = 0; k < accountList.size(); k++) {\r\n\r\n                //表单名称\r\n                var formName = \"考勤月报\";\r\n                //控件值键对\r\n                var filterParamList = new Packages.java.util.ArrayList();\r\n                var filterParam1 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"账号\", \"eq\", accountList.get(k));\r\n                var filterParam2 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"开始日期\", \"ge\", date);//小于等于\r\n                // var filterParam3 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"开始日期\", \"lt\", eTime1);//大于\r\n                // var filterParam4 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"结束日期\", \"ge\", sTime);//小于等于\r\n                // var filterParam5 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"结束日期\", \"lt\", eTime1);//大于\r\n                filterParamList.add(filterParam1);\r\n                filterParamList.add(filterParam2);\r\n                // filterParamList.add(filterParam3);\r\n                // filterParamList.add(filterParam4);\r\n                // filterParamList.add(filterParam5);\r\n                var docS = $.form.getDocumentsByFilterParam(applicationId, formName, filterParamList);\r\n                $.message.sendGeneralStationMessage(\"2\", docS.size(), $.context.getCurrentUserId());//1\r\n\r\n\r\n                //表单名称\r\n                var formName2 = \"出差审批表\";\r\n                //控件值键对\r\n                var filterParamList2 = new Packages.java.util.ArrayList();\r\n                var filterParam1 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"姓名\", \"eq\", useridlist.get(k));\r\n                var filterParam2 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"申请日期\", \"ge\", date);//大于等于\r\n                var filterParam3 = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\"申请日期\", \"lt\", date1);//小于\r\n                filterParamList2.add(filterParam1);\r\n                filterParamList2.add(filterParam2);\r\n                filterParamList2.add(filterParam3);\r\n                var docS2 = $.form.getDocumentsByFilterParam(applicationId, formName2, filterParamList2);\r\n                if (docS != null && docS.size() > 0) {\r\n                    var c = 0;\r\n\r\n                    if (docS2 != null && docS2.size() > 0) {\r\n                        for (var q = 0; q < docS2.size(); q++) {\r\n                            var ccday = docS2.get(q).getElementByName(\"出差天数\").getValue();\r\n                            c += Number(ccday);\r\n                        }\r\n                        docS.get(0).addElement(\"出差天数\", c);\r\n                        $.form.saveFormDocument(docS.get(0), applicationId);\r\n\r\n                    }\r\n\r\n                }\r\n\r\n\r\n            }\r\n\r\n        }\r\n    }\r\n\r\n\r\n})()\r\n//获得本月的开始日期     \r\nfunction getMonthStartDate1(nowYear1, nowMonth1) {\r\n    var monthStartDate0 = new Date(nowYear1, nowMonth1, 22);\r\n    //转格式\r\n    var format = \"yyyy-MM-dd\";\r\n    //获取日期字符串\r\n    var dateStr = $.date.dateToString(monthStartDate0, format);\r\n    var monthStartDate = $.date.stringToDate(dateStr, format)\r\n    return monthStartDate;\r\n}\r\n\r\n//获得本月的结束日期     \r\nfunction getMonthEndDate1(nowYear1, nowMonth1, mongthdays1) {\r\n    var monthEndDate0 = new Date(nowYear1, nowMonth1, mongthdays1);\r\n    //转格式\r\n    var format = \"yyyy-MM-dd\";\r\n    //获取日期字符串\r\n    var dateStr = $.date.dateToString(monthEndDate0, format);\r\n    var monthEndDate = $.date.stringToDate(dateStr, format)\r\n    return monthEndDate;\r\n}\r\n\r\n//获取本月总共天数\r\nfunction getMonthDays1(nowYear1, nowMonth1) {\r\n\r\n    var endday = new Date(nowYear1, nowMonth1 + 1, 0);\r\n\r\n    return endday.getDate();\r\n\r\n} ","createTime":1765854149000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"fa5d5ddcb59c4cc191e75987f467af09","id":"afb6066c062746a08af74a9e2f58a33b","modelCode":"","modelId":"a2adf27408904b3e83cff0675b6cee9e","modelType":"PC_BUSINESS_DESIGN","namespace":"2","path":"考勤月报","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1765854149000,"versions":0.0}