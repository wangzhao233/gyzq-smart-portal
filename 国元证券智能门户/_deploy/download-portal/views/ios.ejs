<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>国元元信 · iOS 下载</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <div class="header">
      <div class="logo">元</div>
      <h1>国元元信 · iOS 下载</h1>
    </div>

    <% if (qrDataUrl) { %>
      <div class="card">
        <div class="qr-section">
          <img src="<%= qrDataUrl %>" alt="兑换二维码">
          <p class="hint">请使用 iPhone 相机扫描兑换</p>
        </div>
      </div>

      <div class="card">
        <h2>使用步骤</h2>
        <ol class="steps">
          <li>
            <span class="step-num">1</span>
            <span>使用 iPhone 相机扫描二维码</span>
          </li>
          <li>
            <span class="step-num">2</span>
            <span>跳转后自动前往 App Store 兑换</span>
          </li>
          <li>
            <span class="step-num">3</span>
            <span>下载安装「国元元信」</span>
          </li>
          <li>
            <span class="step-num">4</span>
            <span>如遇问题，联系 IT 管理员</span>
          </li>
        </ol>
      </div>

      <div class="card" style="text-align:center">
        <p style="font-size:14px;color:#666">
          剩余兑换次数：<strong id="remain-count" style="color:#1F4E79;font-size:18px"><%= remaining %></strong>
        </p>
      </div>
    <% } else { %>
      <div class="card">
        <div class="error-page">
          <div class="icon">⚠</div>
          <h2>兑换码已用完</h2>
          <p>请联系管理员补充</p>
        </div>
      </div>
    <% } %>

    <div class="footer">道一云 · 国元证券智能门户项目</div>
  </div>

  <% if (qrDataUrl) { %>
  <script>
    setInterval(function() {
      var xhr = new XMLHttpRequest();
      xhr.open('GET', '/api/code/current', true);
      xhr.onload = function() {
        if (xhr.status === 200) {
          var data = JSON.parse(xhr.responseText);
          document.getElementById('remain-count').textContent = data.remaining;
        }
      };
      xhr.send();
    }, 30000);
  </script>
  <% } %>
</body>
</html>
