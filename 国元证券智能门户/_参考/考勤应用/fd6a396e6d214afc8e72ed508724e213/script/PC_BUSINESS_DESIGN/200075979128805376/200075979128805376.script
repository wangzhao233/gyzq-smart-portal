{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"考勤管理","content":"(function () {\r\n    var logger = \"importEhrEmployee:{}\";\r\n    $.log.info(logger, \"开始执行 EHR 员工数据导入\");\r\n\r\n    // === 第一步：调用 EHR 接口获取员工数据 ===\r\n    var uri = \"http://ehr.jsthqc.com:9872/myehr/form/cardformInitData.action?swaggerUserCode=apiManage\";\r\n    var body = {\r\n        \"order\": \"asc\",\r\n        \"offset\": \"0\",\r\n        \"limit\": \"5000\",\r\n        \"containerParam\": {},\r\n        \"paramsMap\": {},\r\n        \"requestParam\": {},\r\n        \"sortParams\": {},\r\n        \"filter\": {\r\n            \"EMPVEMPLOYEENEW_CNAME\": \"\",\r\n            \"EMPVEMPLOYEENEW_EMPCODE\": \"\",\r\n            \"_INTERVAIL_MIN_ORGVCOMPANYNEW_OPTIME\": \"\",\r\n            \"_INTERVAIL_MAX_ORGVCOMPANYNEW_OPTIME\": \"\",\r\n            \"EMPVEMPLOYEENEW_CERTNO\": \"\"\r\n        },\r\n        \"userIds\": null,\r\n        \"formId\": \"7447\",\r\n        \"isView\": null,\r\n        \"heightGrade\": []\r\n    };\r\n\r\n    var headers = { \"Content-Type\": \"application/json\" };\r\n    $.log.warn(\"准备请求 EHR 接口...\");\r\n\r\n    try {\r\n        var responseString = $.httpclient.sendPost(uri, null, headers, $.json.objectToJsonString(body));\r\n        $.log.warn(\"HTTP响应（原始字符串）: \" + responseString);\r\n\r\n        var repsJson = $.json.stringToJsonObject(responseString);\r\n        var total = repsJson.getInteger(\"total\");\r\n        var rows = repsJson.getJSONArray(\"rows\");\r\n\r\n        if (total == null || rows == null) {\r\n            $.log.error(\"EHR 接口返回格式异常：缺少 rows 或 total\");\r\n            return;\r\n        }\r\n\r\n        $.log.info(logger, \"成功获取 \" + rows.size() + \" 条员工数据\");\r\n\r\n        // === 第二步：准备写入目标表单 ===\r\n        var applicationId = $.context.getCurrentApplicationId();\r\n        var targetFormName = \"HRP账号信息\";\r\n        $.log.info(\"目标应用ID: \" + applicationId + \", 表单: \" + targetFormName);\r\n\r\n        var successCount = 0;\r\n        var errorCount = 0;\r\n        var updateCount = 0;\r\n        var addCount = 0;\r\n\r\n        // === 第三步：遍历 rows 并写入表单 ===\r\n        for (var i = 0; i < rows.size(); i++) {\r\n            try {\r\n                var emp = rows.getJSONObject(i);\r\n                $.log.info(\"--- 处理第 \" + (i + 1) + \" 条员工数据 ---\");\r\n\r\n                // 基础字段提取\r\n                var empCode = emp.getString(\"EMPVEMPLOYEENEW_EMPCODE\") || \"\";\r\n                var name = emp.getString(\"EMPVEMPLOYEENEW_CNAME\") || \"\";\r\n                var certNo = emp.getString(\"EMPVEMPLOYEENEW_CERTNO\") || \"\";\r\n                var mobile = emp.getString(\"EMPVEMPLOYEENEW_MOBILE\") || \"\";\r\n                var genderCode = emp.getString(\"EMPVEMPLOYEENEW_GENDER\") || \"\";\r\n                var deptName = emp.getString(\"EMPVEMPLOYEENEW_DEPNAME\") || \"\";\r\n                var jobName = emp.getString(\"EMPVEMPLOYEENEW_JOBNAME_DICTNAME\") || \"\";\r\n                var status = emp.getString(\"EMPVEMPLOYEENEW_EMPSTATUS_DICTNAME\") || \"\";\r\n                var joinDate = emp.getString(\"EMPVEMPLOYEENEW_JOINDATE\") || \"\";\r\n\r\n                // ===== 新增字段：参加工作日期 =====\r\n                var beginWorkDate = emp.getString(\"EMPVEMPLOYEENEW_BEGINWORKDATE\") || \"\";\r\n\r\n                // ===== 新增字段：到集团体系日期 =====\r\n                var groupDate = emp.getString(\"EMPVEMPLOYEENEW_STARTINGAGE_NEWDATE\") || \"\";\r\n\r\n                // ===== 新增字段：工龄 =====\r\n                var workYears = emp.getInteger(\"EMPVEMPLOYEENEW_WORKYEARS\");\r\n                if (workYears == null) {\r\n                    workYears = 0;\r\n                }\r\n\r\n                // 入职时间转时间戳\r\n                var joinTimestamp = null;\r\n                if (joinDate && joinDate.trim() !== \"\") {\r\n                    try {\r\n                        var dateObj = $.date.stringToDate(joinDate, \"yyyy-MM-dd\");\r\n                        if (dateObj) {\r\n                            joinTimestamp = dateObj.getTime();\r\n                        }\r\n                    } catch (ex) {\r\n                        $.log.warn(\"入职时间格式异常: \" + joinDate);\r\n                    }\r\n                }\r\n\r\n                // 性别转换\r\n                var genderText = \"未知\";\r\n                if (genderCode === \"1\") genderText = \"男\";\r\n                else if (genderCode === \"2\") genderText = \"女\";\r\n\r\n                // 当前时间戳\r\n                var currentDate = $.date.getCurrentDate();\r\n                var currentTimestamp = currentDate.getTime();\r\n\r\n                // 查询是否已有记录\r\n                var filterParamList = new Packages.java.util.ArrayList();\r\n                var filterParam = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\r\n                    \"工号\", \"eq\", empCode\r\n                );\r\n                filterParamList.add(filterParam);\r\n\r\n                var existingDocs = null;\r\n                try {\r\n                    existingDocs = $.form.getDocumentsByFilterParam(applicationId, targetFormName, filterParamList);\r\n                } catch (e) {\r\n                    $.log.error(\"查询员工记录失败：\" + e.message);\r\n                }\r\n\r\n                var newFormDoc = null;\r\n                if (existingDocs != null && existingDocs.size() > 0) {\r\n                    newFormDoc = existingDocs.get(0);\r\n                    $.log.info(\"员工[\" + empCode + \"]已存在，执行更新操作\");\r\n                    updateCount++;\r\n                } else {\r\n                    newFormDoc = $.form.createEmptyDocument(applicationId, targetFormName);\r\n                    $.log.info(\"员工[\" + empCode + \"]不存在，执行新增操作\");\r\n                    addCount++;\r\n                }\r\n\r\n                // ===== 写入所有字段 =====\r\n                newFormDoc.addElement(\"姓名\", name);\r\n                newFormDoc.addElement(\"工号\", empCode);\r\n                newFormDoc.addElement(\"身份证号\", certNo);\r\n                newFormDoc.addElement(\"手机号\", mobile);\r\n                newFormDoc.addElement(\"性别\", genderText);\r\n                newFormDoc.addElement(\"部门\", deptName);\r\n                newFormDoc.addElement(\"岗位\", jobName);\r\n                newFormDoc.addElement(\"在职状态\", status);\r\n                newFormDoc.addElement(\"入职时间\", joinDate);\r\n                newFormDoc.addElement(\"入职时间戳\", joinTimestamp);\r\n\r\n                // ===== 新增三个字段 =====\r\n                newFormDoc.addElement(\"参加工作日期\", beginWorkDate);\r\n                newFormDoc.addElement(\"到集团体系日期\", groupDate);\r\n                newFormDoc.addElement(\"工龄\", workYears);\r\n\r\n                newFormDoc.addElement(\"更新时间\", currentTimestamp);\r\n\r\n                // 保存\r\n                $.form.saveFormDocument(newFormDoc, applicationId);\r\n                $.log.info(\"员工 [\" + empCode + \"] \" + name + \" 处理成功\");\r\n                successCount++;\r\n\r\n            } catch (e) {\r\n                errorCount++;\r\n                $.log.error(\"处理第 \" + (i + 1) + \" 条数据失败: \" + e.toString());\r\n            }\r\n\r\n            // 进度提示\r\n            if ((i + 1) % 50 === 0) {\r\n                $.log.info(\"进度: \" + (i + 1) + \" / \" + rows.size());\r\n            }\r\n        }\r\n\r\n        // === 第四步：输出结果 ===\r\n        var msg = \"EHR 员工数据导入完成。新增: \" + addCount + \"，更新: \" + updateCount + \"，失败: \" + errorCount;\r\n        $.log.info(\"=== \" + msg + \" ===\");\r\n        if (errorCount > 0) {\r\n            $.log.warn(\"有失败项，请检查日志\");\r\n        } else {\r\n            $.log.info(\"处理完成！\");\r\n        }\r\n\r\n    } catch (e) {\r\n        $.log.error(\"脚本执行异常: \" + e.toString());\r\n    }\r\n\r\n    $.log.info(logger, \"函数执行结束\");\r\n})();\r\n","createTime":1776239276195,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"f16f9f0627c14d6f96fd864dea71effa","id":"200075979128805376","modelCode":"","modelId":"6983f126b67b7338f277bf5e","modelType":"PC_BUSINESS_DESIGN","namespace":"0415修改","path":"HRP账号信息列表","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1776239276195,"versions":0.0}