{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"考勤管理","content":"(function () {\r\n    // 1. 获取当前应用ID和所有用户信息\r\n    var applicationId = $.context.getCurrentApplicationId();\r\n    $.log.info(\"=== 开始执行人员信息增量导入脚本 ===\");\r\n    $.log.info(\"当前应用ID: \" + applicationId);\r\n\r\n    var allUsers = $.contact.queryAllUser(); // 获取通讯录全部用户\r\n    $.log.info(\"获取到通讯录用户总数: \" + allUsers.size());\r\n\r\n    var targetFormName = \"人员信息导入表\"; // 目标表单名称\r\n    $.log.info(\"目标表单: \" + targetFormName);\r\n\r\n    var successCount = 0;    // 成功数（新增+更新）\r\n    var errorCount = 0;      // 失败数\r\n    var addCount = 0;        // 新增数\r\n    var updateCount = 0;     // 更新数\r\n\r\n    // 2. 遍历所有用户处理数据（增量同步）\r\n    $.log.info(\"=== 开始增量处理用户数据 ===\");\r\n\r\n    for (var i = 0; i < allUsers.size(); i++) {\r\n        try {\r\n            $.log.info(\"--- 处理第 \" + (i + 1) + \" 个用户 ---\");\r\n            var user = allUsers.get(i);\r\n            var userJson = $.json.objectToJsonObject(user);\r\n\r\n            // 3. 提取核心字段（保留你的规则：新增手机号，删除性别/微信id）\r\n            var userId = userJson.get(\"id\") || \"\";        // 用户ID（作为唯一标识）\r\n            var account = userJson.get(\"account\") || \"\";  // 账号\r\n            var userName = userJson.get(\"name\") || \"\";    // 姓名\r\n            var telephone = userJson.get(\"telephone\") || \"\"; // 手机号\r\n            var defaultDepartmentId = userJson.get(\"defaultDepartmentId\") || \"\"; // 默认部门ID\r\n            var defaultDepartmentName = userJson.get(\"defaultDepartmentName\") || \"\"; // 默认部门名称\r\n            var defaultDepartmentFullName = userJson.get(\"defaultDepartmentFullName\") || \"\"; // 默认部门全路径名称\r\n            var currentDate = $.date.getCurrentDate();\r\n            var currentTimestamp = currentDate.getTime(); // 当前时间戳      \r\n            var wxUserId = userJson.get(\"wxUserId\"); // 微信ID\r\n            $.log.info(\"微信ID: \" + wxUserId);\r\n\r\n            // 处理性别字段：gender为int类型，需要转换为文字 [4]\r\n            var genderCode = userJson.get(\"gender\");\r\n            $.log.info(\"性别代码原始值: \" + genderCode);\r\n\r\n            var genderText = \"未知\";\r\n            if (genderCode == 1) {\r\n                genderText = \"男\";\r\n            } else if (genderCode == 2) {\r\n                genderText = \"女\";\r\n            }      \r\n            $.log.info(\"性别转换结果: \" + genderText);\r\n            $.log.info(\"用户ID: \" + userId);\r\n            $.log.info(\"账号: \" + account);\r\n            $.log.info(\"姓名: \" + userName);\r\n            $.log.info(\"手机号: \" + telephone);\r\n            $.log.info(\"更新时间: \" + currentTimestamp);            \r\n\r\n            // 4. 增量核心：根据用户ID查询表单中是否已有该用户记录（唯一标识去重）\r\n            var filterParamList = new Packages.java.util.ArrayList();\r\n            var filterParam = new Packages.cn.com.do1.do1cloud.runtime.dto.FilterParam(\r\n                \"人员\", \"eq\", userId  // 表单中“人员”字段存储用户ID，作为唯一查询条件\r\n            );\r\n            filterParamList.add(filterParam);\r\n\r\n            var existingDocs = null;\r\n            try {\r\n                existingDocs = $.form.getDocumentsByFilterParam(applicationId, targetFormName, filterParamList);\r\n            } catch (e) {\r\n                throw new Error(\"查询用户已有记录失败：\" + e.message);\r\n            }\r\n\r\n            var newFormDoc = null;\r\n            if (existingDocs != null && existingDocs.size() > 0) {\r\n                // 4.1 已有记录 → 更新第一条记录\r\n                newFormDoc = existingDocs.get(0);\r\n                $.log.info(\"该用户已存在，执行更新操作\");\r\n                updateCount++;\r\n            } else {\r\n                // 4.2 无记录 → 新建记录\r\n                newFormDoc = $.form.createEmptyDocument(applicationId, targetFormName);\r\n                $.log.info(\"该用户不存在，执行新增操作\");\r\n                addCount++;\r\n            }\r\n\r\n            // 5. 为表单字段赋值（新增/更新通用）\r\n            newFormDoc.addElement(\"人员\", userId);\r\n            newFormDoc.addElement(\"人员单选\", userId);\r\n            newFormDoc.addElement(\"账号\", account);\r\n            newFormDoc.addElement(\"姓名\", userName);\r\n            newFormDoc.addElement(\"性别\", genderText); // 字段名“性别”需要确认\r\n            newFormDoc.addElement(\"手机号\", telephone);\r\n            newFormDoc.addElement(\"默认部门\", defaultDepartmentId);\r\n            newFormDoc.addElement(\"部门单选\", defaultDepartmentId);\r\n            newFormDoc.addElement(\"默认部门名称\", defaultDepartmentName);\r\n            newFormDoc.addElement(\"默认部门全路径名称\", defaultDepartmentFullName);\r\n            newFormDoc.addElement(\"微信id\", wxUserId);\r\n            newFormDoc.addElement(\"更新日期\", currentTimestamp);\r\n            // 6. 保存（新增/更新）表单文档\r\n            $.form.saveFormDocument(newFormDoc, applicationId);\r\n            $.log.info(\"✅ 第 \" + (i + 1) + \" 个用户处理成功（\" + (existingDocs.size() > 0 ? \"更新\" : \"新增\") + \"）\");\r\n            successCount++;\r\n\r\n        } catch (e) {\r\n            errorCount++;\r\n            $.log.error(\"❌ 处理第 \" + (i + 1) + \" 个用户时出错: \" + e.toString());\r\n            $.log.error(\"错误详情: \" + e.stack);\r\n        }\r\n\r\n        // 每处理10个用户输出进度\r\n        if ((i + 1) % 10 === 0) {\r\n            $.log.info(\"📊 处理进度: 已处理 \" + (i + 1) + \" / \" + allUsers.size() + \" 个用户\");\r\n        }\r\n    }\r\n\r\n    // 7. 输出增量同步统计结果\r\n    $.log.info(\"=== 增量同步执行结果 ===\");\r\n    $.log.info(\"📈 统计信息：\");\r\n    $.log.info(\"  - 通讯录总用户数: \" + allUsers.size());\r\n    $.log.info(\"  - 处理成功数: \" + successCount);\r\n    $.log.info(\"    ├─ 新增记录数: \" + addCount);\r\n    $.log.info(\"    └─ 更新记录数: \" + updateCount);\r\n    $.log.info(\"  - 处理失败数: \" + errorCount);\r\n\r\n    if (errorCount > 0) {\r\n        $.log.warn(\"⚠️ 有 \" + errorCount + \" 条记录处理失败，请检查日志中的错误信息\");\r\n    } else {\r\n        $.log.info(\"🎉 所有用户增量处理完成，无失败记录\");\r\n    }\r\n})();","createTime":1770277320000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"d5ee3e1d9bc04547b0edc2c721853a08","id":"193674377618638848","modelCode":"","modelId":"697084bf977c2a4716f11802","modelType":"PC_BUSINESS_DESIGN","namespace":"更新逻辑","path":"人员信息导入表列表","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1772006253995,"versions":0.0}