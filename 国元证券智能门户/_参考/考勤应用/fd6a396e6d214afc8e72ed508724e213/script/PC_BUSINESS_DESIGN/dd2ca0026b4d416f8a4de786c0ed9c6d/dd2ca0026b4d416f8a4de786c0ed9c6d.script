artdate)\r\n//             adddoc.addElement(\"结束日期\", monthEndDate)\r\n//             adddoc.addElement(\"部门\", base_info.get(\"departs_name\"))\r\n//             adddoc.addElement(\"应出勤天数\", summary_info.get(\"work_days\"))\r\n//             adddoc.addElement(\"实际出勤天数\", summary_info.get(\"regular_days\"))\r\n//             // adddoc.addElement(\"异常天数\", summary_info.get(\"except_days\"))\r\n//             adddoc.addElement(\"实际工作时长\", summary_info.get(\"regular_work_sec\") / 3600)\r\n//             adddoc.addElement(\"标准工作时长\", summary_info.get(\"standard_work_sec\") / 3600)\r\n//             if (sp_items != null && sp_items.size() > 0) {\r\n//                 for (var j1 = 0; j1 < sp_items.size(); j1++) {\r\n//                     var adddoc1 = $.form.createEmptyDocument(applicationId, \"月报假勤统计\");\r\n//                     adddoc1.addElement(\"关联月报\", adddoc.getId())\r\n//                     adddoc1.addElement(\"假勤类型\", (sp_items.get(j1).get(\"type\")).toString())\r\n//                     adddoc1.addElement(\"假勤次数\", sp_items.get(j1).get(\"count\"))\r\n//                     adddoc1.addElement(\"假勤时长\", sp_items.get(j1).get(\"duration\") / 3600)\r\n//                     adddoc1.addElement(\"统计项名称\", sp_items.get(j1).get(\"name\"))\r\n//                     $.form.saveFormDocument(adddoc1, applicationId)\r\n//                 }\r\n//             }\r\n//             if (exception_infos != null && exception_infos.size() > 0) {\r\n//                 for (var j2 = 0; j2 < exception_infos.size(); j2++) {\r\n//                     var adddoc2 = $.form.createEmptyDocument(applicationId, \"月报异常记录\");\r\n//                     adddoc2.addElement(\"关联月报\", adddoc.getId())\r\n//                     adddoc2.addElement(\"异常类型\", (exception_infos.get(j2).get(\"exception\")).toString())\r\n//                     adddoc2.addElement(\"异常次数\", exception_infos.get(j2).get(\"count\"))\r\n//                     adddoc2.addElement(\"异常时长\", exception_infos.get(j2).get(\"duration\") / 3600)\r\n//                     $.form.saveFormDocument(adddoc2, applicationId)\r\n//                 }\r\n//             }\r\n\r\n//             $.form.saveFormDocument(adddoc, applicationId)\r\n//         }\r\n//     }\r\n// })()\r\n// function getdaydate() {\r\n//     /*获取日报的开始时间和结束时间 */\r\n//     var date = $.date.getCurrentDate();//获取当前日期\r\n//     var startTime = Packages.java.util.Calendar.getInstance();\r\n//     startTime.setTime(date);\r\n//     startTime.add(Packages.java.util.Calendar.DATE, -9);\r\n//     var start = startTime.getTime();//得到经过控制后的日期\r\n//     var startStr = $.date.dateToString(start, \"yyyy-MM-dd\");\r\n//     var startDate = $.date.stringToDate(startStr, \"yyyy-MM-dd\");\r\n//     var sTime = startDate.getTime() / 1000;\r\n//     $.message.sendGeneralStationMessage(\"startStr\", startStr, $.context.getCurrentUserId());\r\n//     $.message.sendGeneralStationMessage(\"sTime\", sTime, $.context.getCurrentUserId());\r\n\r\n//     var endTime = Packages.java.util.Calendar.getInstance();\r\n//     endTime.setTime(date);\r\n//     endTime.add(Packages.java.util.Calendar.DATE, 22);\r\n//     var end = endTime.getTime();//得到经过控制后的日期\r\n//     var endStr = $.date.dateToString(end, \"yyyy-MM-dd\");\r\n//     var endDate = $.date.stringToDate(endStr, \"yyyy-MM-dd\");\r\n//     var eTime = endDate.getTime() / 1000;\r\n//     $.message.sendGeneralStationMessage(\"endStr\", endStr, $.context.getCurrentUserId());\r\n//     $.message.sendGeneralStationMessage(\"eTime\", eTime, $.context.getCurrentUserId());\r\n//     var doc = $.context.getCurrentDocument();\r\n//     /*当前应用id */\r\n//     var appId = $.context.getCurrentApplicationId();\r\n//     /*获取员工信息表的所有员工账号集合 */\r\n//     var accountList = new Packages.java.util.ArrayList();\r\n//     var userMap = new Packages.java.util.HashMap();\r\n//     var userDocsList = $.form.getFormDocumentsByFieldNameAndValue(appId, \"员工信息维护\", userMap);\r\n//     var b = userDocsList.size();\r\n//     if (b > 100) {\r\n//         b = 100\r\n//     }\r\n//     if (userDocsList != null && b > 0) {\r\n//         for (var a = 0; a < b; a++) {\r\n//             var userId = userDocsList.get(a).getElementByName(\"姓名\").getValue();\r\n//             var user = $.contact.getUserById(userId);\r\n//             if (user != null) {\r\n//                 var account = user.getAccount().toString();\r\n//                 if (accountList.contains(account) == false) {\r\n//                     accountList.add(account);\r\n//                 }\r\n\r\n//             }\r\n//         }\r\n//     }\r\n//     // $.message.sendGeneralStationMessage(\"accountList\", accountList, $.context.getCurrentUserId());\r\n//     //构建参数\r\n//     // var starttime = doc.getElementByName(\"开始时间\").getValue() / 1000;\r\n//     // var endtime = doc.getElementByName(\"结束时间\").getValue() / 1000;\r\n//     /* 获取token*/\r\n//     // var corpid = \"wwc1752ac659433e67\";//企业id\r\n//     // var secret = \"jBtKQfiIy1UcAg8pFyNQXkss5yMwsYncGFUMwimKS4Q\";//打卡应用密钥\r\n//     var corpid = \"ww69b1659f0df17cdf\";//企业id\r\n//     var secret = \"gM92_CTcLdDifxze7POX6zCfgm4Kac5vpekvFGyp6Ys\";//打卡应用密钥\r\n//     var url = \"https://qyapi.weixin.qq.com/cgi-bin/gettoken\";\r\n//     var params = new Packages.java.util.HashMap();\r\n//     params.put(\"corpid\", corpid);\r\n//     params.put(\"corpsecret\", secret);\r\n//     var headers = new Packages.java.util.HashMap();\r\n//     headers.put(\"Content-Type\", \"application/json;charset=UTF-8\");\r\n//     var response = $.httpclient.sendGet(url, params, headers);\r\n//     var res = $.json.stringToJsonObject(response);\r\n//     var token = res.get(\"access_token\");\r\n//     // $.message.sendGeneralStationMessage(\"token\", token, $.context.getCurrentUserId());\r\n\r\n//     /*获取日报 */\r\n//     var dayUrl = \"https://qyapi.weixin.qq.com/cgi-bin/checkin/getcheckin_daydata\";\r\n//     var dayParams = new Packages.java.util.HashMap();\r\n//     dayParams.put(\"access_token\", token);\r\n//     var dayHeaders = new Packages.java.util.HashMap();\r\n//     dayHeaders.put(\"Content-Type\", \"application/json;charset=UTF-8\");\r\n//     var json = {\r\n//         \"starttime\": sTime,\r\n//         \"endtime\": eTime,\r\n//         \"useridlist\": accountList\r\n//     }\r\n\r\n//     var jsonStr = $.json.objectToJsonString(json);\r\n//     $.message.sendGeneralStationMessage(\"jsonStr\", jsonStr, $.context.getCurrentUserId());\r\n//     var dayResponse = $.httpclient.sendPost(dayUrl, dayParams, dayHeaders, jsonStr);\r\n//     $.message.sendGeneralStationMessage(\"dayResponse\", dayResponse, $.context.getCurrentUserId());\r\n//     return dayResponse;\r\n//     // var dayRes = $.json.stringToJsonObject(dayResponse);\r\n// }\r\n// //获得本月的开始日期     \r\n// function getMonthStartDate(nowYear, nowMonth) {\r\n//     var monthStartDate0 = new Date(nowYear, nowMonth, 22);\r\n//     //转格式\r\n//     var format = \"yyyy-MM-dd\";\r\n//     //获取日期字符串\r\n//     var dateStr = $.date.dateToString(monthStartDate0, format);\r\n//     var monthStartDate = $.date.stringToDate(dateStr, format)\r\n//     return monthStartDate;\r\n// }\r\n\r\n// //获得本月的结束日期     \r\n// function getMonthEndDate(nowYear, nowMonth, mongthdays) {\r\n//     var monthEndDate0 = new Date(nowYear, nowMonth, mongthdays)\r\n//         ;\r\n//     //转格式\r\n//     var format = \"yyyy-MM-dd\";\r\n//     //获取日期字符串\r\n//     var dateStr = $.date.dateToString(monthEndDate0, format);\r\n//     var monthEndDate = $.date.stringToDate(dateStr, format)\r\n//     return monthEndDate;\r\n// }\r\n\r\n// //获取本月总共天数\r\n// function getMonthDays(nowYear, nowMonth) {\r\n\r\n//     var endday = new Date(nowYear, nowMonth + 1, 0);\r\n\r\n//     return endday.getDate();\r\n\r\n// } \r\n(function () {\r\n    //  var doc = $.context.getCurrentDocument();\r\n    var response = getdaydate();\r\n    var applicationId = $.context.getCurrentApplicationId();\r\n    var res = $.json.stringToJsonObject(response);\r\n    if (res.get(\"errcode\") == \"42001\") {\r\n        //如果token过期了\r\n        gettoken();\r\n        var response = getdaydate();\r\n        var res = $.json.stringToJsonObject(response);\r\n    }\r\n    //获取本月度\r\n    var now = $.date.getCurrentDate();        //当前日期       \r\n    var nowMonth = now.getMonth();           //当前月     \r\n    var nowYear = now.getYear() + 1900;\r\n    var mongthdays = getMonthDays(nowYear, nowMonth);//本月天数\r\n\r\n    var monthstartdate = getMonthStartDate(nowYear, nowMonth);  //本月起始日期\r\n    var monthEndDate = getMonthEndDate(nowYear, nowMonth, mongthdays + 23);//本月结束日期\r\n    var receiveUserIds = $.context.getCurrentUserId();\r\n    $.message.sendGeneralStationMessage(\"11\", monthstartdate, receiveUserIds);\r\n    $.message.sendGeneralStationMessage(\"13\", monthEndDate, receiveUserIds);\r\n \r\n\r\n    var dates = res.get(\"datas\");\r\n    if (dates != null && dates.size() > 0) {\r\n        for (var j = 0; j < dates.size(); j++) {\r\n            var base_info = dates.get(j).get(\"base_info\");\r\n            var summary_info = dates.get(j).get(\"summary_info\");\r\n            var overwork_info = dates.get(j).get(\"overwork_info\");\r\n            var sp_items = dates.get(j).get(\"sp_items\");\r\n            var exception_infos = dates.get(j).get(\"exception_infos\");\r\n            var adddoc = $.form.createEmptyDocument(applicationId, \"考勤月报\");\r\n            adddoc.addElement(\"账号\", base_info.get(\"acctid\"))\r\n            adddoc.addElement(\"姓名\", base_info.get(\"name\"))\r\n            adddoc.addElement(\"开始日期\", monthstartdate)\r\n            adddoc.addElement(\"结束日期\", monthEndDate)\r\n            adddoc.addElement(\"部门\", base_info.get(\"departs_name\"))\r\n            adddoc.addElement(\"应出勤天数\", summary_info.get(\"work_days\"))\r\n            adddoc.addElement(\"实际出勤天数\", summary_info.get(\"regular_days\"))\r\n            // adddoc.addElement(\"异常天数\", summary_info.get(\"except_days\"))\r\n            adddoc.addElement(\"实际工作时长\", summary_info.get(\"regular_work_sec\") / 3600)\r\n            adddoc.addElement(\"标准工作时长\", summary_info.get(\"standard_work_sec\") / 3600)\r\n            if (sp_items != null && sp_items.size() > 0) {\r\n                for (var j1 = 0; j1 < sp_items.size(); j1++) {\r\n                    var adddoc1 = $.form.createEmptyDocument(applicationId, \"月报假勤统计\");\r\n                    adddoc1.addElement(\"关联月报\", adddoc.getId())\r\n                    adddoc1.addElement(\"假勤类型\", (sp_items.get(j1).get(\"type\")).toString())\r\n                    adddoc1.addElement(\"假勤次数\", sp_items.get(j1).get(\"count\"))\r\n                    adddoc1.addElement(\"假勤时长\", sp_items.get(j1).get(\"duration\") / 3600)\r\n                    adddoc1.addElement(\"统计项名称\", sp_items.get(j1).get(\"name\"))\r\n                    $.form.saveFormDocument(adddoc1, applicationId)\r\n                }\r\n            }\r\n            if (exception_infos != null && exception_infos.size() > 0) {\r\n                for (var j2 = 0; j2 < exception_infos.size(); j2++) {\r\n                    var adddoc2 = $.form.createEmptyDocument(applicationId, \"月报异常记录\");\r\n                    adddoc2.addElement(\"关联月报\", adddoc.getId())\r\n                    adddoc2.addElement(\"异常类型\", (exception_infos.get(j2).get(\"exception\")).toString())\r\n                    adddoc2.addElement(\"异常次数\", exception_infos.get(j2).get(\"count\"))\r\n                    adddoc2.addElement(\"异常时长\", exception_infos.get(j2).get(\"duration\") / 3600)\r\n                    $.form.saveFormDocument(adddoc2, applicationId)\r\n                }\r\n            }\r\n\r\n            $.form.saveFormDocument(adddoc, applicationId)\r\n        }\r\n    }\r\n\r\n})()\r\nfunction getdaydate() {\r\n    /*当前应用id */\r\n    var appId = $.context.getCurrentApplicationId();\r\n    /*获取月报的开始时间和结束时间 */\r\n    var date = $.date.getCurrentDate();//获取当前日期\r\n    var startTime = Packages.java.util.Calendar.getInstance();\r\n    startTime.setTime(date);\r\n    startTime.add(Packages.java.util.Calendar.DATE, -9);//上个月22号\r\n    var start = startTime.getTime();//得到经过控制后的日期\r\n    var startStr = $.date.dateToString(start, \"yyyy-MM-dd\");\r\n    var startDate = $.date.stringToDate(startStr, \"yyyy-MM-dd\");\r\n    var sTime = startDate.getTime() / 1000;\r\n    // $.message.sendGeneralStationMessage(\"startStr\", startStr, $.context.getCurrentUserId());\r\n    $.message.sendGeneralStationMessage(\"sTime\", sTime, $.context.getCurrentUserId());\r\n\r\n    var endTime = Packages.java.util.Calendar.getInstance();\r\n    endTime.setTime(date);\r\n    endTime.add(Packages.java.util.Calendar.DATE, 22);//本月23号\r\n    var end = endTime.getTime();//得到经过控制后的日期\r\n    var endStr = $.date.dateToString(end, \"yyyy-MM-dd\");\r\n    var endDate = $.date.stringToDate(endStr, \"yyyy-MM-dd\");\r\n    var eTime = endDate.getTime() / 1000;\r\n    // $.message.sendGeneralStationMessage(\"endStr\", endStr, $.context.getCurrentUserId());\r\n    $.message.sendGeneralStationMessage(\"eTime\", eTime, $.context.getCurrentUserId());\r\n\r\n    /*获取员工信息表的所有员工账号集合 */\r\n    var accountList = new Packages.java.util.ArrayList();\r\n    var userMap = new Packages.java.util.HashMap();\r\n    var userDocsList = $.form.getFormDocumentsByFieldNameAndValue(appId, \"员工信息维护\", userMap);\r\n    // var sizenum = userDocsList.size();//170\r\n    var num = Math.ceil(userDocsList.size() / 100)//2\r\n\r\n    for (var s = 0; s < num; s++) {\r\n        var a = s * 100;\r\n        var b = (s + 1) * 100;\r\n        // $.message.sendGeneralStationMessage(\"11\", s, $.context.getCurrentUserId());\r\n        // $.message.sendGeneralStationMessage(\"22\", b, $.context.getCurrentUserId());\r\n        // $.message.sendGeneralStationMessage(\"33\", a, $.context.getCurrentUserId());\r\n        if (s == Number(num) - 1) {\r\n            var b = userDocsList.size() - a;\r\n            // $.message.sendGeneralStationMessage(\"44\", b, $.context.getCurrentUserId());\r\n        }\r\n\r\n        // $.message.sendGeneralStationMessage(\"66\", a, $.context.getCurrentUserId());\r\n        // $.message.sendGeneralStationMessage(\"55\", b, $.context.getCurrentUserId());\r\n        if (userDocsList != null && b > 0) {\r\n            for (var f = a; f < b; f++) {\r\n                var userId = userDocsList.get(f).getElementByName(\"姓名\").getValue();\r\n                var user = $.contact.getUserById(userId);\r\n                if (user != null) {\r\n                    var account = user.getAccount().toString();\r\n                    if (accountList.contains(account) == false) {\r\n                        accountList.add(account);\r\n                    }\r\n                }\r\n            }\r\n        }\r\n        /* 获取token*/\r\n        // var corpid = \"wwc1752ac659433e67\";//企业id\r\n        // var secret = \"jBtKQfiIy1UcAg8pFyNQXkss5yMwsYncGFUMwimKS4Q\";//打卡应用密钥\r\n        var corpid = \"ww69b1659f0df17cdf\";//企业id\r\n        var secret = \"gM92_CTcLdDifxze7POX6zCfgm4Kac5vpekvFGyp6Ys\";//打卡应用密钥\r\n        var url = \"https://qyapi.weixin.qq.com/cgi-bin/gettoken\";\r\n        var params = new Packages.java.util.HashMap();\r\n        params.put(\"corpid\", corpid);\r\n        params.put(\"corpsecret\", secret);\r\n        var headers = new Packages.java.util.HashMap();\r\n        headers.put(\"Content-Type\", \"application/json;charset=UTF-8\");\r\n        var response = $.httpclient.sendGet(url, params, headers);\r\n        var res = $.json.stringToJsonObject(response);\r\n        var token = res.get(\"access_token\");\r\n        // $.message.sendGeneralStationMessage(\"token\", token, $.context.getCurrentUserId());\r\n\r\n        /*获取月报 */\r\n        var dayUrl = \"https://qyapi.weixin.qq.com/cgi-bin/checkin/getcheckin_monthdata\";\r\n        var dayParams = new Packages.java.util.HashMap();\r\n        dayParams.put(\"access_token\", token);\r\n        var dayHeaders = new Packages.java.util.HashMap();\r\n        dayHeaders.put(\"Content-Type\", \"application/json;charset=UTF-8\");\r\n        var json = {\r\n            \"starttime\": sTime,\r\n            \"endtime\": eTime,\r\n            \"useridlist\": accountList\r\n        }\r\n\r\n        // var jsonStr = $.json.objectToJsonString(json);\r\n        // $.message.sendGeneralStationMessage(\"jsonStr\", jsonStr, $.context.getCurrentUserId());\r\n        // var dayResponse = $.httpclient.sendPost(dayUrl, dayParams, dayHeaders, jsonStr);\r\n        // $.message.sendGeneralStationMessage(\"dayResponse\", dayResponse, $.context.getCurrentUserId());\r\n        // return dayResponse;\r\n        // var dayRes = $.json.stringToJsonObject(dayResponse);\r\n    }\r\n\r\n    // $.message.sendGeneralStationMessage(\"accountList\", accountList, $.context.getCurrentUserId());\r\n    var jsonStr = $.json.objectToJsonString(json);\r\n    $.message.sendGeneralStationMessage(\"jsonStr\", jsonStr, $.context.getCurrentUserId());\r\n    var dayResponse = $.httpclient.sendPost(dayUrl, dayParams, dayHeaders, jsonStr);\r\n    $.message.sendGeneralStationMessage(\"dayResponse\", dayResponse, $.context.getCurrentUserId());\r\n    return dayResponse;\r\n}\r\n// 获得本月的开始日期     \r\nfunction getMonthStartDate(nowYear, nowMonth) {\r\n    var monthStartDate0 = new Date(nowYear, nowMonth, 22);\r\n    //转格式\r\n    var format = \"yyyy-MM-dd\";\r\n    //获取日期字符串\r\n    var dateStr = $.date.dateToString(monthStartDate0, format);\r\n    var monthStartDate = $.date.stringToDate(dateStr, format)\r\n    return monthStartDate;\r\n}\r\n\r\n//获得本月的结束日期     \r\nfunction getMonthEndDate(nowYear, nowMonth, mongthdays) {\r\n    var monthEndDate0 = new Date(nowYear, nowMonth, mongthdays)\r\n        ;\r\n    //转格式\r\n    var format = \"yyyy-MM-dd\";\r\n    //获取日期字符串\r\n    var dateStr = $.date.dateToString(monthEndDate0, format);\r\n    var monthEndDate = $.date.stringToDate(dateStr, format)\r\n    return monthEndDate;\r\n}\r\n\r\n//获取本月总共天数\r\nfunction getMonthDays(nowYear, nowMonth) {\r\n\r\n    var endday = new Date(nowYear, nowMonth + 1, 0);\r\n\r\n    return endday.getDate();\r\n\r\n} ","createTime":1765854149000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"5772e0cf167e44fb948211ec43e7236d","id":"dd2ca0026b4d416f8a4de786c0ed9c6d","modelCode":"","modelId":"a2adf27408904b3e83cff0675b6cee9e","modelType":"PC_BUSINESS_DESIGN","namespace":"w","path":"考勤月报列表","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1765854149000,"versions":0.0}