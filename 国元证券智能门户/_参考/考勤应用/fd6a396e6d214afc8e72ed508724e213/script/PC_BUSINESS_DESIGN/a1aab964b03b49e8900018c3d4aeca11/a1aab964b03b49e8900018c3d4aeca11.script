{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"中交路南项目1116","content":"(function () {\r\n    var doc = $.context.getCurrentDocument();\r\n    var applicationId = $.context.getCurrentApplicationId();\r\n    var originalDocument = $.context.getHttpRequest().getAttribute(\"姓名\");\r\n    // var name = originalDocument.getElementByName(\"姓名\").getValue();\r\n\r\n\r\n    var map = new Packages.java.util.HashMap();\r\n    map.put(\"级别\", originalDocument);\r\n    var formName = \"员工信息维护\";\r\n    var documents = $.form.getFormDocumentsByFieldNameAndValue(applicationId, formName, map);\r\n    // var docid = documents.getId();\r\n    if (documents != null) {\r\n        for (var j = 0; j = documents.size(); j++) {\r\n            var name1 = documents.get(j).getElementByName(\"姓名\").getValue();\r\n            if (originalDocument == name1) {\r\n                var jibie1 =  documents.get(j).getElementByName(\"级别\").getValue();\r\n                var form = doc.getForm();\r\n                var formFieldMap = form.getFormFieldMap();\r\n                var formField = formFieldMap.get(\"级别\");\r\n                var options = formField.getOptions();\r\n                for (var i = 0; i < options.size(); i++) {\r\n                    var option = options.get(i);\r\n                    var trueValue = option.getValue();//3\r\n                    if (jibie1 == trueValue) {\r\n                        var label1 = option.getLabel();//低\r\n                        // break;\r\n                    }\r\n                }\r\n            }\r\n\r\n        }\r\n    }\r\n\r\n    $.message.sendGeneralStationMessage(\"1\", label1, $.context.getCurrentUserId());\r\n    $.message.sendGeneralStationMessage(\"2\", originalDocument, $.context.getCurrentUserId());\r\n    // doc.addElement(\"级别\", label1);\r\n\r\n})()\r\n","createTime":1765854149000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"c2baf56251314978a446fe88d578d476","id":"a1aab964b03b49e8900018c3d4aeca11","modelCode":"","modelId":"fc4f3e3fb95e44a88245881625275c16","modelType":"PC_BUSINESS_DESIGN","namespace":"1","path":"出差审批表列表","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1765854149000,"versions":0.0}