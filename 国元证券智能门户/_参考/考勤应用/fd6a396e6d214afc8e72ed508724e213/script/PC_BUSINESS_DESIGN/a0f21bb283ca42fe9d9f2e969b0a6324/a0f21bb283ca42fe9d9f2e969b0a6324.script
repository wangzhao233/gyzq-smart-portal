{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"中交路南-出差考勤管理","content":"(function () {\r\n    /*当前应用id */\r\n    var appId = $.context.getCurrentApplicationId();\r\n    /*获取员工信息表的所有员工账号集合 */\r\n    var accountList = new Packages.java.util.ArrayList();\r\n    var userMap = new Packages.java.util.HashMap();\r\n    var userDocsList = $.form.getFormDocumentsByFieldNameAndValue(appId, \"员工信息维护\", userMap);\r\n    if (userDocsList != null && userDocsList.size() > 0) {\r\n        for (var a = 0; a < userDocsList.size(); a++) {\r\n            var userId = userDocsList.get(a).getElementByName(\"姓名\").getValue();\r\n            var user = $.contact.getUserById(userId);\r\n            if (user != null) {\r\n                var account = user.getAccount().toString();\r\n                if (accountList.contains(account) == false) {\r\n                    accountList.add(account);\r\n                }\r\n\r\n            }\r\n        }\r\n    }\r\n    // $.message.sendGeneralStationMessage(\"accountList\", accountList, $.context.getCurrentUserId());\r\n\r\n    /*获取日报的开始时间和结束时间 */\r\n    var date = $.date.getCurrentDate();//获取当前日期\r\n    var startTime = Packages.java.util.Calendar.getInstance();\r\n    startTime.setTime(date);\r\n    startTime.add(Packages.java.util.Calendar.DATE, -1);\r\n    var start = startTime.getTime();//得到经过控制后的日期\r\n    var startStr = $.date.dateToString(start, \"yyyy-MM-dd\");\r\n    var startDate = $.date.stringToDate(startStr, \"yyyy-MM-dd\");\r\n    var sTime = startDate.getTime() /1000;\r\n    // $.message.sendGeneralStationMessage(\"startStr\", startStr, $.context.getCurrentUserId());\r\n    $.message.sendGeneralStationMessage(\"sTime\", sTime, $.context.getCurrentUserId());\r\n\r\n    var endTime = Packages.java.util.Calendar.getInstance();\r\n    endTime.setTime(date);\r\n    endTime.add(Packages.java.util.Calendar.DATE, 1);\r\n    var end = endTime.getTime();//得到经过控制后的日期\r\n    var endStr = $.date.dateToString(end, \"yyyy-MM-dd\");\r\n    var endDate = $.date.stringToDate(endStr, \"yyyy-MM-dd\");\r\n    var eTime = endDate.getTime() /1000;\r\n    // $.message.sendGeneralStationMessage(\"endStr\", endStr, $.context.getCurrentUserId());\r\n    $.message.sendGeneralStationMessage(\"eTime\", eTime, $.context.getCurrentUserId());\r\n\r\n    /* 获取token*/\r\n    var corpid = \"wwc1752ac659433e67\";//企业id\r\n    var secret = \"jBtKQfiIy1UcAg8pFyNQXkss5yMwsYncGFUMwimKS4Q\";//打卡应用密钥\r\n    var url = \"https://qyapi.weixin.qq.com/cgi-bin/gettoken\";\r\n    var params = new Packages.java.util.HashMap();\r\n    params.put(\"corpid\", corpid);\r\n    params.put(\"corpsecret\", secret);\r\n    var headers = new Packages.java.util.HashMap();\r\n    headers.put(\"Content-Type\", \"application/json;charset=UTF-8\");\r\n    var response = $.httpclient.sendGet(url, params, headers);\r\n    var res = $.json.stringToJsonObject(response);\r\n    var token = res.get(\"access_token\");\r\n    // $.message.sendGeneralStationMessage(\"token\", token, $.context.getCurrentUserId());\r\n\r\n    /*获取日报 */\r\n    var dayUrl = \"https://qyapi.weixin.qq.com/cgi-bin/checkin/getcheckin_daydata\";\r\n    var dayParams = new Packages.java.util.HashMap();\r\n    dayParams.put(\"access_token\", token);\r\n    var dayHeaders = new Packages.java.util.HashMap();\r\n    dayHeaders.put(\"Content-Type\", \"application/json;charset=UTF-8\");\r\n    var json = {\r\n        \"starttime\": sTime,\r\n        \"endtime\": eTime,\r\n        \"useridlist\": accountList\r\n    }\r\n    var jsonStr = $.json.objectToJsonString(json);\r\n    $.message.sendGeneralStationMessage(\"jsonStr\", jsonStr, $.context.getCurrentUserId());\r\n    var dayResponse = $.httpclient.sendPost(dayUrl, dayParams, dayHeaders, jsonStr);\r\n    $.message.sendGeneralStationMessage(\"dayResponse\", dayResponse, $.context.getCurrentUserId());\r\n    // var dayRes = $.json.stringToJsonObject(dayResponse);\r\n\r\n})()\r\n","createTime":1765854149000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"59f96c738b6b4288997a6a477be4a8b6","id":"a0f21bb283ca42fe9d9f2e969b0a6324","modelCode":"","modelId":"c385d05c91f1425b9e032a40ff59c9ad","modelType":"PC_BUSINESS_DESIGN","namespace":"获取日报数据","path":"考勤日报列表","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1765854149000,"versions":0.0}