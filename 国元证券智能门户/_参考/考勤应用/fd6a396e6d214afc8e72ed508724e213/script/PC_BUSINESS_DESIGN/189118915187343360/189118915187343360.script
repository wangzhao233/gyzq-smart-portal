{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"【模】考勤管理","content":"(function () {\r\n    $.log.info(\"【开始执行】考勤日报同步任务\");\r\n\r\n    var appId = $.context.getCurrentApplicationId();\r\n    $.log.info(\"获取当前应用ID: {}\", appId);\r\n\r\n    // 1. 获取所有员工账号\r\n    $.log.info(\"开始获取员工信息维护表中的用户列表...\");\r\n    var accountList = getAllUserAccounts(appId);\r\n    $.log.info(\"成功获取员工账号数量: {}\", accountList.size());\r\n\r\n    if (accountList.size() === 0) {\r\n        $.log.warn(\"未找到任何有效员工账号，任务终止\");\r\n        return;\r\n    }\r\n\r\n    // 2. 获取 access_token\r\n    $.log.info(\"开始请求企业微信 access_token...\");\r\n    var token = getAccessToken();\r\n    if (!token) {\r\n        $.log.error(\"获取 access_token 失败，任务终止\");\r\n        return;\r\n    }\r\n    $.log.info(\"成功获取 access_token: {}...（已截断）\", token.substring(0, 10));\r\n\r\n    // 3. 获取考勤日报数据\r\n    $.log.info(\"开始调用企业微信 getcheckin_daydata 接口...\");\r\n    var response = getCheckinDayData(token, accountList);\r\n    $.log.info(\"原始响应内容: {}\", response);\r\n\r\n    var res = $.json.stringToJsonObject(response);\r\n    var errcode = res.get(\"errcode\");\r\n    var errmsg = res.get(\"errmsg\");\r\n\r\n    // 4. 处理 token 过期（42001）\r\n    if (errcode == \"42001\") {\r\n        $.log.warn(\"access_token 已过期，尝试重新获取...\");\r\n        token = getAccessToken();\r\n        if (!token) {\r\n            $.log.error(\"重新获取 token 失败，任务终止\");\r\n            return;\r\n        }\r\n        $.log.info(\"重新获取 token 成功，再次请求考勤数据...\");\r\n        response = getCheckinDayData(token, accountList);\r\n        res = $.json.stringToJsonObject(response);\r\n        errcode = res.get(\"errcode\");\r\n        errmsg = res.get(\"errmsg\");\r\n    }\r\n\r\n    // 5. 检查最终响应是否成功\r\n    if (errcode != 0 && errcode != \"0\") {\r\n        $.log.error(\"获取考勤日报失败 - errcode: {}, errmsg: {}\", errcode, errmsg);\r\n        return;\r\n    }\r\n\r\n    var dates = res.get(\"datas\");\r\n    if (dates == null || dates.size() === 0) {\r\n        $.log.warn(\"考勤数据为空，无记录需要处理\");\r\n        return;\r\n    }\r\n\r\n    $.log.info(\"成功获取考勤日报记录数: {}\", dates.size());\r\n\r\n    // 6. 写入主表和异常子表\r\n    for (var j = 0; j < dates.size(); j++) {\r\n        var base_info = dates.get(j).get(\"base_info\");\r\n        var summary_info = dates.get(j).get(\"summary_info\");\r\n        var exception_infos = dates.get(j).get(\"exception_infos\");\r\n\r\n        var acctid = base_info.get(\"acctid\");\r\n        var name = base_info.get(\"name\");\r\n        var dateStr = base_info.get(\"date\");\r\n        $.log.info(\"正在处理员工: {} (账号: {}), 日期: {}\", name, acctid, dateStr);\r\n\r\n        var adddoc = $.form.createEmptyDocument(appId, \"考勤日报\");\r\n        adddoc.addElement(\"账号\", acctid);\r\n        adddoc.addElement(\"姓名\", name);\r\n        adddoc.addElement(\"日期\", dateStr * 1000);\r\n        adddoc.addElement(\"部门\", base_info.get(\"departs_name\"));\r\n        adddoc.addElement(\"日报类型\", (parseInt(base_info.get(\"day_type\")) + 1).toString());\r\n        adddoc.addElement(\"打卡次数\", summary_info.get(\"checkin_count\"));\r\n        adddoc.addElement(\"实际工作时长\", summary_info.get(\"regular_work_sec\") / 3600);\r\n        adddoc.addElement(\"标准工作时长\", summary_info.get(\"standard_work_sec\") / 3600);\r\n        adddoc.addElement(\"最早\", $.date.dateToString($.date.timestampToDate((dateStr * 1000) + (summary_info.get(\"earliest_time\") * 1000)), \"HH:mm:ss\"));\r\n        adddoc.addElement(\"最晚\", $.date.dateToString($.date.timestampToDate((dateStr * 1000) + (summary_info.get(\"lastest_time\") * 1000)), \"HH:mm:ss\"));\r\n\r\n        var hasException = exception_infos != null && exception_infos.size() > 0;\r\n        if (hasException) {\r\n            adddoc.addElement(\"状态\", \"2\");\r\n            adddoc.addElement(\"申诉状态\", \"1\");\r\n            $.log.info(\"该记录存在 {} 条异常，将创建异常子记录\", exception_infos.size());\r\n            for (var j1 = 0; j1 < exception_infos.size(); j1++) {\r\n                var exc = exception_infos.get(j1);\r\n                var adddoc1 = $.form.createEmptyDocument(appId, \"日报异常记录\");\r\n                adddoc1.addElement(\"关联日报\", adddoc.getId());\r\n                adddoc1.addElement(\"异常类型\", exc.get(\"exception\").toString());\r\n                adddoc1.addElement(\"异常次数\", exc.get(\"count\"));\r\n                adddoc1.addElement(\"异常时长\", exc.get(\"duration\") / 3600);\r\n                $.form.saveFormDocument(adddoc1, appId);\r\n                $.log.debug(\"已保存异常记录: 类型={}, 次数={}\", exc.get(\"exception\"), exc.get(\"count\"));\r\n            }\r\n        } else {\r\n            adddoc.addElement(\"状态\", \"1\");\r\n            adddoc.addElement(\"申诉状态\", \"2\");\r\n            $.log.debug(\"该记录无异常\");\r\n        }\r\n\r\n        $.form.saveFormDocument(adddoc, appId);\r\n        $.log.info(\"已保存考勤日报主记录，ID: {}\", adddoc.getId());\r\n    }\r\n\r\n    $.log.info(\"【任务完成】共处理 {} 条考勤记录\", dates.size());\r\n})();\r\n\r\n// ==================== 工具函数（带日志）====================\r\n\r\nfunction getAllUserAccounts(appId) {\r\n    var userMap = new Packages.java.util.HashMap();\r\n    var userDocsList = $.form.getFormDocumentsByFieldNameAndValue(appId, \"员工信息维护\", userMap);\r\n    var accountList = new Packages.java.util.ArrayList();\r\n\r\n    $.log.debug(\"从'员工信息维护'表读取到文档数量: {}\", userDocsList.size());\r\n\r\n    for (var i = 0; i < userDocsList.size(); i++) {\r\n        try {\r\n            var doc = userDocsList.get(i);\r\n            var userId = doc.getElementByName(\"姓名\").getValue();\r\n            if (!userId || userId.trim() === \"\") {\r\n                $.log.debug(\"跳过空用户ID的记录\");\r\n                continue;\r\n            }\r\n            var user = $.contact.getUserById(userId);\r\n            if (user != null) {\r\n                var account = user.getAccount().toString();\r\n                if (!accountList.contains(account)) {\r\n                    accountList.add(account);\r\n                    $.log.debug(\"添加员工账号: {}\", account);\r\n                }\r\n            } else {\r\n                $.log.warn(\"无法通过用户ID {} 找到联系人\", userId);\r\n            }\r\n        } catch (e) {\r\n            $.log.error(\"处理第 {} 条员工记录时出错: {}\", i, e.message || e);\r\n        }\r\n    }\r\n    return accountList;\r\n}\r\n\r\nfunction getAccessToken() {\r\n    var corpid = \"ww221c0bad06436cb9\";\r\n    var corpsecret = \"dUJ_BzUJIhFxubMuBsLFy_jjSaLXsRqANNwySpYgRSs\";\r\n    var url = \"https://qyapi.weixin.qq.com/cgi-bin/gettoken\";\r\n    var params = new Packages.java.util.HashMap();\r\n    params.put(\"corpid\", corpid);\r\n    params.put(\"corpsecret\", corpsecret);\r\n    var headers = new Packages.java.util.HashMap();\r\n    headers.put(\"Content-Type\", \"application/json;charset=UTF-8\");\r\n\r\n    try {\r\n        var response = $.httpclient.sendGet(url, params, headers);\r\n        $.log.debug(\"Token 接口原始响应: {}\", response);\r\n        var res = $.json.stringToJsonObject(response);\r\n        if (res.get(\"errcode\") == 0) {\r\n            return res.get(\"access_token\");\r\n        } else {\r\n            $.log.error(\"获取 token 失败 - errcode: {}, errmsg: {}\", res.get(\"errcode\"), res.get(\"errmsg\"));\r\n            return null;\r\n        }\r\n    } catch (e) {\r\n        $.log.error(\"请求 token 时发生异常: {}\", e.message || e);\r\n        return null;\r\n    }\r\n}\r\n\r\nfunction getCheckinDayData(token, accountList) {\r\n    var now = $.date.getCurrentDate();\r\n    var cal = Packages.java.util.Calendar.getInstance();\r\n    \r\n    // 开始时间：昨天 00:00:00\r\n    cal.setTime(now);\r\n    cal.add(Packages.java.util.Calendar.DATE, -1);\r\n    cal.set(Packages.java.util.Calendar.HOUR_OF_DAY, 0);\r\n    cal.set(Packages.java.util.Calendar.MINUTE, 0);\r\n    cal.set(Packages.java.util.Calendar.SECOND, 0);\r\n    cal.set(Packages.java.util.Calendar.MILLISECOND, 0);\r\n    var startTimeSec = String(Math.floor(cal.getTime().getTime() / 1000));\r\n\r\n    // 结束时间：今天 23:59:59（或明天 00:00:00，但建议用今天结束）\r\n    cal.setTime(now);\r\n    cal.set(Packages.java.util.Calendar.HOUR_OF_DAY, 23);\r\n    cal.set(Packages.java.util.Calendar.MINUTE, 59);\r\n    cal.set(Packages.java.util.Calendar.SECOND, 59);\r\n    cal.set(Packages.java.util.Calendar.MILLISECOND, 999);\r\n    var endTimeSec = String(Math.floor(cal.getTime().getTime() / 1000));\r\n\r\n    $.log.debug(\"考勤查询时间范围（字符串）: {} ~ {}\", startTimeSec, endTimeSec);\r\n\r\n    var jsonBody = {\r\n        \"starttime\": startTimeSec,\r\n        \"endtime\": endTimeSec,\r\n        \"useridlist\": accountList\r\n    };\r\n\r\n    // 转为 Java List（如果平台要求）\r\n    var jsonBody = {\r\n        \"starttime\": startTimeSec,\r\n        \"endtime\": endTimeSec,\r\n        \"useridlist\": accountList\r\n    };\r\n\r\n    var url = \"https://qyapi.weixin.qq.com/cgi-bin/checkin/getcheckin_daydata\";\r\n    var params = new Packages.java.util.HashMap();\r\n    params.put(\"access_token\", token);\r\n    var headers = new Packages.java.util.HashMap();\r\n    headers.put(\"Content-Type\", \"application/json;charset=UTF-8\");\r\n    var jsonStr = $.json.objectToJsonString(jsonBody);\r\n\r\n    $.log.debug(\"请求考勤日报的 JSON 参数: {}\", jsonStr);\r\n\r\n    return $.httpclient.sendPost(url, params, headers, jsonStr);\r\n}","createTime":1766034715000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"b4eaab3e3df84e2f93cc66f1b7d3c731","id":"189118915187343360","modelCode":"","modelId":"c385d05c91f1425b9e032a40ff59c9ad","modelType":"PC_BUSINESS_DESIGN","namespace":"测试日志","path":"考勤日报","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1766049737065,"versions":0.0}