{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"中交路南-出差考勤管理","content":"(function () {\r\n    var doc = $.context.getCurrentDocument();\r\n    var applicationId = $.context.getCurrentApplicationId();\r\n    var name = doc.getElementByName(\"姓名\").getValue();\r\n\r\n\r\n    var map = new Packages.java.util.HashMap();\r\n    map.put(\"姓名\", name);\r\n    var formName = \"请假审批单\";\r\n    var documents = $.form.getFormDocumentsByFieldNameAndValue(applicationId, formName, map);\r\n    $.message.sendGeneralStationMessage(\"1\", documents, $.context.getCurrentUserId());\r\n    if (documents != null) {\r\n        var jibei = documents.get(0).getElementByName(\"休假种类\").getValue();\r\n        if (jibei == \"1\") {\r\n            var nianjia = documents.getElementByName(\"年假天数\").getValue();\r\n            return nianjia;\r\n        }else{\r\n            return \"0\"\r\n        }\r\n\r\n    } else {\r\n        return \"\";\r\n    }\r\n\r\n})()\r\n","createTime":1765854149000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"dd5a1629708c48a4b0b446fff500ab6d","id":"dc50d83e035e479ba87736c6b19fa3c5","modelCode":"","modelId":"b91d67a4bf904203a3ba3e0bb6ab1bee","modelType":"FORM_DESIGN","namespace":"111","path":"考勤月报","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1765854149000,"versions":0.0}