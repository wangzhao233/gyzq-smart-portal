{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"考勤管理","content":"(function () {\r\n    var applicationId = $.context.getCurrentApplicationId();\r\n    var response = getCheckinData();\r\n    var res = $.json.stringToJsonObject(response);\r\n    \r\n    // Token过期自动重新获取\r\n    if (res.get(\"errcode\") == 42001) {\r\n        getAccessToken(true);\r\n        response = getCheckinData();\r\n        res = $.json.stringToJsonObject(response);\r\n    }\r\n\r\n    // 同步打卡数据到表单\r\n    var checkinDataList = res.get(\"checkindata\");\r\n    if (checkinDataList != null && checkinDataList.size() > 0) {\r\n        for (var i = 0; i < checkinDataList.size(); i++) {\r\n            var record = checkinDataList.get(i);\r\n            var adddoc = $.form.createEmptyDocument(applicationId, \"原始记录打卡报表\");\r\n            \r\n            // 用户ID\r\n            var userid = record.get(\"userid\");\r\n            adddoc.addElement(\"用户id\", userid);\r\n            \r\n            // 姓名：通过用户ID获取后直接填入单行文本\r\n            var user = $.contact.getUserById(userid);\r\n            if (user != null) {\r\n                adddoc.addElement(\"姓名\", user.getName());\r\n            }\r\n            \r\n            // 规则组\r\n            adddoc.addElement(\"规则组\", record.get(\"groupname\"));\r\n            \r\n            // 打卡类型\r\n            adddoc.addElement(\"打卡类型\", record.get(\"checkin_type\"));\r\n            \r\n            // 异常类型\r\n            adddoc.addElement(\"异常类型\", record.get(\"exception_type\"));\r\n            \r\n            // 打卡时间：企微秒级时间戳转毫秒\r\n            var checkinTimeSeconds = record.get(\"checkin_time\");\r\n            var checkinTimeMillis = checkinTimeSeconds * 1000;\r\n            adddoc.addElement(\"打卡时间\", checkinTimeMillis);\r\n            \r\n            // 标准打卡时间：企微秒级时间戳转毫秒\r\n            var schCheckinTimeSeconds = record.get(\"sch_checkin_time\");\r\n            var schCheckinTimeMillis = schCheckinTimeSeconds * 1000;\r\n            adddoc.addElement(\"标准打卡时间\", schCheckinTimeMillis);\r\n            \r\n            // 地点标题\r\n            adddoc.addElement(\"地点标题\", record.get(\"location_title\"));\r\n            \r\n            // 地点详情\r\n            adddoc.addElement(\"地点详情\", record.get(\"location_detail\"));\r\n            \r\n            // WiFi名称\r\n            adddoc.addElement(\"wifi名称\", record.get(\"wifiname\"));\r\n            \r\n            // 备注\r\n            adddoc.addElement(\"备注\", record.get(\"notes\"));\r\n            \r\n            // 设备ID\r\n            adddoc.addElement(\"设备id\", record.get(\"deviceid\"));\r\n            \r\n            // 纬度（企微返回值/1000000）\r\n            var lat = record.get(\"lat\");\r\n            if (lat != null) {\r\n                adddoc.addElement(\"纬度\", lat / 1000000);\r\n            }\r\n            \r\n            // 经度（企微返回值/1000000）\r\n            var lng = record.get(\"lng\");\r\n            if (lng != null) {\r\n                adddoc.addElement(\"经度\", lng / 1000000);\r\n            }\r\n            \r\n            // 规则ID\r\n            adddoc.addElement(\"规则id\", record.get(\"groupid\"));\r\n            \r\n            // 时段ID\r\n            adddoc.addElement(\"时段id\", record.get(\"timeline_id\"));\r\n            \r\n            // 统计月份：格式为 \"YYYY-MM 第X周\"\r\n            var checkinDate = new Date(checkinTimeMillis);\r\n            var year = checkinDate.getFullYear();\r\n            var month = checkinDate.getMonth() + 1; // 月份从0开始，需+1\r\n            var day = checkinDate.getDate();\r\n            \r\n            // 计算当月第几周（以周一为一周起始）\r\n            var firstDayOfMonth = new Date(year, month - 1, 1);\r\n            var firstDayWeek = firstDayOfMonth.getDay(); // 0=周日, 1=周一, ..., 6=周六\r\n            var adjustedFirstDayWeek = firstDayWeek === 0 ? 7 : firstDayWeek; // 周日转为7\r\n            var weekNum = Math.ceil((day + adjustedFirstDayWeek - 1) / 7);\r\n            \r\n            // 拼接统计月份字符串\r\n            var monthStr = month < 10 ? \"0\" + month : month;\r\n            var statMonth = year + \"-\" + monthStr + \" 第\" + weekNum + \"周\";\r\n            adddoc.addElement(\"统计月份\", statMonth);\r\n            \r\n            // 保存表单文档\r\n            $.form.saveFormDocument(adddoc, applicationId);\r\n        }\r\n    }\r\n})();\r\n\r\n// 核心获取打卡数据函数，单次获取7天数据\r\nfunction getCheckinData() {\r\n    var appId = $.context.getCurrentApplicationId();\r\n    \r\n    // 时间范围：单次获取最近7天数据\r\n    var now = new Date();\r\n    var endTime = Math.floor(now.getTime() / 1000);\r\n    var startTime = endTime - 7 * 24 * 60 * 60; // 7天前的Unix时间戳（秒）\r\n    \r\n    // 获取员工列表\r\n    var accountList = new Packages.java.util.ArrayList();\r\n    var userDocsList = $.form.getFormDocumentsByFieldNameAndValue(appId, \"员工信息维护\", new Packages.java.util.HashMap());\r\n    \r\n    if (userDocsList != null && userDocsList.size() > 0) {\r\n        for (var i = 0; i < userDocsList.size(); i++) {\r\n            var userId = userDocsList.get(i).getElementByName(\"姓名\").getValue();\r\n            var user = $.contact.getUserById(userId);\r\n            if (user != null) {\r\n                var account = user.getAccount().toString();\r\n                if (!accountList.contains(account)) accountList.add(account);\r\n            }\r\n        }\r\n    }\r\n    \r\n    // 分批处理：每批100人\r\n    var batchSize = 100;\r\n    var totalBatches = Math.ceil(accountList.size() / batchSize);\r\n    var allCheckinData = [];\r\n    var token = getAccessToken();\r\n    \r\n    if (!token) return $.json.objectToJsonString({\"errcode\": -1, \"errmsg\": \"获取token失败\", \"checkindata\": []});\r\n    \r\n    for (var batch = 0; batch < totalBatches; batch++) {\r\n        var startIndex = batch * batchSize;\r\n        var endIndex = Math.min(startIndex + batchSize, accountList.size());\r\n        var batchUserList = new Packages.java.util.ArrayList();\r\n        \r\n        for (var j = startIndex; j < endIndex; j++) {\r\n            batchUserList.add(accountList.get(j));\r\n        }\r\n        \r\n        // 调用企微打卡接口\r\n        var url = \"https://qyapi.weixin.qq.com/cgi-bin/checkin/getcheckindata?access_token=\" + token;\r\n        var headers = new Packages.java.util.HashMap();\r\n        headers.put(\"Content-Type\", \"application/json;charset=UTF-8\");\r\n        \r\n        var json = {\r\n            \"opencheckindatatype\": 3,\r\n            \"starttime\": startTime,\r\n            \"endtime\": endTime,\r\n            \"useridlist\": batchUserList\r\n        };\r\n        \r\n        var jsonStr = $.json.objectToJsonString(json);\r\n        var response = $.httpclient.sendPost(url, new Packages.java.util.HashMap(), headers, jsonStr);\r\n        var res = $.json.stringToJsonObject(response);\r\n        \r\n        // 收集当前批次的打卡数据\r\n        if (res.get(\"errcode\") == 0) {\r\n            var checkinData = res.get(\"checkindata\");\r\n            if (checkinData != null) {\r\n                for (var k = 0; k < checkinData.size(); k++) {\r\n                    allCheckinData.push(checkinData.get(k));\r\n                }\r\n            }\r\n        }\r\n    }\r\n    \r\n    // 组装返回结果\r\n    return $.json.objectToJsonString({\r\n        \"errcode\": 0,\r\n        \"errmsg\": \"ok\",\r\n        \"checkindata\": allCheckinData\r\n    });\r\n}\r\n\r\n// 获取Access Token\r\nfunction getAccessToken(forceRefresh) {\r\n    var corpid = \"ww221c0bad06436cb9\";\r\n    var secret = \"dUJ_BzUJIhFxubMuBsLFy_jjSaLXsRqANNwySpYgRSs\";\r\n    var url = \"https://qyapi.weixin.qq.com/cgi-bin/gettoken\";\r\n    \r\n    var params = new Packages.java.util.HashMap();\r\n    params.put(\"corpid\", corpid);\r\n    params.put(\"corpsecret\", secret);\r\n    \r\n    var headers = new Packages.java.util.HashMap();\r\n    headers.put(\"Content-Type\", \"application/json;charset=UTF-8\");\r\n    \r\n    var response = $.httpclient.sendGet(url, params, headers);\r\n    var res = $.json.stringToJsonObject(response);\r\n    \r\n    if (res.get(\"errcode\") == 0) {\r\n        return res.get(\"access_token\");\r\n    }\r\n    return null;\r\n}","createTime":1774276845000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"159ba8ac89f147cfac4f0dd68c49ac72","id":"197592939349633024","modelCode":"","modelId":"69bbf927d5024d1aa621535e","modelType":"PC_BUSINESS_DESIGN","namespace":"获取记录","path":"原始记录打卡报表列表","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1774277348353,"versions":0.0}