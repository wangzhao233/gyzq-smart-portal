{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"考勤管理","content":"(function () {\r\n    $.log.info(\"===== 考勤日报同步 v1.0 开始 =====\");\r\n    var result = getdaydate();\r\n\r\n    if (result == \"SUCCESS\") {\r\n        $.log.info(\"所有批次数据处理完成\");\r\n    } else if (result) {\r\n        try {\r\n            var res = $.json.stringToJsonObject(result);\r\n            if (res.get(\"errcode\") == 42001 || res.get(\"errcode\") == \"42001\") {\r\n                $.log.warn(\"Token 失效，尝试重新获取...\");\r\n                if (typeof gettoken === 'function') {\r\n                    gettoken();\r\n                    result = getdaydate();\r\n                }\r\n            } else if (res.get(\"errcode\") != 0 && res.get(\"errcode\") != null) {\r\n                $.log.error(\"微信接口返回错误: errcode=\" + res.get(\"errcode\") + \", errmsg=\" + res.get(\"errmsg\"));\r\n            }\r\n        } catch (e) {\r\n            $.log.error(\"解析返回结果出错: \" + e);\r\n        }\r\n    }\r\n})();\r\n\r\nfunction getdaydate() {\r\n    var appId = $.context.getCurrentApplicationId();\r\n\r\n    // 1. 计算时间范围（昨天）\r\n    var now = $.date.getCurrentDate();\r\n    var startTime = new Date(now.getTime() - 86400000);\r\n    var startStr = $.date.dateToString(startTime, \"yyyy-MM-dd\");\r\n    var startDate = $.date.stringToDate(startStr, \"yyyy-MM-dd\");\r\n    var sTime = startDate.getTime() / 1000;\r\n\r\n    var endTime = new Date(now.getTime());\r\n    var endStr = $.date.dateToString(endTime, \"yyyy-MM-dd\");\r\n    var endDate = $.date.stringToDate(endStr, \"yyyy-MM-dd\");\r\n    var eTime = (endDate.getTime() + 86400000) / 1000;\r\n\r\n    $.log.info(\"请求时间范围: \" + sTime + \" 至 \" + eTime);\r\n\r\n    // 2. 获取员工账号列表\r\n    var accountList = new Packages.java.util.ArrayList();\r\n    var userMap = new Packages.java.util.HashMap();\r\n    var userDocsList = $.form.getFormDocumentsByFieldNameAndValue(appId, \"员工信息维护\", userMap);\r\n\r\n    var totalSize = userDocsList != null ? userDocsList.size() : 0;\r\n    $.log.info(\"读取到员工文档总数: \" + totalSize);\r\n\r\n    if (totalSize > 0) {\r\n        for (var f = 0; f < totalSize; f++) {\r\n            try {\r\n                var doc = userDocsList.get(f);\r\n                var accountElem = doc.getElementByName(\"账号\");\r\n                var account = \"\";\r\n\r\n                if (accountElem != null && accountElem.getValue() != null) {\r\n                    account = accountElem.getValue().toString().trim();\r\n                }\r\n\r\n                if (account == \"\") {\r\n                    var nameElem = doc.getElementByName(\"姓名\");\r\n                    if (nameElem != null && nameElem.getValue() != null) {\r\n                        var name = nameElem.getValue().toString().trim();\r\n                        var users = $.contact.listUserByKeyword(name);\r\n                        if (users != null && users.size() > 0) {\r\n                            account = users.get(0).getAccount();\r\n                        }\r\n                    }\r\n                }\r\n\r\n                if (account != \"\" && !accountList.contains(account)) {\r\n                    accountList.add(account);\r\n                }\r\n            } catch (e) {\r\n                $.log.error(\"处理第 \" + f + \" 个员工失败: \" + e);\r\n            }\r\n        }\r\n    }\r\n\r\n    $.log.info(\"最终获取唯一账号数: \" + accountList.size());\r\n    if (accountList.size() == 0) {\r\n        $.log.warn(\"没有获取到任何账号，跳过请求\");\r\n        return \"SUCCESS\";\r\n    }\r\n\r\n    // 3. 获取 Token\r\n    var corpid = \"ww221c0bad06436cb9\";\r\n    var secret = \"dUJ_BzUJIhFxubMuBsLFy_jjSaLXsRqANNwySpYgRSs\";\r\n    var url = \"https://qyapi.weixin.qq.com/cgi-bin/gettoken\";\r\n    var params = new Packages.java.util.HashMap();\r\n    params.put(\"corpid\", corpid);\r\n    params.put(\"corpsecret\", secret);\r\n    var headers = new Packages.java.util.HashMap();\r\n    headers.put(\"Content-Type\", \"application/json;charset=UTF-8\");\r\n\r\n    var response = $.httpclient.sendGet(url, params, headers);\r\n    var res = $.json.stringToJsonObject(response);\r\n    var token = res.get(\"access_token\");\r\n\r\n    if (!token) {\r\n        $.log.error(\"获取 Token 失败: \" + response);\r\n        return response;\r\n    }\r\n\r\n    // 4. 分批请求\r\n    var batchSize = 100;\r\n    var totalBatches = Math.ceil(accountList.size() / batchSize);\r\n    var dayUrl = \"https://qyapi.weixin.qq.com/cgi-bin/checkin/getcheckin_daydata\";\r\n    var dayParams = new Packages.java.util.HashMap();\r\n    dayParams.put(\"access_token\", token);\r\n    var dayHeaders = new Packages.java.util.HashMap();\r\n    dayHeaders.put(\"Content-Type\", \"application/json;charset=UTF-8\");\r\n\r\n    $.log.info(\"开始分批请求，共 \" + totalBatches + \" 批\");\r\n\r\n    for (var i = 0; i < totalBatches; i++) {\r\n        var startIdx = i * batchSize;\r\n        var endIdx = Math.min((i + 1) * batchSize, accountList.size());\r\n\r\n        var currentBatchList = new Packages.java.util.ArrayList();\r\n        for (var k = startIdx; k < endIdx; k++) {\r\n            currentBatchList.add(accountList.get(k));\r\n        }\r\n\r\n        $.log.info(\"请求第 \" + (i + 1) + \"/\" + totalBatches + \" 批，人数: \" + currentBatchList.size());\r\n\r\n        var json = {\r\n            \"starttime\": sTime,\r\n            \"endtime\": eTime,\r\n            \"useridlist\": currentBatchList\r\n        };\r\n\r\n        var jsonStr = $.json.objectToJsonString(json);\r\n        var dayResponse = $.httpclient.sendPost(dayUrl, dayParams, dayHeaders, jsonStr);\r\n\r\n        // ★ 打印原始返回（用于调试字段结构）\r\n        // $.log.info(\"企微原始返回: \" + dayResponse);\r\n\r\n        var batchRes = $.json.stringToJsonObject(dayResponse);\r\n\r\n        if (batchRes.get(\"errcode\") == 0) {\r\n            var dates = batchRes.get(\"datas\");\r\n            if (dates != null && dates.size() > 0) {\r\n                saveDataToForm(dates, appId);\r\n                $.log.info(\"第 \" + (i + 1) + \" 批保存完成，条数: \" + dates.size());\r\n            }\r\n        } else {\r\n            $.log.error(\"第 \" + (i + 1) + \" 批请求失败: \" + batchRes.get(\"errmsg\"));\r\n        }\r\n    }\r\n\r\n    return \"SUCCESS\";\r\n}\r\n\r\n// ============================================================\r\n// 打卡时间格式化：秒数 → \"HH:mm\" 时间字符串\r\n// ============================================================\r\nfunction formatClockTime(dateVal, secOffset) {\r\n    if (!dateVal || !secOffset || secOffset <= 0) return null;\r\n    var dateMs = (typeof dateVal === 'number') ? dateVal : 0;\r\n    var totalMs = dateMs + (secOffset * 1000);\r\n    var d = new Date(totalMs);\r\n    var h = d.getHours().toString();\r\n    var m = d.getMinutes().toString();\r\n    var s = d.getSeconds().toString();\r\n    return (h.length < 2 ? '0' + h : h) + \":\" + (m.length < 2 ? '0' + m : m);\r\n}\r\n\r\n// ============================================================\r\n// 主数据写入函数\r\n// ============================================================\r\nfunction saveDataToForm(dates, appId) {\r\n    var savedCount = 0;\r\n    var errorCount = 0;\r\n\r\n    for (var j = 0; j < dates.size(); j++) {\r\n        var record = dates.get(j);\r\n        var base_info = record.get(\"base_info\");\r\n        var summary_info = record.get(\"summary_info\");\r\n        var exception_infos = record.get(\"exception_infos\");\r\n        var ot_info = record.get(\"ot_info\");\r\n        var holiday_infos = record.get(\"holiday_infos\");\r\n        var sp_items = record.get(\"sp_items\");\r\n\r\n        if (base_info == null) {\r\n            $.log.warn(\"第 \" + j + \" 条记录无 base_info，跳过\");\r\n            continue;\r\n        }\r\n\r\n        try {\r\n            var adddoc = $.form.createEmptyDocument(appId, \"考勤日报\");\r\n\r\n            // ---------- 1. 基础信息 ----------\r\n            var acctid = base_info.get(\"acctid\");\r\n            var name = base_info.get(\"name\");\r\n            var departs = base_info.get(\"departs_name\");\r\n            var dateVal = base_info.get(\"date\");\r\n\r\n            if (acctid != null) adddoc.addElement(\"账号\", acctid);\r\n            if (name != null) adddoc.addElement(\"姓名\", name);\r\n            if (departs != null) adddoc.addElement(\"部门\", departs);\r\n            if (dateVal != null) {\r\n                adddoc.addElement(\"日期\", dateVal * 1000);\r\n                var dayType = base_info.get(\"day_type\");\r\n                if (dayType != null) {\r\n                    var dayTypeInt = parseInt(dayType);\r\n                    adddoc.addElement(\"日报类型\", (dayTypeInt + 1).toString());\r\n                    // ★ 应出勤天数：工作日报=1，休息日报=0\r\n                    adddoc.addElement(\"应出勤天数\", (dayTypeInt === 0) ? 1 : 0);\r\n                    // ★ 休息天数：休息日报=1，工作日报=0\r\n                    adddoc.addElement(\"休息天数\", (dayTypeInt === 1) ? 1 : 0);\r\n                }\r\n            }\r\n\r\n            // ---------- 2. 班次规则信息 ----------\r\n            var rule_info = base_info.get(\"rule_info\");\r\n            if (rule_info != null) {\r\n                var groupName = rule_info.get(\"groupname\");\r\n                var scheduleName = rule_info.get(\"schedulename\");\r\n                if (groupName != null) adddoc.addElement(\"规则组\", groupName);\r\n                if (scheduleName != null) adddoc.addElement(\"班次名称\", scheduleName);\r\n\r\n                // ★★★ 打卡时间数组解析（核心新增）★★★\r\n                // checkintime 数组：每组 {work_sec, off_work_sec} = 一对上下班秒数\r\n                var checkintime = rule_info.get(\"checkintime\");\r\n                if (checkintime != null && checkintime.size() > 0) {\r\n                    var workSecList = [];\r\n                    var offWorkSecList = [];\r\n                    for (var ci = 0; ci < checkintime.size(); ci++) {\r\n                        var ct = checkintime.get(ci);\r\n                        if (ct != null) {\r\n                            var ws = ct.get(\"work_sec\");\r\n                            var ow = ct.get(\"off_work_sec\");\r\n                            workSecList.push(ws);\r\n                            offWorkSecList.push(ow);\r\n                        }\r\n                    }\r\n                    // 上班打卡时间（最多3对）\r\n                    for (var wi = 0; wi < 3; wi++) {\r\n                        var wSec = (wi < workSecList.length) ? workSecList[wi] : null;\r\n                        var wTime = (wSec != null && wSec > 0) ? formatClockTime(dateVal * 1000, wSec) : null;\r\n                        var fieldName = \"上班\" + (wi + 1) + \"打卡时间\";\r\n                        if (wTime != null) adddoc.addElement(fieldName, wTime);\r\n                    }\r\n                    // 下班打卡时间（最多3对）\r\n                    for (var oi = 0; oi < 3; oi++) {\r\n                        var owSec = (oi < offWorkSecList.length) ? offWorkSecList[oi] : null;\r\n                        var owTime = (owSec != null && owSec > 0) ? formatClockTime(dateVal * 1000, owSec) : null;\r\n                        var fieldName = \"下班\" + (oi + 1) + \"打卡时间\";\r\n                        if (owTime != null) adddoc.addElement(fieldName, owTime);\r\n                    }\r\n                }\r\n            }\r\n\r\n            // ---------- 3. 汇总打卡信息 ----------\r\n            if (summary_info != null) {\r\n                var checkinCount = summary_info.get(\"checkin_count\");\r\n                var regWork = summary_info.get(\"regular_work_sec\");\r\n                var stdWork = summary_info.get(\"standard_work_sec\");\r\n                var earliest = summary_info.get(\"earliest_time\");\r\n                var lastest = summary_info.get(\"lastest_time\");\r\n\r\n                if (checkinCount != null) {\r\n                    adddoc.addElement(\"打卡次数\", checkinCount);\r\n                    // ★ 出勤天数：有打卡记录=1，无打卡=0\r\n                    adddoc.addElement(\"出勤天数\", (parseInt(checkinCount) > 0) ? 1 : 0);\r\n                }\r\n                if (regWork != null) adddoc.addElement(\"实际工作时长\", regWork / 3600);\r\n                if (stdWork != null) adddoc.addElement(\"标准工作时长\", stdWork / 3600);\r\n                // 工作时长 = 实际工作时长\r\n                if (regWork != null) adddoc.addElement(\"工作时长\", regWork / 3600);\r\n\r\n                if (dateVal != null && earliest != null && earliest > 0) {\r\n                    adddoc.addElement(\"最早\", formatClockTime(dateVal * 1000, earliest));\r\n                }\r\n                if (dateVal != null && lastest != null && lastest > 0) {\r\n                    adddoc.addElement(\"最晚\", formatClockTime(dateVal * 1000, lastest));\r\n                }\r\n            }\r\n\r\n            // ---------- 4. 打卡结果（从打卡时间有无推导） ----------\r\n            // 上班1打卡结果：有上班1打卡时间则=1（正常），无则查异常\r\n            var work1Time = adddoc.getElementByName(\"上班1打卡时间\");\r\n            // 打卡结果字段需要根据表单字段定义，这里用上班1打卡时间的有无来判断\r\n            // 若表单有\"上班1打卡结果\"字段，值应为 1（正常）/ 0（异常）\r\n            // 注：打卡结果需要根据班次配置计算，此处暂用打卡时间存在性代替\r\n\r\n            // ---------- 5. 加班信息 ----------\r\n            if (ot_info != null) {\r\n                var otStatus = ot_info.get(\"ot_status\");\r\n                var otDuration = ot_info.get(\"ot_duration\");\r\n                if (otStatus != null) adddoc.addElement(\"加班状态\", otStatus.toString());\r\n                if (otDuration != null) adddoc.addElement(\"认定加班时长\", otDuration / 3600);\r\n\r\n                // ★ 加班明细拆分（工作日/休息日/节假日加班）\r\n                var workday_over_as_vacation = ot_info.get(\"workday_over_as_vacation\");\r\n                var workday_over_as_money = ot_info.get(\"workday_over_as_money\");\r\n                var restday_over_as_vacation = ot_info.get(\"restday_over_as_vacation\");\r\n                var restday_over_as_money = ot_info.get(\"restday_over_as_money\");\r\n                var holiday_over_as_vacation = ot_info.get(\"holiday_over_as_vacation\");\r\n                var holiday_over_as_money = ot_info.get(\"holiday_over_as_money\");\r\n\r\n                if (workday_over_as_vacation != null || workday_over_as_money != null) {\r\n                    var wdTotal = 0;\r\n                    if (workday_over_as_vacation != null) wdTotal += workday_over_as_vacation;\r\n                    if (workday_over_as_money != null) wdTotal += workday_over_as_money;\r\n                    if (wdTotal > 0) adddoc.addElement(\"工作日加班\", wdTotal / 3600);\r\n                }\r\n                if (restday_over_as_vacation != null || restday_over_as_money != null) {\r\n                    var rdTotal = 0;\r\n                    if (restday_over_as_vacation != null) rdTotal += restday_over_as_vacation;\r\n                    if (restday_over_as_money != null) rdTotal += restday_over_as_money;\r\n                    if (rdTotal > 0) adddoc.addElement(\"休息日加班\", rdTotal / 3600);\r\n                }\r\n                if (holiday_over_as_vacation != null || holiday_over_as_money != null) {\r\n                    var hdTotal = 0;\r\n                    if (holiday_over_as_vacation != null) hdTotal += holiday_over_as_vacation;\r\n                    if (holiday_over_as_money != null) hdTotal += holiday_over_as_money;\r\n                    if (hdTotal > 0) adddoc.addElement(\"节假日加班\", hdTotal / 3600);\r\n                }\r\n            }\r\n\r\n            // ---------- 6. 异常信息汇总 ----------\r\n            var hasException = false;\r\n            var lateCount = 0, lateDur = 0;\r\n            var earlyCount = 0, earlyDur = 0;\r\n            var absentCount = 0, absentDur = 0;\r\n            var exTypeListCN = [];\r\n\r\n            if (exception_infos != null && exception_infos.size() > 0) {\r\n                hasException = true;\r\n                for (var j1 = 0; j1 < exception_infos.size(); j1++) {\r\n                    var exItem = exception_infos.get(j1);\r\n                    var exType = exItem.get(\"exception\");\r\n                    var exCount = exItem.get(\"count\");\r\n                    var exDur = exItem.get(\"duration\");\r\n\r\n                    // 累加各类型\r\n                    if (exType == 1) { // 迟到\r\n                        lateCount += (exCount != null ? parseInt(exCount) : 0);\r\n                        lateDur += (exDur != null ? parseFloat(exDur) : 0);\r\n                        exTypeListCN.push(\"迟到\");\r\n                    } else if (exType == 2) { // 早退\r\n                        earlyCount += (exCount != null ? parseInt(exCount) : 0);\r\n                        earlyDur += (exDur != null ? parseFloat(exDur) : 0);\r\n                        exTypeListCN.push(\"早退\");\r\n                    } else if (exType == 4) { // 旷工\r\n                        absentCount += (exCount != null ? parseInt(exCount) : 0);\r\n                        absentDur += (exDur != null ? parseFloat(exDur) : 0);\r\n                        exTypeListCN.push(\"旷工\");\r\n                    }\r\n\r\n                    // 写入异常子表\r\n                    var exTypeVal = (exType != null) ? exType.toString() : \"\";\r\n                    try {\r\n                        var subExDoc = $.form.createEmptyDocument(appId, \"日报异常记录\");\r\n                        subExDoc.addElement(\"关联日报\", adddoc.getId());\r\n                        subExDoc.addElement(\"异常类型\", exTypeVal);\r\n                        subExDoc.addElement(\"异常次数\", exCount);\r\n                        subExDoc.addElement(\"异常时长\", (exDur != null ? exDur / 3600 : 0));\r\n                        $.form.saveFormDocument(subExDoc, appId);\r\n                    } catch (subErr) {\r\n                        $.log.error(\"保存异常子表失败: \" + subErr + \", 类型值:\" + exTypeVal);\r\n                    }\r\n                }\r\n\r\n                // ★ 迟到/早退次数和时长\r\n                if (lateCount > 0) {\r\n                    adddoc.addElement(\"迟到次数\", lateCount);\r\n                    adddoc.addElement(\"迟到时长\", lateDur / 3600);\r\n                }\r\n                if (earlyCount > 0) {\r\n                    adddoc.addElement(\"早退次数\", earlyCount);\r\n                    adddoc.addElement(\"早退时长\", earlyDur / 3600);\r\n                }\r\n                // 旷工天数（异常次数 / 2 ≈ 天数，精确需看班次）\r\n                if (absentCount > 0) {\r\n                    adddoc.addElement(\"旷工天数\", absentCount);\r\n                    adddoc.addElement(\"旷工迟到天数\", absentCount); // 表单字段合并\r\n                }\r\n                // 异常类型汇总\r\n                if (exTypeListCN.length > 0) {\r\n                    adddoc.addElement(\"异常类型\", exTypeListCN.join(\"; \"));\r\n                }\r\n                adddoc.addElement(\"异常次数\", lateCount + earlyCount + absentCount);\r\n                adddoc.addElement(\"异常时长\", (lateDur + earlyDur + absentDur) / 3600);\r\n            }\r\n\r\n            // ---------- 7. 假勤统计摘要 ----------\r\n            var leaveSummary = [];\r\n            var otherSummary = [];\r\n            var spNumbersStr = \"\";\r\n\r\n            if (sp_items != null && sp_items.size() > 0) {\r\n                for (var s = 0; s < sp_items.size(); s++) {\r\n                    var item = sp_items.get(s);\r\n                    var itemName = item.get(\"name\");\r\n                    var count = item.get(\"count\");\r\n                    var duration = item.get(\"duration\");\r\n                    var timeType = item.get(\"time_type\");\r\n                    var itemType = item.get(\"type\");\r\n\r\n                    if (itemName == null) continue;\r\n                    if ((count == null || count == 0) && (duration == null || duration == 0)) continue;\r\n\r\n                    var valStr = \"\";\r\n                    if (duration != null && duration > 0) {\r\n                        var num = (timeType == 0) ? (duration / 86400) : (duration / 3600);\r\n                        valStr = itemName + \":\" + num + (timeType == 0 ? \"天\" : \"小时\");\r\n                    } else if (count > 0) {\r\n                        valStr = itemName + \":\" + count + \"次\";\r\n                    }\r\n\r\n                    if (itemType == 1) {\r\n                        if (valStr != \"\") leaveSummary.push(valStr);\r\n                    } else if (itemType == 3) {\r\n                        // 出差\r\n                        if (duration != null && duration > 0) {\r\n                            adddoc.addElement(\"出差时长\", duration / 3600);\r\n                        }\r\n                    } else if (itemType == 4) {\r\n                        // 外出\r\n                        if (duration != null && duration > 0) {\r\n                            adddoc.addElement(\"外出时长\", duration / 3600);\r\n                        }\r\n                    } else {\r\n                        if (valStr != \"\") otherSummary.push(valStr);\r\n                    }\r\n                }\r\n            }\r\n\r\n            if (leaveSummary.length > 0) adddoc.addElement(\"请假明细\", leaveSummary.join(\"; \"));\r\n            if (otherSummary.length > 0) adddoc.addElement(\"其他考勤明细\", otherSummary.join(\"; \"));\r\n\r\n            // ---------- 8. 假勤审批详情（子表） ----------\r\n            if (holiday_infos != null && holiday_infos.size() > 0) {\r\n                for (var h = 0; h < holiday_infos.size(); h++) {\r\n                    var hInfo = holiday_infos.get(h);\r\n                    var spNum = hInfo.get(\"sp_number\");\r\n\r\n                    if (spNum != null) {\r\n                        spNumbersStr += (spNumbersStr == \"\" ? \"\" : \";\") + spNum;\r\n\r\n                        var subDoc = $.form.createEmptyDocument(appId, \"日报假勤详情\");\r\n                        subDoc.addElement(\"关联日报\", adddoc.getId());\r\n                        subDoc.addElement(\"审批单号\", spNum);\r\n\r\n                        var titleObj = hInfo.get(\"sp_title\");\r\n                        var descObj = hInfo.get(\"sp_description\");\r\n                        if (titleObj != null) {\r\n                            var tData = titleObj.get(\"data\");\r\n                            if (tData != null && tData.size() > 0) subDoc.addElement(\"假勤类型\", tData.get(0).get(\"text\"));\r\n                        }\r\n                        if (descObj != null) {\r\n                            var dData = descObj.get(\"data\");\r\n                            if (dData != null && dData.size() > 0) subDoc.addElement(\"假勤描述\", dData.get(0).get(\"text\"));\r\n                        }\r\n                        $.form.saveFormDocument(subDoc, appId);\r\n                    }\r\n                }\r\n                adddoc.addElement(\"关联审批单号\", spNumbersStr);\r\n            }\r\n\r\n            // ---------- 9. 主表状态 ----------\r\n            if (hasException) {\r\n                adddoc.addElement(\"状态\", \"2\");\r\n                adddoc.addElement(\"申诉状态\", \"1\");\r\n            } else {\r\n                adddoc.addElement(\"状态\", \"1\");\r\n                adddoc.addElement(\"申诉状态\", \"2\");\r\n            }\r\n\r\n            // 保存主文档\r\n            $.form.saveFormDocument(adddoc, appId);\r\n            savedCount++;\r\n\r\n        } catch (e) {\r\n            errorCount++;\r\n            $.log.error(\"保存第 \" + j + \" 条日报失败: \" + e);\r\n        }\r\n    }\r\n\r\n    $.log.info(\"日报主表：成功=\" + savedCount + \"，失败=\" + errorCount);\r\n}\r\n","createTime":1776335457126,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"e85eca85b2394dd2809bd57e35f43f13","id":"200179252691177472","modelCode":"","modelId":"c385d05c91f1425b9e032a40ff59c9ad","modelType":"PC_BUSINESS_DESIGN","namespace":"导入3.0","path":"考勤日报","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1776335457126,"versions":0.0}