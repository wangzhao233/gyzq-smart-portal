{"applicationId":"fd6a396e6d214afc8e72ed508724e213","applicationName":"考勤管理","content":"(function () {\r\n    $.log.info(\"开始执行考勤日报同步任务...\");\r\n    var result = getdaydate();\r\n    \r\n    if (result == \"SUCCESS\") {\r\n        $.log.info(\"所有批次数据处理完成\");\r\n    } else if (result) {\r\n        try {\r\n            var res = $.json.stringToJsonObject(result);\r\n            if (res.get(\"errcode\") == 42001 || res.get(\"errcode\") == \"42001\") {\r\n                $.log.warn(\"Token 失效，尝试重新获取...\");\r\n                if (typeof gettoken === 'function') {\r\n                    gettoken();\r\n                    result = getdaydate();\r\n                }\r\n            } else if (res.get(\"errcode\") != 0 && res.get(\"errcode\") != null) {\r\n                $.log.error(\"微信接口返回错误: errcode=\" + res.get(\"errcode\") + \", errmsg=\" + res.get(\"errmsg\"));\r\n            }\r\n        } catch (e) {\r\n            $.log.error(\"解析返回结果出错: \" + e);\r\n        }\r\n    }\r\n})();\r\n\r\nfunction getdaydate() {\r\n    var appId = $.context.getCurrentApplicationId();\r\n    \r\n    // 1. 计算时间范围\r\n    var now = $.date.getCurrentDate();\r\n    var startTime = new Date(now.getTime() - 86400000); \r\n    var startStr = $.date.dateToString(startTime, \"yyyy-MM-dd\");\r\n    var startDate = $.date.stringToDate(startStr, \"yyyy-MM-dd\");\r\n    var sTime = startDate.getTime() / 1000;\r\n\r\n    var endTime = new Date(now.getTime()); \r\n    var endStr = $.date.dateToString(endTime, \"yyyy-MM-dd\");\r\n    var endDate = $.date.stringToDate(endStr, \"yyyy-MM-dd\");\r\n    var eTime = (endDate.getTime() + 86400000) / 1000;\r\n\r\n    $.log.info(\"请求时间范围: \" + sTime + \" 至 \" + eTime);\r\n\r\n    // 2. 获取员工账号列表\r\n    var accountList = new Packages.java.util.ArrayList();\r\n    var userMap = new Packages.java.util.HashMap();\r\n    var userDocsList = $.form.getFormDocumentsByFieldNameAndValue(appId, \"员工信息维护\", userMap);\r\n    \r\n    var totalSize = userDocsList != null ? userDocsList.size() : 0;\r\n    $.log.info(\"读取到员工文档总数: \" + totalSize);\r\n\r\n    if (totalSize > 0) {\r\n        for (var f = 0; f < totalSize; f++) {\r\n            try {\r\n                var doc = userDocsList.get(f);\r\n                var accountElem = doc.getElementByName(\"账号\");\r\n                var account = \"\";\r\n                \r\n                if (accountElem != null && accountElem.getValue() != null) {\r\n                    account = accountElem.getValue().toString().trim();\r\n                } \r\n                \r\n                if (account == \"\") {\r\n                    var nameElem = doc.getElementByName(\"姓名\");\r\n                    if (nameElem != null && nameElem.getValue() != null) {\r\n                        var name = nameElem.getValue().toString().trim();\r\n                        var users = $.contact.listUserByKeyword(name);\r\n                        if (users != null && users.size() > 0) {\r\n                            account = users.get(0).getAccount();\r\n                        }\r\n                    }\r\n                }\r\n\r\n                if (account != \"\" && !accountList.contains(account)) {\r\n                    accountList.add(account);\r\n                }\r\n            } catch (e) {\r\n                $.log.error(\"处理第 \" + f + \" 个员工失败: \" + e);\r\n            }\r\n        }\r\n    }\r\n\r\n    $.log.info(\"最终获取唯一账号数: \" + accountList.size());\r\n    if (accountList.size() == 0) {\r\n        $.log.warn(\"没有获取到任何账号，跳过请求\");\r\n        return \"SUCCESS\";\r\n    }\r\n\r\n    // 3. 获取 Token\r\n    var corpid = \"ww221c0bad06436cb9\"; \r\n    var secret = \"dUJ_BzUJIhFxubMuBsLFy_jjSaLXsRqANNwySpYgRSs\"; \r\n    var url = \"https://qyapi.weixin.qq.com/cgi-bin/gettoken\";\r\n    var params = new Packages.java.util.HashMap();\r\n    params.put(\"corpid\", corpid);\r\n    params.put(\"corpsecret\", secret);\r\n    var headers = new Packages.java.util.HashMap();\r\n    headers.put(\"Content-Type\", \"application/json;charset=UTF-8\");\r\n    \r\n    var response = $.httpclient.sendGet(url, params, headers);\r\n    var res = $.json.stringToJsonObject(response);\r\n    var token = res.get(\"access_token\");\r\n\r\n    if (!token) {\r\n        $.log.error(\"获取 Token 失败: \" + response);\r\n        return response;\r\n    }\r\n\r\n    // 4. 分批请求\r\n    var batchSize = 100; \r\n    var totalBatches = Math.ceil(accountList.size() / batchSize);\r\n    var dayUrl = \"https://qyapi.weixin.qq.com/cgi-bin/checkin/getcheckin_daydata\";\r\n    var dayParams = new Packages.java.util.HashMap();\r\n    dayParams.put(\"access_token\", token);\r\n    var dayHeaders = new Packages.java.util.HashMap();\r\n    dayHeaders.put(\"Content-Type\", \"application/json;charset=UTF-8\");\r\n\r\n    $.log.info(\"开始分批请求，共 \" + totalBatches + \" 批\");\r\n\r\n    for (var i = 0; i < totalBatches; i++) {\r\n        var startIdx = i * batchSize;\r\n        var endIdx = Math.min((i + 1) * batchSize, accountList.size());\r\n        \r\n        var currentBatchList = new Packages.java.util.ArrayList();\r\n        for (var k = startIdx; k < endIdx; k++) {\r\n            currentBatchList.add(accountList.get(k));\r\n        }\r\n\r\n        $.log.info(\"请求第 \" + (i + 1) + \"/\" + totalBatches + \" 批，人数: \" + currentBatchList.size());\r\n\r\n        var json = {\r\n            \"starttime\": sTime,\r\n            \"endtime\": eTime,\r\n            \"useridlist\": currentBatchList\r\n        };\r\n\r\n        var jsonStr = $.json.objectToJsonString(json);\r\n        var dayResponse = $.httpclient.sendPost(dayUrl, dayParams, dayHeaders, jsonStr);\r\n        var batchRes = $.json.stringToJsonObject(dayResponse);\r\n\r\n        if (batchRes.get(\"errcode\") == 0) {\r\n            var dates = batchRes.get(\"datas\");\r\n            if (dates != null && dates.size() > 0) {\r\n                saveDataToForm(dates, appId);\r\n                $.log.info(\"第 \" + (i + 1) + \" 批保存完成，条数: \" + dates.size());\r\n            }\r\n        } else {\r\n            $.log.error(\"第 \" + (i + 1) + \" 批请求失败: \" + batchRes.get(\"errmsg\"));\r\n        }\r\n    }\r\n\r\n    return \"SUCCESS\";\r\n}\r\n\r\nfunction saveDataToForm(dates, appId) {\r\n    for (var j = 0; j < dates.size(); j++) {\r\n        var record = dates.get(j);\r\n        var base_info = record.get(\"base_info\");\r\n        var summary_info = record.get(\"summary_info\");\r\n        var exception_infos = record.get(\"exception_infos\");\r\n        var ot_info = record.get(\"ot_info\");\r\n        var holiday_infos = record.get(\"holiday_infos\");\r\n        var sp_items = record.get(\"sp_items\");\r\n\r\n        if (base_info == null) continue;\r\n\r\n        var adddoc = $.form.createEmptyDocument(appId, \"考勤日报\");\r\n        \r\n        // --- 1. 基础信息 ---\r\n        var acctid = base_info.get(\"acctid\");\r\n        var name = base_info.get(\"name\");\r\n        var departs = base_info.get(\"departs_name\");\r\n        var dateVal = base_info.get(\"date\"); \r\n        \r\n        if (acctid != null) adddoc.addElement(\"账号\", acctid);\r\n        if (name != null) adddoc.addElement(\"姓名\", name);\r\n        if (departs != null) adddoc.addElement(\"部门\", departs);\r\n        if (dateVal != null) {\r\n            adddoc.addElement(\"日期\", dateVal * 1000); \r\n            var dayType = base_info.get(\"day_type\");\r\n            if (dayType != null) adddoc.addElement(\"日报类型\", (parseInt(dayType) + 1).toString());\r\n        }\r\n\r\n        // --- 2. 班次规则信息 ---\r\n        var rule_info = base_info.get(\"rule_info\");\r\n        if (rule_info != null) {\r\n            var groupName = rule_info.get(\"groupname\");\r\n            var scheduleName = rule_info.get(\"schedulename\");\r\n            if (groupName != null) adddoc.addElement(\"规则组\", groupName);\r\n            if (scheduleName != null) adddoc.addElement(\"班次名称\", scheduleName);\r\n        }\r\n\r\n        // --- 3. 汇总打卡信息 ---\r\n        if (summary_info != null) {\r\n            var checkinCount = summary_info.get(\"checkin_count\");\r\n            var regWork = summary_info.get(\"regular_work_sec\");\r\n            var stdWork = summary_info.get(\"standard_work_sec\");\r\n            var earliest = summary_info.get(\"earliest_time\");\r\n            var lastest = summary_info.get(\"lastest_time\");\r\n\r\n            if (checkinCount != null) adddoc.addElement(\"打卡次数\", checkinCount);\r\n            if (regWork != null) adddoc.addElement(\"实际工作时长\", regWork / 3600);\r\n            if (stdWork != null) adddoc.addElement(\"标准工作时长\", stdWork / 3600);\r\n\r\n            if (dateVal != null && earliest != null && earliest > 0) {\r\n                var earliestDate = $.date.timestampToDate((dateVal * 1000) + (earliest * 1000));\r\n                adddoc.addElement(\"最早\", $.date.dateToString(earliestDate, \"HH:mm:ss\"));\r\n            }\r\n            if (dateVal != null && lastest != null && lastest > 0) {\r\n                var lastestDate = $.date.timestampToDate((dateVal * 1000) + (lastest * 1000));\r\n                adddoc.addElement(\"最晚\", $.date.dateToString(lastestDate, \"HH:mm:ss\"));\r\n            }\r\n        }\r\n\r\n        // --- 4. 加班信息 ---\r\n        if (ot_info != null) {\r\n            var otStatus = ot_info.get(\"ot_status\");\r\n            var otDuration = ot_info.get(\"ot_duration\");\r\n            \r\n            if (otStatus != null) adddoc.addElement(\"加班状态\", otStatus.toString());\r\n            if (otDuration != null) adddoc.addElement(\"认定加班时长\", otDuration / 3600);\r\n        }\r\n\r\n        // --- 5. 假勤统计摘要 ---\r\n        var leaveSummary = [];\r\n        var otherSummary = [];\r\n        var spNumbersStr = \"\";\r\n\r\n        if (sp_items != null && sp_items.size() > 0) {\r\n            for (var s = 0; s < sp_items.size(); s++) {\r\n                var item = sp_items.get(s);\r\n                var itemName = item.get(\"name\");\r\n                var count = item.get(\"count\");\r\n                var duration = item.get(\"duration\");\r\n                var timeType = item.get(\"time_type\");\r\n                var itemType = item.get(\"type\");\r\n\r\n                if (itemName == null) continue;\r\n                if (count == 0 && (duration == null || duration == 0)) continue;\r\n\r\n                var valStr = \"\";\r\n                if (duration != null && duration > 0) {\r\n                    var num = (timeType == 0) ? (duration / 86400) : (duration / 3600);\r\n                    valStr = itemName + \":\" + num + (timeType == 0 ? \"天\" : \"小时\");\r\n                } else if (count > 0) {\r\n                    valStr = itemName + \":\" + count + \"次\";\r\n                }\r\n\r\n                if (itemType == 1) { \r\n                    if (valStr != \"\") leaveSummary.push(valStr);\r\n                } else { \r\n                    if (valStr != \"\") otherSummary.push(valStr);\r\n                }\r\n            }\r\n        }\r\n        \r\n        if (leaveSummary.length > 0) adddoc.addElement(\"请假明细\", leaveSummary.join(\"; \"));\r\n        if (otherSummary.length > 0) adddoc.addElement(\"其他考勤明细\", otherSummary.join(\"; \"));\r\n\r\n        // --- 6. 假勤审批详情 (子表) ---\r\n        if (holiday_infos != null && holiday_infos.size() > 0) {\r\n            for (var h = 0; h < holiday_infos.size(); h++) {\r\n                var hInfo = holiday_infos.get(h);\r\n                var spNum = hInfo.get(\"sp_number\");\r\n                \r\n                if (spNum != null) {\r\n                    spNumbersStr += (spNumbersStr == \"\" ? \"\" : \";\") + spNum;\r\n                    \r\n                    var subDoc = $.form.createEmptyDocument(appId, \"日报假勤详情\");\r\n                    subDoc.addElement(\"关联日报\", adddoc.getId());\r\n                    subDoc.addElement(\"审批单号\", spNum);\r\n                    \r\n                    var titleObj = hInfo.get(\"sp_title\");\r\n                    var descObj = hInfo.get(\"sp_description\");\r\n                    if (titleObj != null) {\r\n                        var tData = titleObj.get(\"data\");\r\n                        if (tData != null && tData.size() > 0) subDoc.addElement(\"假勤类型\", tData.get(0).get(\"text\"));\r\n                    }\r\n                    if (descObj != null) {\r\n                        var dData = descObj.get(\"data\");\r\n                        if (dData != null && dData.size() > 0) subDoc.addElement(\"假勤描述\", dData.get(0).get(\"text\"));\r\n                    }\r\n                    $.form.saveFormDocument(subDoc, appId);\r\n                }\r\n            }\r\n            adddoc.addElement(\"关联审批单号\", spNumbersStr);\r\n        }\r\n\r\n        // --- 7. 异常信息处理 (核心修改：子表存数字) ---\r\n        var hasException = false;\r\n        var exTypeListCN = []; // 用于主表中文汇总\r\n        var totalExCount = 0;\r\n        var totalExDuration = 0;\r\n\r\n        if (exception_infos != null && exception_infos.size() > 0) {\r\n            hasException = true;\r\n            for (var j1 = 0; j1 < exception_infos.size(); j1++) {\r\n                var exItem = exception_infos.get(j1);\r\n                var exType = exItem.get(\"exception\"); // 获取原始数字 1, 2, 3...\r\n                var exCount = exItem.get(\"count\");\r\n                var exDur = exItem.get(\"duration\");\r\n\r\n                // 用于主表显示的中文映射\r\n                var exTypeStrCN = \"未知\";\r\n                if (exType == 1) exTypeStrCN = \"迟到\";\r\n                else if (exType == 2) exTypeStrCN = \"早退\";\r\n                else if (exType == 3) exTypeStrCN = \"缺卡\";\r\n                else if (exType == 4) exTypeStrCN = \"旷工\";\r\n                else if (exType == 5) exTypeStrCN = \"地点异常\";\r\n                else if (exType == 6) exTypeStrCN = \"设备异常\";\r\n\r\n                // 【主表】累加统计 (中文汇总)\r\n                exTypeListCN.push(exTypeStrCN);\r\n                if (exCount != null) totalExCount += parseInt(exCount);\r\n                if (exDur != null) totalExDuration += parseFloat(exDur);\r\n\r\n                // 【子表】保存单条记录 (关键修改：直接存数字字符串，适配单选框)\r\n                // 确保 exType 不为 null 且转为字符串\r\n                var exTypeVal = (exType != null) ? exType.toString() : \"\";\r\n                \r\n                try {\r\n                    var subExDoc = $.form.createEmptyDocument(appId, \"日报异常记录\");\r\n                    subExDoc.addElement(\"关联日报\", adddoc.getId());\r\n                    // 这里直接存入 \"1\", \"2\" 等，匹配单选框的选项值\r\n                    subExDoc.addElement(\"异常类型\", exTypeVal); \r\n                    subExDoc.addElement(\"异常次数\", exCount);\r\n                    subExDoc.addElement(\"异常时长\", (exDur != null ? exDur / 3600 : 0));\r\n                    $.form.saveFormDocument(subExDoc, appId);\r\n                } catch (subErr) {\r\n                    $.log.error(\"保存异常子表失败: \" + subErr + \", 类型值:\" + exTypeVal);\r\n                }\r\n            }\r\n            \r\n            // 【主表】写入汇总信息 (中文描述，方便查看)\r\n            // 如果您的主表\"异常类型\"也是单选框，请取消下面这行的注释，并改为存第一个异常的数字\r\n            // adddoc.addElement(\"异常类型\", exTypeListCN.length > 0 ? exTypeListCN[0] : \"\"); \r\n            if (exTypeListCN.length > 0) {\r\n                adddoc.addElement(\"异常类型\", exTypeListCN.join(\"; \"));\r\n            }\r\n            adddoc.addElement(\"异常次数\", totalExCount);\r\n            adddoc.addElement(\"异常时长\", totalExDuration / 3600);\r\n        }\r\n\r\n        // 设置主表状态\r\n        if (hasException) {\r\n            adddoc.addElement(\"状态\", \"2\"); \r\n            adddoc.addElement(\"申诉状态\", \"1\"); \r\n        } else {\r\n            adddoc.addElement(\"状态\", \"1\"); \r\n            adddoc.addElement(\"申诉状态\", \"2\"); \r\n        }\r\n\r\n        // 保存主文档\r\n        $.form.saveFormDocument(adddoc, appId);\r\n    }\r\n}","createTime":1773887528000,"createUserId":"1889706623013949441","customJsId":"","definitionId":"","hiddenCode":"f3914ece85b648ba95e50640c8e6fb87","id":"197548381211420672","modelCode":"","modelId":"c385d05c91f1425b9e032a40ff59c9ad","modelType":"PC_BUSINESS_DESIGN","namespace":"日报移动异常到主表","path":"考勤日报","status":"NORMAL","tenantId":"9134167922923ba09ad18872b2b1246e","updateTime":1773888191245,"versions":0.0}